#!/usr/bin/env bash
# Smoke test of a File Drawer server, staging by default, following the submit skill as an
# agent would: submit, the hour's hold, a fix with PUT, publish, search, a new
# version, and a batch with slugs and runs. Each entry's title says it is a smoke
# test, and staging keeps them. CI runs it after each deploy to staging.
set -uo pipefail

usage() {
  cat <<'EOF'
usage: ops/smoke-staging [--wait SECONDS] [URL]
       ops/smoke-staging screen [--wait SECONDS] [URL]
       ops/smoke-staging eval [--field-test N | --families | --resume RUNFILE]
                              [--wait SECONDS] [URL]

Runs File Drawer's smoke test against URL (default https://staging.filedrawer.dev),
as the submit skill tells an agent to: submit, the hour's hold, a fix with PUT, publish,
search, a new version, and a batch with slugs and runs. Prints PASS or FAIL for each
check, then a tally, and exits 1 when any check fails.

  --wait SECONDS  first wait up to SECONDS for URL/skill.md to answer 200, as just
                  after a deploy (default: try once)
  -h, --help      print this

CI runs it after each deploy as the smoke-test account, which ops/provision-vps smoke
sets up and names to staging as FILEDRAWER_SMOKE_ACCOUNT: its entries aren't
screened, so the smoke test calls no model. crates/server/tests/smoke.rs runs it
against a local server, so a reply it relies on can't change unnoticed.

It reads two settings from the environment and prints neither:
  FILEDRAWER_STAGING_KEY      the staging key, sent as X-Staging-Key (STAGING_KEY in
                              ops/.vps.env)
  FILEDRAWER_STAGING_API_KEY  an API token for the account that submits
Exit status: 0 every check passed, 1 a check failed, 2 a usage or setting error,
3 (screen only) the day's screening cap is spent, so nothing more was checked.

screen checks that the server screens with the real model, which the plain smoke
test can't: staging doesn't screen CI's smoke account. CI runs it after each deploy
to staging (the screen-staging job), as CI's own screen account, which ops/provision-vps
smoke makes on the server and names to staging as FILEDRAWER_CI_SCREEN_ACCOUNT, with no
daily allowance, and whose token it stores as the staging secret CI_SCREEN_TOKEN.
Without the secret, or on a day whose screening cap is spent, the job passes with a
warning. By hand it runs as the screen-test account a-dmkmsy91w3 (robocarver's
mailbox), which eval uses too; CI doesn't, since eval's review cases put that account
under the review guard. Staging doesn't hold the screen-test account to an account's
share of the screening cap (FILEDRAWER_SCREEN_TEST_ACCOUNT, which ops/provision-vps
smoke sets from ops/.screen-test.env). Each run spends a few Haiku calls. It submits
a bland on-topic entry and expects it public with no "not screened" note, and an
off-topic one (sourdough) and expects it rejected with its reasons. It never submits anything like a hazard: an
entry in review would put the account under the review guard. When an entry is still
being screened after the wait, it sends a bland series with POST /series, which the
server screens at once, to learn why: a 429 means the day's cap is spent, and it
exits 3, nothing more checked; anything else, such as a 503 when the model call
fails, is a failure. Its settings, neither printed:
  the token   FILEDRAWER_STAGING_SCREEN_API_KEY, else SCREEN_TEST_TOKEN in
              ops/.screen-test.env
  the key     FILEDRAWER_STAGING_KEY, else STAGING_KEY in ops/.vps.env
(FILEDRAWER_OPS_DIR moves where it looks for those files and where eval keeps its
run files, and FILEDRAWER_FIELD_TEST_DIR where eval looks for field-test entries.
FILEDRAWER_SCREEN_WAIT_SECONDS is how long it waits for a verdict, default 120: 4
times that for an entry citing attached code, which the screen reads in parts, and
once more for each 10 entries of a batch, whose entries are decided together. Raise
it for a long eval; tests lower it. FILEDRAWER_SCREEN_POLL_SECONDS is how often it
asks for a verdict meanwhile, default 5; tests ask every 0.2.
FILEDRAWER_BATCH_MAX_BYTES caps a batch's body, default 900000, for tests.
FILEDRAWER_SKILL_TAGS_URL is where the skills' git tags are read, default
https://raw.githubusercontent.com/filedrawer-dev/filedrawer; tests point it at a
local folder with file://.)

eval runs a labelled test set through the screen, as the screen-test account, to
see whether it is too strict or too lax. By hand only. The cases are the entries
under ops/screen-eval/<expected>/, <expected> being public, rejected or review,
plus --field-test N (default 10; 0 for none) honest entries picked at random from
each repo's latest round in field-test/ (its *.md files with front matter, not its
series), expected public (their contents are never printed). An entry or batch the
server refuses is a FAIL, reported again by a resumed run, and its reasons go to a
file beside the run file, never to the output. A field-test entry
with a list of attached files beside it, <name>.attachments, is sent citing an
attachment set of those files, which bin/field-test-files gathers into
field-test/files/ first; one whose files aren't all there is passed over, and
entries with the same list share one upload. It prints PASS or FAIL per case and a
tally per expectation, and exits 1 when any case misses. Then it counts what the
server's own decoding finds hidden in the sets' files, run here with no model call
(filedrawer unpack, built with cargo unless FILEDRAWER_BIN names the binary), and
how the field-test entries citing a set that hides text fared. It stops at the
first case left undecided, and says why as screen does, or at the first field-test
entry or set the server can't take now (no answer, a 429 or a 5xx); one it refuses
is a FAIL, as above. Each run writes its cases, and the ID of each entry and set it sends,
to a run file under ops/.eval-runs/ (paths and IDs, no entry text), and prints its
path; --resume goes on from there, polling what the run sent rather than sending it
again. Once a run is over, the owner rejects the review cases on /admin, which
guards the screen-test account; clear the guard there afterwards. Same settings as
screen.
  --field-test N      how many field-test entries to add
  --families          instead of a sample, send each repo's latest round in
                      field-test/ as batches (bin/field-test-batches builds them),
                      making the series its entries cite first, each a case; an
                      entry that passed while its series waits hidden, as eval's
                      series did before hidden series were paused, counts as public
  --resume RUNFILE    go on with the run RUNFILE records, its cases and tag
EOF
}

base=https://staging.filedrawer.dev
wait_seconds=0
screen_wait="${FILEDRAWER_SCREEN_WAIT_SECONDS:-120}"
[[ "$screen_wait" =~ ^[0-9]+$ ]] || { echo "smoke-staging: FILEDRAWER_SCREEN_WAIT_SECONDS takes a number of seconds" >&2; exit 2; }
poll_seconds="${FILEDRAWER_SCREEN_POLL_SECONDS:-5}"
# Above 0: polling without a pause would ask staging as fast as it answers, into its
# per-IP rate limit.
if ! [[ "$poll_seconds" =~ ^[0-9]+(\.[0-9]+)?$ ]] || ! awk -v p="$poll_seconds" 'BEGIN { exit !(p > 0) }'; then
  echo "smoke-staging: FILEDRAWER_SCREEN_POLL_SECONDS takes a number of seconds above 0, such as 5 or 0.2" >&2
  exit 2
fi
mode=smoke
field_tests=10
field_tests_given=0
families=0
resume_file=""
while (( $# )); do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    screen | eval) mode=$1; shift ;;
    --field-test)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo "smoke-staging: --field-test takes a number" >&2; exit 2; }
      field_tests=$2; field_tests_given=1; shift 2 ;;
    --families) families=1; shift ;;
    --resume)
      [[ -n "${2:-}" ]] || { echo "smoke-staging: --resume takes a run file" >&2; exit 2; }
      resume_file=$2; shift 2 ;;
    --wait)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo "smoke-staging: --wait takes a number of seconds" >&2; exit 2; }
      wait_seconds=$2; shift 2 ;;
    -*) echo "smoke-staging: unknown option $1 (-h lists them)" >&2; exit 2 ;;
    *) base=${1%/}; shift ;;
  esac
done
if [[ -n $resume_file ]]; then
  [[ $mode == eval ]] || { echo "smoke-staging: --resume goes with eval" >&2; exit 2; }
  for given in field-test:$field_tests_given families:$families; do
    if [[ ${given#*:} == 1 ]]; then
      echo "smoke-staging: --resume takes its cases from the run file, so --${given%:*} can't go with it" >&2
      exit 2
    fi
  done
fi
if (( families )); then
  [[ $mode == eval ]] || { echo "smoke-staging: --families goes with eval" >&2; exit 2; }
  if (( field_tests_given )); then
    echo "smoke-staging: --families sends whole families instead of a sample, so --field-test can't go with it" >&2
    exit 2
  fi
  field_tests=0
fi
# setting_from FILE NAME: NAME's value in FILE, written as NAME='value', if any.
setting_from() {
  [[ -r "$1" ]] && sed -n "s/^$2='\(.*\)'\$/\1/p" "$1" | head -1
}

if [[ $mode == screen || $mode == eval ]]; then
  ops_dir="${FILEDRAWER_OPS_DIR:-$(dirname "$0")}"
  FILEDRAWER_STAGING_KEY="${FILEDRAWER_STAGING_KEY:-$(setting_from "$ops_dir/.vps.env" STAGING_KEY)}"
  if [[ -z "$FILEDRAWER_STAGING_KEY" ]]; then
    echo "smoke-staging: no staging key: set FILEDRAWER_STAGING_KEY, or STAGING_KEY in $ops_dir/.vps.env" >&2
    exit 2
  fi
  FILEDRAWER_STAGING_API_KEY="${FILEDRAWER_STAGING_SCREEN_API_KEY:-$(setting_from "$ops_dir/.screen-test.env" SCREEN_TEST_TOKEN)}"
  if [[ -z "$FILEDRAWER_STAGING_API_KEY" ]]; then
    echo "smoke-staging: no screen-test token: set FILEDRAWER_STAGING_SCREEN_API_KEY, or SCREEN_TEST_TOKEN in $ops_dir/.screen-test.env" >&2
    exit 2
  fi
fi
for name in FILEDRAWER_STAGING_KEY FILEDRAWER_STAGING_API_KEY; do
  if [[ -z "${!name:-}" ]]; then
    echo "smoke-staging: $name is not set; -h says what it holds" >&2
    exit 2
  fi
done

# Every entry starts from a made-up, bland fixture that passes cleanly and holds
# nothing a hazard screen could flag; crates/server/tests/smoke.rs fails if a change
# to it breaks this script.
fixture="$(dirname "$0")/smoke-fixture.md"
tag="smoke$(date -u +%Y%m%d%H%M%S)"
dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
pass=0
fail=0

# check NAME CONDITION: CONDITION is a [[ ]] test written in this file.
check() {
  if eval "$2"; then echo "PASS $1"; pass=$((pass + 1)); else echo "FAIL $1"; fail=$((fail + 1)); fi
}

# The secrets go to curl in a config read from a pipe, never on its command line.
headers() {
  printf 'header = "X-Staging-Key: %s"\n' "$FILEDRAWER_STAGING_KEY"
  [[ "${1:-}" == token ]] && printf 'header = "Authorization: Bearer %s"\n' "$FILEDRAWER_STAGING_API_KEY"
}

# req METHOD PATH [BODY-FILE] [CONTENT-TYPE]: a request with the token; sets CODE and BODY.
req() {
  local args=(-s -w '\n%{http_code}' -X "$1") out
  [[ -n "${3:-}" ]] && args+=(-H "Content-Type: ${4:-text/markdown}" --data-binary "@$3")
  out=$(curl "${args[@]}" -K <(headers token) "$base$2")
  CODE=${out##*$'\n'}
  BODY=${out%$'\n'*}
}

# anon PATH: a GET without the token; sets CODE.
anon() {
  CODE=$(curl -s -o /dev/null -w '%{http_code}' -K <(headers) "$base$1")
}

# field NAME: the first `NAME: value` line's value in BODY.
field() { printf '%s\n' "$BODY" | sed -n "s/^$1: //p" | head -1; }

# make_entry TITLE [LINE]: the fixture with a smoke-test title and tags, and LINE, if
# given, added to its front matter. The fixture links nothing, so staging fetches
# nothing for it.
make_entry() {
  local extra=""
  [[ -n "${2:-}" ]] && extra="$2\n"
  sed "s/^title: .*/title: SMOKE TEST $tag $1, not a real result/; s/^tags: .*/tags: [smoke-test, $tag]/; s/^written_by:/${extra}written_by:/" "$fixture"
}

if (( wait_seconds > 0 )); then
  deadline=$((SECONDS + wait_seconds))
  until anon /skill.md; [[ $CODE == 200 ]]; do
    if (( SECONDS >= deadline )); then
      echo "FAIL $base/skill.md didn't answer 200 within ${wait_seconds}s (last: $CODE)"
      exit 1
    fi
    sleep 2
  done
fi

# send FILE [quiet]: submits FILE; sets ID. A refused submission is a FAIL, or with
# `quiet` just returns 1.
send() {
  req POST /entries "$1"
  ID=$(field id)
  if [[ $CODE != 201 || -z "$ID" ]]; then
    [[ "${2:-}" == quiet ]] && return 1
    echo "FAIL submit $1: $CODE"; fail=$((fail + 1)); return 1
  fi
}

# publish_then_await [SECONDS]: ends entry ID's hold, then waits for its verdict as
# await does. A failed publish is a FAIL, and returns 1.
publish_then_await() {
  req POST "/e/$ID/publish"
  [[ $CODE == 200 ]] || { echo "FAIL publish $ID: $CODE"; fail=$((fail + 1)); return 1; }
  await "$@"
}

# await [SECONDS]: waits up to SECONDS (default the screen wait, 2 minutes) while
# entry ID is still being screened (an outage, the day's cap, or a slow screen); sets
# CODE and BODY from GET /e/<id>.
await() {
  local deadline=$((SECONDS + ${1:-$screen_wait}))
  req GET "/e/$ID"
  while [[ $(field status) == screening ]] && (( SECONDS < deadline )); do
    sleep "$poll_seconds"
    req GET "/e/$ID"
  done
}

# screened FILE [quiet]: submits FILE and publishes it, then waits for its verdict;
# sets ID, CODE and BODY. Returns 1 when either fails.
screened() {
  send "$@" && publish_then_await
}

# screen_entry FILE: FILE with this run's tags. The title stays as written: a test
# marker there could read as spam to the screen.
screen_entry() {
  sed "s/^tags: .*/tags: [screen-test, $tag]/" "$1"
}

# explain STATUS EXPECTED: why an entry screened to STATUS when EXPECTED was wanted.
explain() {
  [[ $1 == "$2" ]] && return
  case "$1" in
    review) echo "  it went to review: the screen saw a likely hazard, or the account is under the review guard; see $base/admin" ;;
    public) echo "  published unscreened: is staging still on FILEDRAWER_SCREENER=pass-all? (issue #7)" ;;
  esac
}

# explain_undecided: says why a case was left undecided, from a bland series sent
# with POST /series, which the server screens at once: a 429 saying the screening
# budget is spent means the day's cap is, which sets DAY_SPENT to 1 (else 0); a 429
# for the account's allowance doesn't. 503 means the model call fails. Of the reply
# it prints only the first reason: a 201's body holds the new series' join key.
explain_undecided() {
  DAY_SPENT=0
  printf -- '---\ntitle: Screen check %s, refusal-rate setup\n---\n%s\n' "$tag" \
    "Shared setup for refusal-rate evaluations of open-weight chat models: 500 prompts from a fixed benchmark at temperature 0, refusals counted by a keyword classifier checked by hand on 50 samples." \
    > "$dir/series.md"
  req POST /series "$dir/series.md"
  local reason
  # A refusal's first `- ` line, or a screen's rejection's `error: ` line: the
  # model's reasons below the delimiter aren't printed.
  reason=$(printf '%s\n' "$BODY" | sed -n 's/^- //p; s/^error: //p' | head -1)
  case "$CODE:$reason" in
    "429:the day's screening budget is spent"*)
      echo "  the day's screening cap is spent: rerun after 00:00 UTC"; DAY_SPENT=1 ;;
    503:*) echo "  screening fails; the server's log says why" ;;
    201:*)
      if (( ${CITED:-0} )); then
        echo "  the screen answers now, so the case is most likely only slow, since"
        echo "  attached code is screened in parts. Resume with a longer"
        echo "  FILEDRAWER_SCREEN_WAIT_SECONDS, or after 00:00 UTC if"
        echo "  $base/staging/status shows half the day's cap or more spent, since"
        echo "  attachments may spend only that half"
      else
        echo "  the screen answers now, so the case was only slow: rerun"
      fi ;;
    *) echo "  POST /series answered $CODE${reason:+: $reason}" ;;
  esac
}

if [[ $mode == eval ]]; then
  declare -A wanted=() met=()
  # Set once the run can't go on now, since every later case would wait out its time
  # for nothing: a case left undecided, or a request the server can't take now, which
  # stop_why then names.
  stopped=0
  stop_why=""
  field_test_dir="${FILEDRAWER_FIELD_TEST_DIR:-$(dirname "$0")/../field-test}"
  # The field-test entries' attached files, named by SHA-256, as bin/field-test-files
  # gathers them.
  store="$field_test_dir/files"
  # bin/field-test-batches: which files are entries, and the batches --families sends.
  batches_tool="$(dirname "$0")/../bin/field-test-batches"

  # record FIELD...: appends a line to the run file, its fields split by tabs.
  record() {
    local IFS=$'\t'
    printf '%s\n' "$*" >> "$run_file"
  }

  # listed LIST: the store path of each file the attachment list LIST names, one a
  # line as `<origin> <size> <sha256>`, a last line with no newline included.
  listed() {
    local line
    while IFS= read -r line || [[ -n $line ]]; do
      printf '%s\n' "$store/${line##* }"
    done < "$1"
  }

  # list_of ENTRY: the list of ENTRY's attached files, beside it.
  list_of() {
    printf '%s\n' "${1%.md}.attachments"
  }

  # gathered LIST: whether the store holds every file LIST names.
  gathered() {
    local path
    while IFS= read -r path; do
      [[ -f $path ]] || return 1
    done < <(listed "$1")
  }

  # list_key LIST: the key a set made from LIST goes by in the run file.
  list_key() {
    sha256sum < "$1" | cut -d' ' -f1
  }

  # The run file: the run's tag, its cases in order, then what it sent, so --resume
  # goes on without sending anything twice. It holds paths and IDs, never entry text.
  if [[ -n $resume_file ]]; then
    run_file=$resume_file
    tag=$(sed -n 's/^tag\t//p' "$run_file" 2>/dev/null | head -1)
    if [[ -z $tag ]]; then
      echo "smoke-staging: can't read $run_file as an eval run file" >&2
      exit 2
    fi
  else
    run_file="$ops_dir/.eval-runs/$tag"
    mkdir -p "$(dirname "$run_file")"
    record tag "$tag"
    for expected in public rejected review; do
      for file in "$(dirname "$0")/screen-eval/$expected"/*.md; do
        [[ -e $file ]] && record case "$expected" "$file"
      done
    done
    record field-tests "$field_tests"
    # Each repo's latest round, the field test's last word on it: the families
    # --families sends, and the folders a sample is drawn from, since earlier rounds
    # hold near-copies in older formats.
    declare -A latest=() latest_round=()
    for family in "$field_test_dir"/round*/*/; do
      [[ -d $family ]] || continue
      family=${family%/}
      repo=$(basename "$family")
      round=$(basename "$(dirname "$family")")
      round=${round#round}
      [[ $round =~ ^[0-9]+$ ]] || continue
      if (( round > ${latest_round[$repo]:-0} )); then
        latest_round[$repo]=$round
        latest[$repo]=$family
      fi
    done
    mapfile -t latest_dirs < <(for repo in "${!latest[@]}"; do printf '%s\n' "${latest[$repo]}"; done | sort)
    if (( families )); then
      for family in "${latest_dirs[@]}"; do
        record family "$family"
      done
    fi
    # Field-test entries, in a random order fixed here: the latest rounds' entries, as
    # bin/field-test-batches reads them for --families too. One whose attached files
    # aren't all gathered is passed over.
    if (( field_tests > 0 )); then
      passed_over=0
      : > "$dir/entries"
      for family in "${latest_dirs[@]}"; do
        # Its own message, on stderr, names the file it couldn't read.
        "$batches_tool" entries "$family" >> "$dir/entries" || record unread "$family"
      done
      while IFS= read -r file; do
        if [[ -f $(list_of "$file") ]] && ! gathered "$(list_of "$file")"; then
          passed_over=$((passed_over + 1))
          continue
        fi
        record candidate "$file"
      done < <(shuf "$dir/entries")
      record passed-over "$passed_over"
    fi
  fi
  echo "run file: $run_file"

  cases=() expecteds=() candidates=() family_dirs=() unread=()
  declare -A sent=() set_ids=() set_lists=() status_of=() series_ids=() batch_ids=()
  declare -A series_failed=()
  # Each refused entry: refused marks it, and for a refusal the server gave, the reply's
  # code, the file holding its reasons, and what was refused.
  declare -A refused=() refused_code=() refused_reasons=() refused_what=()
  passed_over=0
  # How many refusals the run met, this session's and those a resumed run reports again.
  refusals=0
  while IFS=$'\t' read -r kind one two three four; do
    case $kind in
      case) expecteds+=("$one"); cases+=("$two") ;;
      field-tests) field_tests=$one ;;
      family) family_dirs+=("$one") ;;
      series) series_ids[$one]=$two ;;
      series-failed) series_failed[$one]=1 ;;
      unread) unread+=("$one") ;;
      batch) batch_ids[$one]=$two ;;
      candidate) candidates+=("$one") ;;
      passed-over) passed_over=$one ;;
      sent) sent[$one]=$two ;;
      refused)
        refused[$one]=1
        refused_code[$one]=$two
        refused_reasons[$one]=$three
        refused_what[$one]=$four ;;
      set) set_ids[$one]=$two; set_lists[$one]=$three ;;
    esac
  done < "$run_file"
  # A family a sample couldn't list is a failure of every session of the run, so a
  # resumed one reports it too.
  for family in "${unread[@]}"; do
    echo "FAIL a family's entries: bin/field-test-batches couldn't read them ($family)"
    fail=$((fail + 1))
  done

  # bin: the filedrawer binary, whose `unpack` is the server's own decoding, needed
  # only when a field-test entry attaches files.
  attaches=0
  for file in "${candidates[@]}"; do
    [[ -f $(list_of "$file") ]] && attaches=1
  done
  for family in "${family_dirs[@]}"; do
    compgen -G "$family/*.attachments" > /dev/null && attaches=1
  done
  bin=""
  if (( attaches )); then
    bin=${FILEDRAWER_BIN:-}
    if [[ -z $bin ]]; then
      repo="$(dirname "$0")/.."
      if ! (cd "$repo" && cargo build -q --bin filedrawer); then
        echo "smoke-staging: building filedrawer failed; run cargo build --bin filedrawer to see why" >&2
        exit 2
      fi
      bin="${CARGO_TARGET_DIR:-$repo/target}/debug/filedrawer"
    fi
  fi

  # judge NAME EXPECTED: the entry just screened against EXPECTED.
  judge() {
    local status
    status=$(field status)
    # An entry that passed while its series is hidden waits on it: the screen passed it.
    # Eval's series were hidden until hidden series were paused (design.md, Embargo).
    [[ $2 == public && $status == waiting_on_series ]] && status=public
    wanted[$2]=$(( ${wanted[$2]:-0} + 1 ))
    if [[ $status == "$2" ]]; then
      echo "PASS $2 $1"
      pass=$((pass + 1)); met[$2]=$(( ${met[$2]:-0} + 1 ))
    elif [[ $status == screening ]]; then
      echo "WAIT $2 $1 ($ID): not decided yet"
      fail=$((fail + 1))
      stopped=1
    elif [[ -z $status ]]; then
      echo "FAIL $2 $1 ($ID): GET /e/$ID answered $CODE: $(printf '%s' "$BODY" | head -c 300)"
      fail=$((fail + 1))
    else
      echo "FAIL $2 $1 ($ID): got $status"
      fail=$((fail + 1))
      [[ $status == review && $2 != review ]] && echo "  if every case went to review, the screen-test account is still guarded: clear it on $base/admin"
    fi
  }

  # stop_run WHY: stops the run, counted as a failure, since what is left can't be sent
  # now; WHY names what wouldn't take it.
  stop_run() {
    stopped=1
    stop_why=$1
    fail=$((fail + 1))
  }

  # fail_refused WHAT KEY...: the last reply refused WHAT (such as "a field-test
  # entry"), a failure. Its reasons quote slugs, links and commands, so they go to a
  # file beside the run file, git-ignored with it, and only that file's place is
  # printed. The run file records the refusal against each KEY.
  fail_refused() {
    local what=$1 reasons key
    shift
    reasons="$run_file.refused-$(( $(compgen -G "$run_file.refused-*" | wc -l) + 1 ))"
    printf '%s\n' "$BODY" > "$reasons"
    echo "FAIL $what was refused ($CODE); its reasons are in $reasons"
    fail=$((fail + 1))
    refusals=$((refusals + 1))
    for key; do
      refused[$key]=1
      refused_code[$key]=$CODE
      refused_reasons[$key]=$reasons
      refused_what[$key]=$what
      record refused "$key" "$CODE" "$reasons" "$what"
    done
  }

  # recount_refusal WHAT KEY: whether the run already found KEY refused. One the server
  # refused counts again as a failure, so a resumed run's tally covers the whole run;
  # one eval refused itself, such as a set it couldn't build, was said when it was.
  recount_refusal() {
    [[ -n "${refused[$2]:-}" ]] || return 1
    if [[ -n "${refused_code[$2]:-}" ]]; then
      echo "FAIL ${refused_what[$2]:-$1} was refused (${refused_code[$2]}); its reasons are in ${refused_reasons[$2]}"
      fail=$((fail + 1))
      refusals=$((refusals + 1))
    fi
  }

  # first_reason: the first reason in the last reply, a `- ` line or an `error: ` one.
  first_reason() {
    printf '%s\n' "$BODY" | sed -n 's/^- //p; s/^error: //p' | head -1
  }

  # later: whether the last request's CODE asks to try again later: no answer, a 429
  # or a 5xx.
  later() {
    [[ $CODE == 000 || $CODE == 429 || $CODE == 5* ]]
  }

  # eval_case KEY FILE [quiet]: the case KEY, as the entry FILE: submitted and
  # recorded, unless the run already sent it, which is polled instead. Returns 1 when
  # the server refuses it, 2 when it can't take it now (see later), and 3 when it
  # can't be published, a FAIL already counted.
  eval_case() {
    if [[ -z "${sent[$1]:-}" ]]; then
      if ! send "$2" "${3:-}"; then
        later && return 2
        return 1
      fi
      sent[$1]=$ID
      record sent "$1" "$ID"
      publish_then_await "$(case_wait)" || return 3
    else
      ID=${sent[$1]}
      req GET "/e/$ID"
      if [[ $(field status) == pending ]]; then
        publish_then_await "$(case_wait)" || return 3
      else
        await "$(case_wait)"
      fi
    fi
  }

  # case_wait: how long the case being sent may take to screen: the screen wait, or 4
  # times it for one citing attached code (CITED), which the screen reads in parts.
  case_wait() {
    echo $(( ${CITED:-0} ? screen_wait * 4 : screen_wait ))
  }

  series_n=0

  # make_series MADEUP FILE: creates the series FILE holds, which the family's entries
  # cite as MADEUP, as a case expected made. Returns 1 when the server can't take it
  # now (see later), stopping the run.
  make_series() {
    local reason
    series_n=$((series_n + 1))
    "$batches_tool" series-body "$2" > "$dir/series.md" || { echo "FAIL series series-$series_n: bin/field-test-batches couldn't read it"; fail=$((fail + 1)); return 0; }
    req POST /series "$dir/series.md"
    wanted[series]=$(( ${wanted[series]:-0} + 1 ))
    if [[ $CODE == 201 ]]; then
      series_ids[$1]=$(field id)
      record series "$1" "${series_ids[$1]}" "$2"
      echo "PASS series series-$series_n"
      pass=$((pass + 1)); met[series]=$(( ${met[series]:-0} + 1 ))
      return 0
    fi
    if later; then
      stop_run "POST /series answered $CODE"
      return 1
    fi
    # The reply's own words, with the author's quoted values masked; never its key.
    reason=$(first_reason | sed 's/`[^`]*`/`X`/g')
    echo "FAIL series series-$series_n: $CODE${reason:+: $reason}; its entries go without it"
    fail=$((fail + 1))
    # Never sent again: a series the screen held back mustn't be resent.
    series_failed[$1]=1
    record series-failed "$1"
  }

  # in_review MEMBER...: whether any of these sent entries is in review, which holds
  # the rest of its batch for the owner.
  in_review() {
    local m
    for m; do
      ID=${sent[$m]}
      req GET "/e/$ID"
      [[ $(field status) == review ]] && return 0
    done
    return 1
  }

  # send_batch BODY MEMBERS: sends the batch BODY, whose entries are the files MEMBERS
  # lists, and judges every member, unless the run already sent it, which is polled
  # instead (published first if its hold is still on). Returns 1 when the run stops.
  send_batch() {
    local m unsent=0
    mapfile -t batch_members < "$2"
    recount_refusal "a batch of ${#batch_members[@]} field-test entries" "${batch_members[0]}" && return 0
    CITED=0
    for m in "${batch_members[@]}"; do
      [[ -f $(list_of "$m") ]] && CITED=1
      [[ -z "${sent[$m]:-}" ]] && unsent=$((unsent + 1))
    done
    if (( unsent == ${#batch_members[@]} )); then
      post_batch "$1"
      case $? in
        1) return 1 ;;
        2) return 0 ;;
      esac
    elif (( unsent > 0 )); then
      echo "FAIL a batch of ${#batch_members[@]} field-test entries: the run sent some of them in another batch, so the family changed since"
      fail=$((fail + 1))
      return 0
    else
      ID=${sent[${batch_members[0]}]}
      req GET "/e/$ID"
      [[ $(field status) == pending ]] && req POST "/batches/${batch_ids[${batch_members[0]}]:-}/publish"
    fi
    judge_batch
  }

  # post_batch BODY: sends the batch BODY, whose entries are batch_members, records
  # them and publishes it. Returns 1 when the server can't take it now (see later),
  # stopping the run, and 2 when it refuses it, a FAIL.
  post_batch() {
    local -a ids
    local i m reasons first=${batch_members[0]}
    req POST /entries/batch "$1" application/json
    if [[ $CODE != 201 ]]; then
      if later; then
        stop_run "POST /entries/batch answered $CODE"
        return 1
      fi
      fail_refused "a batch of ${#batch_members[@]} field-test entries" "${batch_members[@]}"
      return 2
    fi
    mapfile -t ids < <(printf '%s\n' "$BODY" | sed -n 's/^entry: \([^ ]*\) .*/\1/p')
    batch_ids[$first]=$(field id)
    record batch "$first" "${batch_ids[$first]}"
    for i in "${!batch_members[@]}"; do
      sent[${batch_members[$i]}]=${ids[$i]:-}
      record sent "${batch_members[$i]}" "${ids[$i]:-}"
    done
    req POST "/batches/${batch_ids[$first]}/publish"
    [[ $CODE == 200 ]] || { echo "FAIL publish batch ${batch_ids[$first]}: $CODE"; fail=$((fail + 1)); }
    return 0
  }

  # judge_batch: waits for the sent batch batch_members and judges each member as a
  # field-test case expected public. Returns 1 when the run stops.
  judge_batch() {
    local m wait held=0 waiting=0 first=${batch_members[0]} n=${#batch_members[@]}
    local -a members=("${batch_members[@]}")
    # The members are decided together, so the first waits for the whole batch, unless
    # a member in review holds the rest for the owner.
    wait=$(( $(case_wait) * ((n + 9) / 10) ))
    ID=${sent[$first]}
    await "$(case_wait)"
    if [[ $(field status) == screening ]] && ! in_review "${members[@]}"; then
      ID=${sent[$first]}
      await $(( wait - $(case_wait) ))
    fi
    in_review "${members[@]}" && held=1
    for m in "${members[@]}"; do
      ID=${sent[$m]}
      if (( held )) || [[ $m == "$first" ]]; then
        req GET "/e/$ID"
      else
        await "$screen_wait"
      fi
      if (( held )) && [[ $(field status) == screening ]]; then
        waiting=$((waiting + 1))
        continue
      fi
      taken=$((taken + 1))
      judge "field-test-$taken" public
      status_of[$m]=$(field status)
      (( stopped )) && return 1
    done
    (( waiting )) && echo "  $waiting field-test entries wait in a batch for the owner's decision on a member in review"
    return 0
  }

  # send_family DIR: makes the family's series and uploads its sets, unless the run
  # already has, then sends its batches in order. Returns 1 when the run stops.
  send_family() {
    local kind one two out k
    local -a args=()
    while IFS=$'\t' read -r kind one two; do
      case $kind in
        series)
          if [[ -z "${series_ids[$one]:-}" && -z "${series_failed[$one]:-}" && -n $two ]]; then
            make_series "$one" "$two" || return 1
          fi
          [[ -n "${series_ids[$one]:-}" ]] && args+=(--series "$one=${series_ids[$one]}") ;;
        list)
          set_for "$one" "goes without its attached code"
          case $? in
            0) args+=(--set "$one=$SET") ;;
            2) stop_run "an attachment set couldn't be uploaded now"; return 1 ;;
          esac ;;
      esac
    done < <("$batches_tool" needs "$1")
    out=$(mktemp -d -p "$dir")
    if ! "$batches_tool" build "$1" --tag "$tag" --out "$out" --max-bytes "${FILEDRAWER_BATCH_MAX_BYTES:-900000}" "${args[@]}" > /dev/null; then
      echo "FAIL a family's batches: bin/field-test-batches couldn't build them"
      fail=$((fail + 1))
      return 0
    fi
    k=1
    while [[ -f $out/batch-$k.json ]]; do
      send_batch "$out/batch-$k.json" "$out/batch-$k.members" || return 1
      k=$((k + 1))
    done
  }

  # set_for LIST [WHAT]: sets SET to the ID of the attachment set made from the files
  # LIST names, uploading it unless the run already did. Returns 1 when the server
  # refuses it and 3 when it can't be made from the store, saying what then happens
  # to its entry (WHAT, default "is passed over"), and 2 when the server can't take it
  # now (see later), saying why.
  set_for() {
    local key reason what=${2:-is passed over}
    key=$(list_key "$1")
    SET=${set_ids[$key]:-}
    [[ -n $SET ]] && return 0
    python3 - "$1" "$store" > "$dir/set.json" 2>/dev/null <<'PY' || { echo "  an attachment set couldn't be made from the store: its entry $what"; return 3; }
import json
import pathlib
import sys

listing, store = sys.argv[1], pathlib.Path(sys.argv[2])
repos, files = {}, []
for line in pathlib.Path(listing).read_text(encoding="utf-8").splitlines():
    origin, _size, sha = line.rsplit(" ", 2)
    head = origin.split(":", 1)[0]
    if "@" in head:
        # A repo the list names by a short name, as in `repo@<commit>:<path>`.
        repos[head.split("@", 1)[0]] = "no remote"
    elif not origin.startswith("author:"):
        # Round 2's lists give bare paths, with no commit; the screen doesn't judge
        # origins.
        origin = f"author:{origin}"
    # As bytes, so line ends stay as the list's hash has them.
    text = (store / sha).read_bytes().decode("utf-8")
    files.append({"origin": origin, "text": text})
json.dump({"repos": repos, "files": files}, sys.stdout)
PY
    req POST /attachments "$dir/set.json" application/json
    case $CODE in
      201)
        SET=$(field id)
        set_ids[$key]=$SET
        set_lists[$key]=$1
        record set "$key" "$SET" "$1" ;;
      *)
        if later; then
          reason=$(first_reason)
          echo "  POST /attachments answered $CODE${reason:+: $reason}"
          return 2
        fi
        echo "  POST /attachments answered $CODE: its entry $what"
        return 1 ;;
    esac
  }

  # decode_tally: what the server's own decoding finds hidden in the files of each set
  # the run sent, each file counted once, run here with no model call, since the
  # screen's verdict can't say; then how the field-test entries citing a set that
  # hides text fared. It prints counts only, never what a file hides.
  decode_tally() {
    (( ${#set_lists[@]} )) || return 0
    declare -A seen=() hides=() by_status=()
    local key line path what n status files=0 hiding=0 parts=0 bytes=0 limits=0
    local -a paths
    for key in "${!set_lists[@]}"; do
      mapfile -t paths < <(listed "${set_lists[$key]}")
      "$bin" unpack "${paths[@]}" > "$dir/unpack" || echo "  filedrawer unpack couldn't read a set's files"
      while IFS= read -r line; do
        path=${line%%: *}
        what=${line#*: }
        [[ $what == "nothing hidden" ]] || hides[$key]=1
        [[ -n "${seen[$path]:-}" ]] && continue
        seen[$path]=1
        files=$((files + 1))
        case $what in
          "nothing hidden") ;;
          "past a limit: "*) limits=$((limits + 1)) ;;
          *)
            hiding=$((hiding + 1))
            parts=$((parts + ${what%% part*}))
            n=${what#*, }
            bytes=$((bytes + ${n%% bytes*})) ;;
        esac
      done < "$dir/unpack"
    done
    echo "decoding, run here with no model call: $hiding of $files attached files hide text; parts found: $parts, $bytes bytes; past a limit: $limits"
    n=0
    for path in "${!status_of[@]}"; do
      [[ -f $(list_of "$path") ]] || continue
      key=$(list_key "$(list_of "$path")")
      [[ -n "${hides[$key]:-}" ]] || continue
      n=$((n + 1))
      # A status a failed GET left empty counts as undecided, below.
      status=${status_of[$path]:-undecided}
      by_status[$status]=$(( ${by_status[$status]:-0} + 1 ))
    done
    local decided=$(( ${by_status[public]:-0} + ${by_status[rejected]:-0} + ${by_status[review]:-0} ))
    line="  field-test entries citing a set that hides text or passes a limit: $n (public ${by_status[public]:-0}, rejected ${by_status[rejected]:-0}, review ${by_status[review]:-0}"
    (( n > decided )) && line+=", undecided $((n - decided))"
    echo "$line)"
  }

  for i in "${!cases[@]}"; do
    file=${cases[$i]}
    screen_entry "$file" > "$dir/case.md"
    CITED=0
    eval_case "$file" "$dir/case.md" && judge "$(basename "$file" .md)" "${expecteds[$i]}"
    (( stopped )) && break
  done
  # A field-test entry the server refuses, or whose set it refuses, is a FAIL, its
  # reasons in a file (fail_refused); it costs no screening. Only an entry's number and
  # ID are printed, never its contents.
  taken=0
  for file in "${candidates[@]}"; do
    (( taken < field_tests && ! stopped )) || break
    recount_refusal "a field-test entry" "$file" && continue
    screen_entry "$file" > "$dir/case.md"
    list=$(list_of "$file")
    CITED=0
    if [[ -f $list ]]; then
      CITED=1
      if [[ -z "${sent[$file]:-}" ]]; then
        set_for "$list"
        case $? in
          1) fail_refused "a field-test entry's attachment set" "$file"; continue ;;
          2) stop_run "an attachment set couldn't be uploaded now"; break ;;
          3) refused[$file]=1; record refused "$file"; continue ;;
        esac
        sed -i "1a attachments: $SET" "$dir/case.md"
      fi
    fi
    eval_case "$file" "$dir/case.md" quiet
    case $? in
      1) fail_refused "a field-test entry" "$file"; continue ;;
      2) stop_run "POST /entries answered $CODE"; break ;;
      3) continue ;;
    esac
    taken=$((taken + 1))
    judge "field-test-$taken" public
    status_of[$file]=$(field status)
  done
  for family in "${family_dirs[@]}"; do
    (( stopped )) && break
    send_family "$family" || break
  done
  (( field_tests > 0 && taken < field_tests && ! stopped )) && echo "  only $taken field-test entries found"
  (( passed_over > 0 )) && echo "  $passed_over field-test entries passed over: their attached files aren't all in $store; bin/field-test-files gathers them"
  (( refusals > 0 )) && echo "  $refusals refused at submission; the reasons are in $run_file.refused-*"
  if (( stopped )); then
    if [[ -n $stop_why ]]; then
      echo "Stopped: $stop_why."
    else
      echo "Stopped: a case wasn't decided in time. Entries already sent wait in the"
      echo "  queue, and are screened once the screen answers."
      explain_undecided
    fi
    echo "Resume with: ops/smoke-staging eval --resume $run_file"
  fi
  for expected in public rejected review series; do
    [[ $expected == series && -z "${wanted[series]:-}" ]] && continue
    echo "$expected: ${met[$expected]:-0} of ${wanted[$expected]:-0}"
  done
  echo "  (a miss on review may mean the screen saw that its made-up data is made up)"
  decode_tally
  # Only once the run is over: a resume would read a review case the owner rejected
  # as a miss.
  (( ${wanted[review]:-0} > 0 && ! stopped )) && echo "Reject the review cases on $base/admin, then clear the screen-test account's guard there."
  echo "eval $tag: $pass passed, $fail failed"
  (( fail == 0 ))
  exit
fi

if [[ $mode == screen ]]; then
  # stop_if_undecided NAME: returns when the entry just screened was decided; else
  # exits, with 3 when the day's cap is spent and nothing failed before, or 1.
  stop_if_undecided() {
    [[ $(field status) != screening ]] && return
    echo "WAIT $1 ($ID): not decided within ${screen_wait}s"
    explain_undecided
    if (( DAY_SPENT && fail == 0 )); then
      echo "screen $tag: $pass passed, the rest not checked"
      exit 3
    fi
    echo "screen $tag: $pass passed, $((fail + 1)) failed"
    exit 1
  }
  screen_entry "$fixture" > "$dir/on.md"
  if screened "$dir/on.md"; then
    stop_if_undecided "on-topic entry"
    status=$(field status)
    check "on-topic entry: public" '[[ $status == public ]]'
    check "on-topic entry: screened, not passed unscreened" '[[ $BODY != *"not screened"* ]]'
    explain "$status" public
  fi
  screen_entry "$(dirname "$0")/screen-eval/rejected/sourdough.md" > "$dir/off.md"
  if screened "$dir/off.md"; then
    stop_if_undecided "off-topic entry"
    status=$(field status)
    check "off-topic entry: rejected" '[[ $status == rejected ]]'
    check "off-topic entry: gives its reasons" '[[ $BODY == *"reason: "* ]]'
    explain "$status" rejected
  fi
  echo "screen $tag: $pass passed, $fail failed"
  (( fail == 0 ))
  exit
fi

req GET /skill.md
check "skill.md is live" '[[ $CODE == 200 ]]'

# The skills (design.md, Skills): a HEAD of /skill.md names each one's version, and
# each version's git tag, rendered as the installer renders it, holds what the site
# serves at /skills/<name>/, so an install from the tag gets what this server describes.
skills=$(curl -sSI --suppress-connect-headers --max-time 10 -K <(headers) "$base/skill.md" |
  tr -d '\r' | sed -n 's/^[Xx]-[Ff]iledrawer-[Ss]kills: //p')
check "skill.md names both skills' versions" \
  '[[ $skills =~ ^filedrawer-search/[0-9]+,\ filedrawer-submit/[0-9]+$ ]]'
tags_url=${FILEDRAWER_SKILL_TAGS_URL:-https://raw.githubusercontent.com/filedrawer-dev/filedrawer}
host=${base#*://}
host=${host%%/*}
for pair in ${skills//,/}; do
  name=${pair%/*}
  n=${pair#*/}
  files=$(curl -s -K <(headers) "$base/skills/$name/SKILL.md" | sed -n 's/^  files: "\(.*\)"$/\1/p')
  check "$name $n: SKILL.md lists its files" '[[ -n $files ]]'
  for file in $files; do
    curl -fsSL --max-time 30 "$tags_url/refs/tags/skill-$name-v$n/skills/$name/$file" 2>/dev/null |
      sed "s#[{]{BASE}}#$base#g; s#[{]{HOST}}#$host#g" > "$dir/tagged"
    CODE=$(curl -s -o "$dir/served" -w '%{http_code}' -K <(headers) "$base/skills/$name/$file")
    check "$name $n: the tag's $file is what the site serves" \
      '[[ $CODE == 200 && -s $dir/tagged ]] && cmp -s "$dir/tagged" "$dir/served"'
  done
done

make_entry single "compute: 1h" > "$dir/e1.md"
req POST /entries "$dir/e1.md"
