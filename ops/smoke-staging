#!/usr/bin/env bash
# Smoke test of a File Drawer server, staging by default, following /skill.md as an
# agent would: submit, the hour's hold, a fix with PUT, publish, search, a new
# version, and a batch with slugs and runs. Each entry's title says it is a smoke
# test, and staging keeps them. CI runs it after each deploy to staging.
set -uo pipefail

usage() {
  cat <<'EOF'
usage: ops/smoke-staging [--wait SECONDS] [URL]
       ops/smoke-staging screen [--wait SECONDS] [URL]
       ops/smoke-staging eval [--field-test N] [--wait SECONDS] [URL]

Runs File Drawer's smoke test against URL (default https://staging.filedrawer.dev),
as /skill.md tells an agent to: submit, the hour's hold, a fix with PUT, publish,
search, a new version, and a batch with slugs and runs. Prints PASS or FAIL for each
check, then a tally, and exits 1 when any check fails.

  --wait SECONDS  first wait up to SECONDS for URL/skill.md to answer 200, as just
                  after a deploy (default: try once)
  -h, --help      print this

It reads two settings from the environment and prints neither:
  FILEDRAWER_STAGING_KEY      the staging key, sent as X-Staging-Key
  FILEDRAWER_STAGING_API_KEY  an API token for the account that submits
Exit status: 0 every check passed, 1 a check failed, 2 a usage or setting error,
3 (screen only) the day's screening cap is spent, so nothing more was checked.

screen checks that the server screens with the real model, which the plain smoke
test can't: staging doesn't screen CI's smoke account. CI runs it after each deploy
to staging (the screen-staging job), as CI's own screen account, whose token
ops/provision-vps smoke stores as the staging secret CI_SCREEN_TOKEN; by hand it runs
as the screen-test account (robocarver's mailbox), which eval uses too. Each run
spends a few Haiku calls. It submits a bland on-topic entry and
expects it public with no "not screened" note, and an off-topic one (sourdough) and
expects it rejected with its reasons. It never submits anything like a hazard: an
entry in review would put the account under the review guard. When an entry is still
being screened after the wait, it sends a bland series with POST /series, which the
server screens at once, to learn why: a 429 means the day's cap is spent, and it
exits 3, nothing more checked; anything else, such as a 503 when the model call
fails, is a failure. Its settings, neither printed:
  the token   FILEDRAWER_STAGING_SCREEN_API_KEY, else SCREEN_TEST_TOKEN in
              ops/.screen-test.env
  the key     FILEDRAWER_STAGING_KEY, else STAGING_KEY in ops/.vps.env
(FILEDRAWER_OPS_DIR moves where it looks for those files, FILEDRAWER_FIELD_TEST_DIR
where eval looks for field-test entries, and FILEDRAWER_SCREEN_WAIT_SECONDS how long
it waits for a verdict, default 120, for tests.)

eval runs a labelled test set through the screen, as the screen-test account, to
see whether it is too strict or too lax. By hand only. The cases are the entries
under ops/screen-eval/<expected>/, <expected> being public, rejected or review,
plus --field-test N (default 10; 0 for none) honest entries picked at random from
field-test/, expected public (their contents are never printed). It prints PASS or
FAIL per case and a tally per expectation, and exits 1 when any case misses. It
stops at the first case left undecided, and says why as screen does. The
owner then rejects the review cases on /admin, which guards the screen-test
account; clear the guard there afterwards. Same settings as screen.
  --field-test N  how many field-test entries to add
EOF
}

base=https://staging.filedrawer.dev
wait_seconds=0
screen_wait="${FILEDRAWER_SCREEN_WAIT_SECONDS:-120}"
[[ "$screen_wait" =~ ^[0-9]+$ ]] || { echo "smoke-staging: FILEDRAWER_SCREEN_WAIT_SECONDS takes a number of seconds" >&2; exit 2; }
mode=smoke
field_tests=10
while (( $# )); do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    screen | eval) mode=$1; shift ;;
    --field-test)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo "smoke-staging: --field-test takes a number" >&2; exit 2; }
      field_tests=$2; shift 2 ;;
    --wait)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo "smoke-staging: --wait takes a number of seconds" >&2; exit 2; }
      wait_seconds=$2; shift 2 ;;
    -*) echo "smoke-staging: unknown option $1 (-h lists them)" >&2; exit 2 ;;
    *) base=${1%/}; shift ;;
  esac
done
# setting_from FILE NAME: NAME's value in FILE, written as NAME='value', if any.
setting_from() {
  [[ -r "$1" ]] && sed -n "s/^$2='\(.*\)'\$/\1/p" "$1" | head -1
}

if [[ $mode == screen || $mode == eval ]]; then
  ops_dir="${FILEDRAWER_OPS_DIR:-$(dirname "$0")}"
  FILEDRAWER_STAGING_KEY="${FILEDRAWER_STAGING_KEY:-$(setting_from "$ops_dir/.vps.env" STAGING_KEY)}"
  if [[ -z "$FILEDRAWER_STAGING_KEY" ]]; then
    echo "smoke-staging: no staging key: set FILEDRAWER_STAGING_KEY, or STAGING_KEY in $ops_dir/.vps.env" >&2
    exit 2
  fi
  FILEDRAWER_STAGING_API_KEY="${FILEDRAWER_STAGING_SCREEN_API_KEY:-$(setting_from "$ops_dir/.screen-test.env" SCREEN_TEST_TOKEN)}"
  if [[ -z "$FILEDRAWER_STAGING_API_KEY" ]]; then
    echo "smoke-staging: no screen-test token: set FILEDRAWER_STAGING_SCREEN_API_KEY, or SCREEN_TEST_TOKEN in $ops_dir/.screen-test.env" >&2
    exit 2
  fi
fi
for name in FILEDRAWER_STAGING_KEY FILEDRAWER_STAGING_API_KEY; do
  if [[ -z "${!name:-}" ]]; then
    echo "smoke-staging: $name is not set; -h says what it holds" >&2
    exit 2
  fi
done

# Every entry starts from a made-up, bland fixture that passes cleanly and holds
# nothing a hazard screen could flag; crates/server/tests/smoke.rs fails if a change
# to it breaks this script.
fixture="$(dirname "$0")/smoke-fixture.md"
tag="smoke$(date -u +%Y%m%d%H%M%S)"
dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
pass=0
fail=0

# check NAME CONDITION: CONDITION is a [[ ]] test written in this file.
check() {
  if eval "$2"; then echo "PASS $1"; pass=$((pass + 1)); else echo "FAIL $1"; fail=$((fail + 1)); fi
}

# The secrets go to curl in a config read from a pipe, never on its command line.
headers() {
  printf 'header = "X-Staging-Key: %s"\n' "$FILEDRAWER_STAGING_KEY"
  [[ "${1:-}" == token ]] && printf 'header = "Authorization: Bearer %s"\n' "$FILEDRAWER_STAGING_API_KEY"
}

# req METHOD PATH [BODY-FILE] [CONTENT-TYPE]: a request with the token; sets CODE and BODY.
req() {
  local args=(-s -w '\n%{http_code}' -X "$1") out
  [[ -n "${3:-}" ]] && args+=(-H "Content-Type: ${4:-text/markdown}" --data-binary "@$3")
  out=$(curl "${args[@]}" -K <(headers token) "$base$2")
  CODE=${out##*$'\n'}
  BODY=${out%$'\n'*}
}

# anon PATH: a GET without the token; sets CODE.
anon() {
  CODE=$(curl -s -o /dev/null -w '%{http_code}' -K <(headers) "$base$1")
}

# field NAME: the first `NAME: value` line's value in BODY.
field() { printf '%s\n' "$BODY" | sed -n "s/^$1: //p" | head -1; }

# make_entry TITLE [LINE]: the fixture with a smoke-test title and tags, and LINE, if
# given, added to its front matter. The fixture links nothing, so staging fetches
# nothing for it.
make_entry() {
  local extra=""
  [[ -n "${2:-}" ]] && extra="$2\n"
  sed "s/^title: .*/title: SMOKE TEST $tag $1, not a real result/; s/^tags: .*/tags: [smoke-test, $tag]/; s/^written_by:/${extra}written_by:/" "$fixture"
}

if (( wait_seconds > 0 )); then
  deadline=$((SECONDS + wait_seconds))
  until anon /skill.md; [[ $CODE == 200 ]]; do
    if (( SECONDS >= deadline )); then
      echo "FAIL $base/skill.md didn't answer 200 within ${wait_seconds}s (last: $CODE)"
      exit 1
    fi
    sleep 2
  done
fi

# screened FILE [quiet]: submits FILE, publishes it, and waits up to 2 minutes while
# it is still being screened (an outage or the day's cap); sets ID, and CODE and BODY
# from GET /e/<id>. A refused submission is a FAIL, or with `quiet` just returns 1.
screened() {
  req POST /entries "$1"
  ID=$(field id)
  if [[ $CODE != 201 || -z "$ID" ]]; then
    [[ "${2:-}" == quiet ]] && return 1
    echo "FAIL submit $1: $CODE"; fail=$((fail + 1)); return 1
  fi
  req POST "/e/$ID/publish"
  [[ $CODE == 200 ]] || { echo "FAIL publish $ID: $CODE"; fail=$((fail + 1)); return 1; }
  local deadline=$((SECONDS + screen_wait))
  req GET "/e/$ID"
  while [[ $(field status) == screening ]] && (( SECONDS < deadline )); do
    sleep 5
    req GET "/e/$ID"
  done
}

# screen_entry FILE: FILE with this run's tags. The title stays as written: a test
# marker there could read as spam to the screen.
screen_entry() {
  sed "s/^tags: .*/tags: [screen-test, $tag]/" "$1"
}

# explain STATUS EXPECTED: why an entry screened to STATUS when EXPECTED was wanted.
explain() {
  [[ $1 == "$2" ]] && return
  case "$1" in
    review) echo "  it went to review: the screen saw a likely hazard, or the account is under the review guard; see $base/admin" ;;
    public) echo "  published unscreened: is staging still on FILEDRAWER_SCREENER=pass-all? (issue #7)" ;;
  esac
}

# explain_undecided: says why a case was left undecided, from a bland series sent
# with POST /series, which the server screens at once: a 429 saying the screening
# budget is spent means the day's cap is, which sets DAY_SPENT to 1 (else 0); a 429
# for the account's allowance doesn't. 503 means the model call fails. Of the reply
# it prints only the first reason: a 201's body holds the new, hidden series' join
# key.
explain_undecided() {
  DAY_SPENT=0
  printf -- '---\ntitle: Screen check %s, refusal-rate setup\n---\n%s\n' "$tag" \
    "Shared setup for refusal-rate evaluations of open-weight chat models: 500 prompts from a fixed benchmark at temperature 0, refusals counted by a keyword classifier checked by hand on 50 samples." \
    > "$dir/series.md"
  req POST /series "$dir/series.md"
  local reason
  # A refusal's first `- ` line, or a screen's rejection's `error: ` line: the
  # model's reasons below the delimiter aren't printed.
  reason=$(printf '%s\n' "$BODY" | sed -n 's/^- //p; s/^error: //p' | head -1)
  case "$CODE:$reason" in
    "429:the day's screening budget is spent"*)
      echo "  the day's screening cap is spent: rerun after 00:00 UTC"; DAY_SPENT=1 ;;
    503:*) echo "  screening fails; the server's log says why" ;;
    201:*) echo "  the screen answers now, so the case was only slow: rerun" ;;
    *) echo "  POST /series answered $CODE${reason:+: $reason}" ;;
  esac
}

if [[ $mode == eval ]]; then
  declare -A wanted=() met=()
  # Set once a case is left undecided: the day's cap is spent, or screening fails,
  # and every later case would wait out its time for nothing.
  stopped=0
  # judge NAME EXPECTED: the entry just screened against EXPECTED.
  judge() {
    local status
    status=$(field status)
    wanted[$2]=$(( ${wanted[$2]:-0} + 1 ))
    if [[ $status == "$2" ]]; then
      echo "PASS $2 $1"
      pass=$((pass + 1)); met[$2]=$(( ${met[$2]:-0} + 1 ))
    elif [[ $status == screening ]]; then
      echo "WAIT $2 $1 ($ID): not decided yet"
      fail=$((fail + 1))
      stopped=1
    else
      echo "FAIL $2 $1 ($ID): got $status"
      fail=$((fail + 1))
      [[ $status == review && $2 != review ]] && echo "  if every case went to review, the screen-test account is still guarded: clear it on $base/admin"
    fi
  }
  for expected in public rejected review; do
    for file in "$(dirname "$0")/screen-eval/$expected"/*.md; do
      [[ -e $file ]] || continue
      name=$(basename "$file" .md)
      screen_entry "$file" > "$dir/case.md"
      screened "$dir/case.md" && judge "$name" "$expected"
      (( stopped )) && break 2
    done
  done
  # Field-test entries: one per name, since the rounds hold near-copies. One the
  # server refuses, or that isn't an entry, is skipped; it costs no screening. Only
  # its number and ID are printed, never its contents.
  taken=0
  declare -A picked=()
  field_test_dir="${FILEDRAWER_FIELD_TEST_DIR:-$(dirname "$0")/../field-test}"
  while IFS= read -r file && (( taken < field_tests && ! stopped )); do
    name=$(basename "$file")
    [[ -n "${picked[$name]:-}" ]] && continue
    picked[$name]=1
    screen_entry "$file" > "$dir/case.md"
    screened "$dir/case.md" quiet || continue
    taken=$((taken + 1))
    judge "field-test-$taken" public
  done < <(find "$field_test_dir" -name '*.md' 2>/dev/null | shuf)
  (( field_tests > 0 && taken < field_tests && ! stopped )) && echo "  only $taken field-test entries found"
  if (( stopped )); then
    echo "Stopped: a case wasn't decided in time. Entries already sent wait in the"
    echo "  queue, and are screened once the screen answers."
    explain_undecided
  fi
  for expected in public rejected review; do
    echo "$expected: ${met[$expected]:-0} of ${wanted[$expected]:-0}"
  done
  echo "  (a miss on review may mean the screen saw that its made-up data is made up)"
  (( ${wanted[review]:-0} > 0 )) && echo "Reject the review cases on $base/admin, then clear the screen-test account's guard there."
  echo "eval $tag: $pass passed, $fail failed"
  (( fail == 0 ))
  exit
fi

if [[ $mode == screen ]]; then
  # stop_if_undecided NAME: returns when the entry just screened was decided; else
  # exits, with 3 when the day's cap is spent and nothing failed before, or 1.
  stop_if_undecided() {
    [[ $(field status) != screening ]] && return
    echo "WAIT $1 ($ID): not decided within ${screen_wait}s"
    explain_undecided
    if (( DAY_SPENT && fail == 0 )); then
      echo "screen $tag: $pass passed, the rest not checked"
      exit 3
    fi
    echo "screen $tag: $pass passed, $((fail + 1)) failed"
    exit 1
  }
  screen_entry "$fixture" > "$dir/on.md"
  if screened "$dir/on.md"; then
    stop_if_undecided "on-topic entry"
    status=$(field status)
    check "on-topic entry: public" '[[ $status == public ]]'
    check "on-topic entry: screened, not passed unscreened" '[[ $BODY != *"not screened"* ]]'
    explain "$status" public
  fi
  screen_entry "$(dirname "$0")/screen-eval/rejected/sourdough.md" > "$dir/off.md"
  if screened "$dir/off.md"; then
    stop_if_undecided "off-topic entry"
    status=$(field status)
    check "off-topic entry: rejected" '[[ $status == rejected ]]'
    check "off-topic entry: gives its reasons" '[[ $BODY == *"reason: "* ]]'
    explain "$status" rejected
  fi
  echo "screen $tag: $pass passed, $fail failed"
  (( fail == 0 ))
  exit
fi

req GET /skill.md
check "skill.md is live" '[[ $CODE == 200 ]]'

make_entry single "compute: 1h" > "$dir/e1.md"
req POST /entries "$dir/e1.md"
check "submit: 201 pending" '[[ $CODE == 201 && $(field status) == pending ]]'
ID=$(field id)
check "submit: warns about the unknown field" '[[ $BODY == *"warning: \`compute\`"* ]]'
anon "/e/$ID"
check "held entry hidden from others" '[[ $CODE == 404 ]]'
req GET "/e/$ID"
check "held entry shown to its author" '[[ $CODE == 200 && $(field status) == pending ]]'
make_entry single > "$dir/e1b.md"
req PUT "/e/$ID" "$dir/e1b.md"
check "PUT fixes it: 200, no warnings" '[[ $CODE == 200 && $BODY != *"warning:"* ]]'
req POST "/e/$ID/publish"
check "publish: public" '[[ $CODE == 200 && $(field status) == public ]]'
anon "/e/$ID"
check "public entry readable" '[[ $CODE == 200 ]]'
req GET "/search?q=$tag"
check "search finds it" '[[ $BODY == *"$ID"* ]]'

make_entry version > "$dir/v.md"
req POST "/e/$ID/versions" "$dir/v.md"
check "version: 201 with previous" '[[ $CODE == 201 && $(field previous) == "$ID" ]]'
VID=$(field id)
req POST "/e/$VID/publish"
check "version published" '[[ $(field status) == public ]]'
req GET "/e/$ID"
check "old version says superseded_by" '[[ $(field superseded_by) == "$VID" ]]'
req GET "/search?q=$tag"
check "search shows only the new version" '[[ $BODY == *"$VID"* && $BODY != *"$ID;"* ]]'

python3 - "$tag" "$fixture" > "$dir/batch.json" <<'PY'
import json, re, sys
tag, fixture = sys.argv[1:]
base = open(fixture).read()
def member(slug, title, extra):
    text = re.sub(r"^title: .*$", f"title: SMOKE TEST {tag} {title}, not a real result", base, flags=re.M)
    return re.sub(r"^tags: .*$", f"tags: [smoke-test, {tag}]\nslug: {tag}-{slug}\nuses_runs: [{tag}-run]{extra}", text, flags=re.M)
print(json.dumps({"runs": [{"id": f"{tag}-run", "description": "Smoke-test run, made up.", "n": 520}],
  "entries": [member("pilot", "pilot", f"\nsuperseded_by: slug:{tag}-main"), member("main", "main", "")]}))
PY
req POST /entries/batch "$dir/batch.json" application/json
check "batch: 201 pending" '[[ $CODE == 201 && $(field status) == pending ]]'
BID=$(field id)
members=$(printf '%s\n' "$BODY" | sed -n 's/^entry: \([^ ]*\) .*/\1/p')
PILOT=$(sed -n 1p <<< "$members")
MAIN=$(sed -n 2p <<< "$members")
req POST "/e/$PILOT/publish"
check "a member can't publish alone" '[[ $CODE == 409 ]]'
req POST "/batches/$BID/publish"
check "batch published" '[[ $CODE == 200 ]]'
req GET "/e/$PILOT"
check "slug link resolves" '[[ $BODY == *"link: slug:$tag-main = $MAIN"* ]]'
check "run listed with its entries" '[[ $BODY == *"run: $tag-run: entries"* ]]'

echo "tag $tag: $pass passed, $fail failed"
(( fail == 0 ))
