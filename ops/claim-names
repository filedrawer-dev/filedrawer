usage() {
  cat <<'EOF'
usage: ops/claim-names [-h]

Holds the name filedrawer on crates.io and PyPI, with the package whose command is
`filedrawer check` (entry-check under its new name), and
the @filedrawer scope on npm (design.md, Distribution; #74). Run it on your own
machine, from the repo root of a clean clone at origin/main, logged in to gh. It asks for a
crates.io token, hidden, and passes it to `cargo login`; nothing else is secret.

  crates.io   cargo login, then cargo publish of filedrawer-analyzer and then of
              filedrawer, at the versions in this clone's Cargo.toml files
  PyPI        your account and a pending trusted publisher, the GitHub environment
              pypi, then a run of .github/workflows/release-cli.yml on main, which
              publishes the version in main's crates/cli/Cargo.toml
  npm         the organization filedrawer; nothing is published there
  Homebrew    nothing to claim, said in a line

Each step checks the registry first and skips what is done, so a rerun picks up
where the last one stopped. Publishing can't be undone, so each publish asks first.
EOF
}

REPO_SLUG="filedrawer-dev/filedrawer"
REPO_URL="https://github.com/$REPO_SLUG"
# crates.io asks API clients for a User-Agent that says who they are.
USER_AGENT="filedrawer-claim-names ($REPO_URL)"
WORKFLOW="release-cli.yml"
# Seconds between checks while a registry catches up, and how many checks.
POLL_SECONDS="${CLAIM_NAMES_POLL_SECONDS:-10}"
POLLS=30

# cargo_version FILE: the first `version = "..."` in a Cargo.toml read on stdin.
cargo_version() {
  sed -n 's/^version = "\(.*\)"$/\1/p' | head -n 1
}

# http_get URL: the body, then a last line with the HTTP status (000 when the
# request failed).
http_get() {
  curl -sS -A "$USER_AGENT" -w '\n%{http_code}' "$1" 2>/dev/null || printf '\n000'
}

# crate_state NAME VERSION: prints `published` when crates.io has NAME at VERSION
# from this repo, `ours` when it has NAME from this repo without VERSION, `absent`
# when it has no NAME, `taken` when NAME names another repository, and `unknown`
# when crates.io didn't answer.
crate_state() {
  local name=$1 version=$2 reply status
  reply=$(http_get "https://crates.io/api/v1/crates/$name")
  status=${reply##*$'\n'}
  case $status in
    404) echo absent; return ;;
    200) ;;
    *) echo unknown; return ;;
  esac
  if ! python3 -c 'import json, sys; sys.exit(json.load(sys.stdin)["crate"].get("repository") != sys.argv[1])' \
    "$REPO_URL" <<<"${reply%$'\n'*}" 2>/dev/null; then
    echo taken
    return
  fi
  reply=$(http_get "https://crates.io/api/v1/crates/$name/$version")
  if [[ ${reply##*$'\n'} == 200 ]]; then echo published; else echo ours; fi
}

# pypi_state VERSION: like crate_state, for the PyPI project filedrawer, whose
# project_urls name the repository.
pypi_state() {
  local version=$1 reply status
  reply=$(http_get "https://pypi.org/pypi/filedrawer/json")
  status=${reply##*$'\n'}
  case $status in
    404) echo absent; return ;;
    200) ;;
    *) echo unknown; return ;;
  esac
  if ! python3 -c 'import json, sys; urls = (json.load(sys.stdin)["info"].get("project_urls") or {}).values(); sys.exit(sys.argv[1] not in urls)' \
    "$REPO_URL" <<<"${reply%$'\n'*}" 2>/dev/null; then
    echo taken
    return
  fi
  reply=$(http_get "https://pypi.org/pypi/filedrawer/$version/json")
  if [[ ${reply##*$'\n'} == 200 ]]; then echo published; else echo ours; fi
}

# npm_scope_state: `free` when npm has no user or org named filedrawer that has
# published, `exists` when the scope answers, `unknown` when npm didn't answer.
npm_scope_state() {
  local reply
  reply=$(http_get "https://registry.npmjs.org/-/org/filedrawer/package")
  case ${reply##*$'\n'} in
    404) echo free ;;
    200) echo exists ;;
    *) echo unknown ;;
  esac
}

# publish_crate NAME VERSION: publishes NAME from this clone, unless crates.io has
# it already. Returns 1, having said why, when it can't.
publish_crate() {
  local name=$1 version=$2 state
  state=$(crate_state "$name" "$version")
  case $state in
    published)
      say "crates.io has $name $version from this repo. ✓"
      return 0 ;;
    taken)
      warn "crates.io's $name belongs to another repository; it can't be ours."
      SKIPPED+=("crates.io: $name is taken")
      return 1 ;;
    unknown)
      warn "crates.io didn't answer about $name. Check your network, then rerun."
      SKIPPED+=("crates.io: $name not checked")
      return 1 ;;
  esac
  say "crates.io has no $name $version yet."
  if ! confirm "Publish $name $version to crates.io? It can't be deleted afterwards"; then
    SKIPPED+=("crates.io: publish $name (rerun ops/claim-names)")
    return 1
  fi
  if ! cargo publish --locked -p "$name"; then
    warn "cargo publish failed; its message above says why. Fix that, then rerun."
    SKIPPED+=("crates.io: publish $name")
    return 1
  fi
  # cargo waits for the index; the API can lag a little behind it.
  step "Checking crates.io for $name $version..."
  local poll
  for ((poll = 0; poll < POLLS; poll++)); do
    [[ $(crate_state "$name" "$version") == published ]] && { say "crates.io has $name $version. ✓"; return 0; }
    sleep "$POLL_SECONDS"
  done
  warn "crates.io doesn't list $name $version yet; rerun later to check."
  SKIPPED+=("crates.io: confirm $name $version is listed")
  return 1
}

run_wizard() {

case ${1:-} in
  -h | --help) usage; exit 0 ;;
  "") ;;
  *) usage >&2; exit 2 ;;
esac

TOTAL_STAGES=7
# Nothing is saved: the one secret goes to cargo, and the rest is on the registries.
ENV_FILE=/dev/null
if [[ ! -f crates/cli/Cargo.toml || ! -f crates/analyzer/Cargo.toml ]]; then
  echo "claim-names: run this from the repo root of a clone that has crates/cli; git pull first" >&2
  exit 1
fi
ANALYZER_VERSION=$(cargo_version < crates/analyzer/Cargo.toml)
CLI_VERSION=$(cargo_version < crates/cli/Cargo.toml)

banner "Claim filedrawer on crates.io, PyPI and npm"

stage "Tools"
missing=0
for tool in git curl python3; do
  if ! command -v "$tool" >/dev/null; then
    warn "$tool isn't installed: sudo apt install $tool"
    missing=1
  fi
done
if ! command -v gh >/dev/null || ! gh auth status >/dev/null 2>&1; then
  warn "gh isn't logged in here. Install it (https://cli.github.com) and run 'gh auth login'."
  missing=1
fi
if ! command -v cargo >/dev/null; then
  warn "cargo isn't installed. Get Rust with rustup, as https://rustup.rs says:"
  say "  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"
  say "then open a new terminal, or run: . \"\$HOME/.cargo/env\""
  missing=1
fi
if (( missing )); then
  say "Rerun ops/claim-names once these are in place."
  exit 1
fi
say "git, curl, python3, gh and cargo are here. ✓"
say "This clone has filedrawer-analyzer $ANALYZER_VERSION and filedrawer $CLI_VERSION."
pause

stage "crates.io: log in"
analyzer_state=$(crate_state filedrawer-analyzer "$ANALYZER_VERSION")
cli_state=$(crate_state filedrawer "$CLI_VERSION")
if [[ $analyzer_state == published && $cli_state == published ]]; then
  say "crates.io has both crates at these versions already, so there is nothing to log in for. ✓"
else
  say "crates.io accounts are GitHub logins. Publishing needs a verified email address."
  open_url "https://crates.io/settings/profile"
  step "Log in with GitHub, and add and verify an email address on this page."
  step "Then open API Tokens (https://crates.io/settings/tokens/new) and make a token:"
  note "  Name: filedrawer first publish"
  note "  Expiration: 7 days"
  note "  Scopes: publish-new and publish-update"
  note "  Crates: filedrawer*"
  pause "Press Enter once you have the token copied."
  token=""
  if ask_secret token "Paste the token (hidden; Enter alone keeps what cargo holds):" && [[ -n $token ]]; then
    if printf '%s\n' "$token" | cargo login >/dev/null 2>&1; then
      say "cargo saved the token in ~/.cargo/credentials.toml. ✓"
    else
      warn "cargo login failed. Rerun, and paste the token again."
      exit 1
    fi
  else
    note "Keeping the token cargo already holds."
  fi
  token=""
fi
pause

stage "crates.io: publish filedrawer-analyzer, then filedrawer"
say "filedrawer depends on filedrawer-analyzer, so the library goes first."
# cargo publishes this clone as it stands, and a version can't be replaced, so only
# what GitHub's main holds goes up, as on PyPI.
git fetch -q origin main 2>/dev/null || true
if [[ $(git rev-parse HEAD 2>/dev/null) != "$(git rev-parse origin/main 2>/dev/null)" ]] \
  || [[ -n $(git status --porcelain --untracked-files=no 2>/dev/null) ]]; then
  warn "This clone isn't origin/main, or has uncommitted changes, so nothing is published."
  say "Run 'git checkout --detach origin/main' (or pull), commit or stash, then rerun."
  SKIPPED+=("crates.io: rerun from a clean checkout of origin/main")
elif publish_crate filedrawer-analyzer "$ANALYZER_VERSION"; then
  publish_crate filedrawer "$CLI_VERSION" || true
else
  warn "filedrawer waits until filedrawer-analyzer is on crates.io."
fi
note "Revoke the token at https://crates.io/settings/tokens once both are up. Later"
note "releases can publish from CI with crates.io's trusted publishing instead."
pause

stage "PyPI: account and trusted publisher"
main_version=""
if git fetch -q origin main 2>/dev/null; then
  main_version=$(git show origin/main:crates/cli/Cargo.toml 2>/dev/null | cargo_version || true)
fi
pypi=$(pypi_state "${main_version:-$CLI_VERSION}")
case $pypi in
  published | ours)
    say "PyPI's filedrawer is this repo's already, so its trusted publisher is set. ✓"
    pause ;;
  taken)
    warn "PyPI's filedrawer belongs to another project; it can't be ours."
    SKIPPED+=("PyPI: filedrawer is taken")
    pause ;;
  *)
    say "PyPI makes the project at its first upload, from this repo's CI, so no token"
    say "is stored anywhere. Until then, a pending publisher doesn't hold the name."
    open_url "https://pypi.org/account/register/"
    step "Make an account, verify its email, and turn on two-factor authentication"
    step "(Account settings, Two factor authentication). PyPI requires it to publish."
    pause "Press Enter once your account has 2FA."
    open_url "https://pypi.org/manage/account/publishing/"
    step "Under 'Add a new pending publisher', choose GitHub and fill in:"
    note "  PyPI Project Name: filedrawer"
    note "  Owner: filedrawer-dev"
    note "  Repository name: filedrawer"
    note "  Workflow name: $WORKFLOW"
    note "  Environment name: pypi"
    step "Then click Add."
    pause "Press Enter once the pending publisher is listed." ;;
esac

stage "GitHub: the pypi environment"
if gh api "repos/$REPO_SLUG/environments/pypi" >/dev/null 2>&1; then
  say "$REPO_SLUG has the environment pypi. ✓"
else
  step "Making the environment pypi, open to main only..."
  gh api -X PUT "repos/$REPO_SLUG/environments/pypi" --input - >/dev/null <<'JSON'
{"deployment_branch_policy": {"protected_branches": false, "custom_branch_policies": true}}
JSON
  gh api -X POST "repos/$REPO_SLUG/environments/pypi/deployment-branch-policies" \
    -f name=main -f type=branch >/dev/null
  say "Made the environment pypi; only main's workflows can use it. ✓"
fi
pause

stage "PyPI: the first release"
if [[ $pypi == taken ]]; then
  warn "Skipped: PyPI's filedrawer isn't this repo's."
elif [[ -z $main_version ]] || ! git cat-file -e "origin/main:.github/workflows/$WORKFLOW" 2>/dev/null; then
  warn "origin/main has no .github/workflows/$WORKFLOW yet, and the workflow runs from main."
  say "Push main, then rerun ops/claim-names."
  SKIPPED+=("PyPI: push main, then rerun for the first release")
elif [[ $(pypi_state "$main_version") == published ]]; then
  say "PyPI has filedrawer $main_version. ✓"
else
  say "This starts $WORKFLOW on main, which builds the wheels and publishes"
  say "filedrawer $main_version, the version in main's crates/cli/Cargo.toml."
  if confirm "Publish filedrawer $main_version to PyPI? A version can't be uploaded twice"; then
    before=$(gh run list --repo "$REPO_SLUG" --workflow "$WORKFLOW" \
      --event workflow_dispatch --branch main --limit 1 \
      --json databaseId --jq '.[0].databaseId // ""')
    gh workflow run "$WORKFLOW" --repo "$REPO_SLUG" --ref main -f "version=$main_version"
    run=""
    for ((poll = 0; poll < POLLS; poll++)); do
      run=$(gh run list --repo "$REPO_SLUG" --workflow "$WORKFLOW" \
        --event workflow_dispatch --branch main --limit 1 \
        --json databaseId --jq '.[0].databaseId // ""')
      [[ -n $run && $run != "$before" ]] && break
      run=""
      sleep "$POLL_SECONDS"
    done
    if [[ -z $run ]]; then
      warn "The run didn't show up. Look at $REPO_URL/actions/workflows/$WORKFLOW"
      SKIPPED+=("PyPI: check the $WORKFLOW run")
    elif gh run watch "$run" --repo "$REPO_SLUG" --exit-status; then
      published=""
      for ((poll = 0; poll < POLLS; poll++)); do
        [[ $(pypi_state "$main_version") == published ]] && { published=1; break; }
        sleep "$POLL_SECONDS"
      done
      if [[ -n $published ]]; then
        say "PyPI has filedrawer $main_version. ✓"
      else
        warn "The run passed, but PyPI doesn't list filedrawer $main_version yet; rerun later to check."
        SKIPPED+=("PyPI: confirm filedrawer $main_version is listed")
      fi
    else
      warn "The run failed: gh run view $run --repo $REPO_SLUG --log-failed"
      SKIPPED+=("PyPI: the $WORKFLOW run failed")
    fi
  else
    SKIPPED+=("PyPI: the first release (rerun ops/claim-names)")
  fi
fi
pause

stage "npm: the @filedrawer scope"
say "npm's filedrawer belongs to an unrelated app, so our packages would be"
say "@filedrawer/NAME. Nothing is published there now."
scope=$(npm_scope_state)
if [[ $scope == exists ]]; then
  say "npm has a filedrawer scope. ✓"
  note "Without your npm login this can't tell whose it is: check that"
  note "https://www.npmjs.com/settings/filedrawer/members lists you."
else
  [[ $scope == unknown ]] && warn "npm didn't answer, so this can't tell whether the scope is free."
  open_url "https://www.npmjs.com/org/create"
  step "Log in, or sign up and turn on two-factor authentication, then create"
  step "the organization 'filedrawer' on the free plan (unlimited public packages)."
  note "npm counts an org that publishes nothing 'within a reasonable time' as squatting;"
  note "a package of ours there, such as @filedrawer/cli, keeps it."
  pause "Press Enter once the org exists."
  if [[ $(npm_scope_state) != exists ]]; then
    note "npm shows a scope only once it has published, so a new, empty org still"
    note "looks free from here: https://www.npmjs.com/settings/filedrawer/members shows it."
    SKIPPED+=("npm: check https://www.npmjs.com/settings/filedrawer/members lists you")
  fi
fi
pause

stage "Homebrew"
