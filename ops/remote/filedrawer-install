#!/usr/bin/env bash
# Installs a deployed binary and restarts its service (design.md, Hosting and
# operations). Runs as root: for staging through the one sudo rule the `deploy` user
# has, for production over the owner's own SSH, from ops/deploy-production (#42):
#   filedrawer-install staging <sha256>   < binary
#   filedrawer-install production <sha256> --expect-schema N|none   < binary
# It reads the binary from stdin into a root-owned file, refuses it over 64 MiB or
# when the hash differs, and checks it runs, as the environment's service user, since
# its code is whatever the deploy key's holder sent: in a transient unit with no
# network and no socket binds, that can't see the environment's data, stops after
# 10 s and takes any child it started down with it. It keeps the old binary as
# filedrawer.previous, restarts the service, and rolls back if the server doesn't
# answer on 127.0.0.1 within 30 s.
#
# Once it answers, it probes the server's way out (#102): the binary's
# `check-outbound`, as the service's user under the unit's own sandbox, in a transient
# unit given each [Service] setting of the installed unit. When the new binary can't
# reach a host, it probes the previous binary, then the new one again:
#   - the previous one gets out and the new one still doesn't: the binary is the
#     cause, so the previous binary goes back, keeping every write, and it exits 1;
#     unless the new binary changed the schema, which a rollback could break
#     (design.md), so it stays, and ops/deploy-production rolls back;
#   - the new one gets out on its second try: deployed, exit 0;
#   - the previous one fails too, or can't tell (no previous binary, or one from
#     before check-outbound), or the probe couldn't run at all: the new binary stays,
#     and it exits 3 with a warning naming the hosts, since the cause is the
#     environment, not the binary.
# It passes on only the probe's own lines, since the binary is the deploy key
# holder's code and CI reads its output.
#   filedrawer-install check-outbound staging|production
# runs the probe alone, on the installed binary, for ops/provision-vps: exit 0 when
# every host answered, or when there is nothing to probe yet, 3 when one didn't, 1
# when the probe couldn't run.
#
# Production also keeps its database: holding the lock the nightly copy takes (flock
# on backups/), it checks the schema is still the one ops/deploy-production saw,
# stops the service, writes a VACUUM INTO copy to backups/deploy-<UTC time>.db, then
# starts the new binary; on a failed health check it puts back the copy with the
# previous binary, so the new binary's migrations and writes go. It keeps the newest
# 3 deploy copies, none 13 days old. Every file operation in production's data folder
# runs as its user, since a bad binary running as that user could plant a symlink
# there for root to follow.
set -euo pipefail
# sudo over SSH starts it in /root, which the service users can't enter, and runuser
# keeps the cwd: find run there exits 1, though it searched. All paths are absolute.
cd /

# The overrides are for tests, which set FILEDRAWER_ROOT. sudo's env_reset drops all
# of them; when the root isn't overridden, the defaults are forced anyway.
root="${FILEDRAWER_ROOT:-}"
if [[ -z "$root" ]]; then
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  max_bytes=67108864
  health_seconds=30
  lock_seconds=900
  probe_lock_seconds=120
else
  max_bytes="${FILEDRAWER_MAX_BYTES:-67108864}"
  health_seconds="${FILEDRAWER_HEALTH_SECONDS:-30}"
  lock_seconds="${FILEDRAWER_LOCK_SECONDS:-900}"
  probe_lock_seconds="${FILEDRAWER_PROBE_LOCK_SECONDS:-120}"
fi

refuse() {
  echo "refused: $1" >&2
  exit 2
}

usage="usage: filedrawer-install staging <sha256> < binary
       filedrawer-install production <sha256> --expect-schema N|none < binary
       filedrawer-install check-outbound staging|production"
mode=deploy
if [[ "${1-}" == check-outbound ]]; then
  mode=check-outbound
  shift
  [[ $# -eq 1 ]] || refuse "$usage"
fi
environment="${1-}"
expected="${2-}"
case "$environment" in
  staging) port=8081 user=filedrawer ;;
  production) port=8080 user=filedrawer-prod ;;
  *) refuse "unknown environment '$environment'" ;;
esac
bin="$root/srv/filedrawer/$environment/bin"
service="filedrawer-$environment"
unit_file="$root/etc/systemd/system/$service.service"

# probe WHICH BINARY: runs BINARY's check-outbound in a transient unit named
# filedrawer-outbound-<env>-WHICH, given every [Service] setting of the installed unit
# but how to start and restart it. Sets probe_status (the binary's exit: 0 every host
# answered, 3 one didn't; anything else, the probe didn't run), probe_lines (its
# lines that fit the probe's own, each with a "probe: " prefix, at most 20),
# probe_hosts (the hosts it couldn't reach) and probe_errors (at most 5 lines of
# printable ASCII from its stderr and systemd-run's, which say why a probe didn't
# run, each with a "probe stderr: " prefix). Holds a lock, so a probe from
# provisioning waits for a deploy's.
probe() {
  local which="$1" binary="$2" line key props=() output section="" errors
  probe_lines="" probe_hosts="" probe_errors=""
  if [[ -d "$unit_file.d" ]]; then
    probe_lines="probe: $unit_file.d holds a drop-in, which the probe's unit can't copy"
    probe_status=100
    return
  fi
  if [[ ! -f "$unit_file" ]]; then
    probe_lines="probe: there is no $unit_file to copy"
    probe_status=100
    return
  fi
  while IFS= read -r line; do
    case "$line" in
      "["*) section="$line"; continue ;;
      "" | "#"*) continue ;;
    esac
    [[ "$section" == "[Service]" ]] || continue
    key="${line%%=*}"
    case "$key" in
      ExecStart | Restart | RestartSec | Type) continue ;;
    esac
    props+=(-p "$line")
  done < "$unit_file"
  mkdir -p "$root/run"
  exec 8>"$root/run/filedrawer-outbound-$environment.lock"
  flock -w "$probe_lock_seconds" 8 || {
    probe_lines="probe: another probe held the lock for ${probe_lock_seconds}s"
    probe_status=100
    exec 8>&-
    return
  }
  probe_status=0
  errors=$(mktemp)
  output=$(systemd-run --unit="filedrawer-outbound-$environment-$which" --wait --pipe --quiet \
    --collect "${props[@]}" -p RuntimeMaxSec=60 -- "$binary" check-outbound \
    < /dev/null 2>"$errors") || probe_status=$?
  exec 8>&-
  probe_lines=$(LC_ALL=C awk '/^(reached|skipped|can.t reach) [ -~]*$/ && n++ < 20 { print "probe: " substr($0, 1, 300) }' <<< "$output")
  probe_hosts=$(LC_ALL=C awk '/^can.t reach [!-9;-~]+:/ && n++ < 20 { sub(/^can.t reach /, ""); sub(/: .*/, ""); printf "%s%s", sep, $0; sep = ", " }' <<< "$output")
  probe_errors=$(LC_ALL=C awk '/^[ -~]+$/ && n++ < 5 { print "probe stderr: " substr($0, 1, 300) }' "$errors")
  rm -f "$errors"
}

# schema_now: production's or staging's schema version, `none` without a database,
# or empty when it can't be read. As the environment's user, read-only.
schema_now() {
  local database="$root/srv/filedrawer/$environment/data/filedrawer.db"
  if ! runuser -u "$user" -- test -e "$database"; then
    echo none
    return
  fi
  runuser -u "$user" -- sqlite3 -bail "file:$database?mode=ro" ".timeout 60000" \
    "SELECT max(version) FROM _sqlx_migrations;" 2>/dev/null || true
}

if [[ "$mode" == check-outbound ]]; then
  if [[ ! -x "$bin/filedrawer" ]]; then
    echo "$environment has no binary yet; its first deploy probes"
    exit 0
  fi
  probe current "$bin/filedrawer"
  [[ -n "$probe_lines" ]] && echo "$probe_lines"
  case "$probe_status" in
    0) exit 0 ;;
    3) echo "$environment's server can't reach: $probe_hosts" >&2; exit 3 ;;
    100) echo "the probe couldn't run: ${probe_lines#probe: }" >&2; exit 1 ;;
  esac
  # A binary from before check-outbound answers it with its usage, exit 2, and its
  # usage doesn't name it; a binary that has it exits 2 for settings it can't read.
  if [[ "$probe_status" == 2 ]] && ! grep -q check-outbound "$bin/filedrawer"; then
    echo "$environment's binary predates check-outbound; the next deploy probes"
    exit 0
  fi
  echo "the probe couldn't run (exit $probe_status)" >&2
  [[ -z "$probe_errors" ]] || echo "$probe_errors" >&2
  exit 1
fi
if [[ "$environment" == staging ]]; then
  [[ $# -eq 2 ]] || refuse "$usage"
else
  [[ $# -eq 4 && "$3" == --expect-schema && "$4" =~ ^([0-9]+|none)$ ]] || refuse "$usage"
  expect_schema="$4"
fi
[[ "$expected" =~ ^[0-9a-f]{64}$ ]] || refuse "'$expected' is not a SHA-256"

new="$bin/filedrawer.new"
trap 'rm -f "$new"' EXIT
head -c "$((max_bytes + 1))" > "$new"
if (( $(stat -c %s "$new") > max_bytes )); then
  refuse "the upload is over $max_bytes bytes"
fi
actual=$(sha256sum "$new" | cut -d' ' -f1)
[[ "$actual" == "$expected" ]] || refuse "the upload's SHA-256 is $actual, not $expected"
chmod 0755 "$new"

# A fixed name, so `journalctl -u filedrawer-check-<env>` shows why a check failed.
if ! systemd-run --unit="filedrawer-check-$environment" --wait --pipe --quiet --collect \
  -p User="$user" -p RuntimeMaxSec=10 -p SocketBindDeny=any -p PrivateNetwork=yes \
  -p ProtectSystem=strict -p ProtectHome=yes -p PrivateTmp=yes \
  -p NoNewPrivileges=yes -p InaccessiblePaths="-/srv/filedrawer/$environment/data" \
  -- "$new" -h < /dev/null > /dev/null 2>&1; then
  echo "the new binary doesn't run ('filedrawer -h' failed; journalctl -u filedrawer-check-$environment says why); nothing changed" >&2
  exit 1
fi

# healthy: polls /tags once a second. The first tries come before the server binds,
# so each try's error stays quiet; only the last is printed, when none answered.
healthy() {
  local tries error=""
  for (( tries = 0; tries < health_seconds; tries++ )); do
    if error=$(curl -fsS -o /dev/null --max-time 2 "http://127.0.0.1:$port/tags" 2>&1); then
      return 0
    fi
    sleep 1
  done
  [[ -n "$error" ]] && echo "$error" >&2
  return 1
}

# kept WHY: the new binary stays though the probe failed, since the binary isn't
# shown to be the cause; exit 3 fails the deploy's job, so the owner hears of it.
kept() {
  {
    echo
    echo "WARNING: $1."
    echo "WARNING: the new binary stays, and serves; exit 3 marks the deploy."
    [[ -z "$probe_errors" ]] || echo "$probe_errors"
  } >&2
  exit 3
}

# roll_back_binary HOSTS: the binary is the cause, and no migration stands in the
# way, so the previous binary goes back, keeping every write; when it doesn't
# answer, the new one does. Exits 1 either way.
roll_back_binary() {
  local hosts="$1" summary
  mv -f "$bin/filedrawer" "$bin/filedrawer.rejected"
  mv -f "$bin/filedrawer.previous" "$bin/filedrawer"
  systemctl restart "$service"
  if healthy; then
    rm -f "$bin/filedrawer.rejected"
    echo "the new server can't reach $hosts, which the previous binary reaches: rolled back to the previous binary, keeping every write" >&2
    exit 1
  fi
  mv -f "$bin/filedrawer" "$bin/filedrawer.previous"
  mv -f "$bin/filedrawer.rejected" "$bin/filedrawer"
  systemctl restart "$service"
  summary="the new server can't reach $hosts; rolled back, but the previous binary didn't answer within ${health_seconds}s, so put the new one back"
  if healthy; then
    echo "$summary. It answers." >&2
  else
    echo "$summary. It doesn't answer either: look at journalctl -u $service" >&2
  fi
  exit 1
}

# judge_outbound DEPLOYED: once the new server answers, probes its way out, then
# exits as the header says. DEPLOYED is the line a deploy that passed prints.
judge_outbound() {
  local deployed="$1" hosts schema_after
  probe new "$bin/filedrawer"
  [[ -n "$probe_lines" ]] && echo "$probe_lines"
  case "$probe_status" in
    0) echo "$deployed"; exit 0 ;;
    3) hosts="$probe_hosts" ;;
    100) kept "the probe couldn't run (${probe_lines#probe: }), so nothing shows whether the server gets out" ;;
    *) kept "the probe couldn't run (exit $probe_status; what it said follows, and journalctl -u filedrawer-outbound-$environment-new may say more), so nothing shows whether the server gets out" ;;
  esac
  [[ -x "$bin/filedrawer.previous" ]] ||
    kept "the new server can't reach $hosts, and with no previous binary to probe, the install can't tell whether the binary is the cause"
  probe previous "$bin/filedrawer.previous"
  case "$probe_status" in
    0) ;;
    3) kept "the new server can't reach $hosts, and the previous binary can't reach them either: the cause is the server's network, DNS or settings, not the binary" ;;
    *) kept "the new server can't reach $hosts, and the previous binary can't tell whether the binary is the cause (its probe exited $probe_status; a binary from before check-outbound exits 2)" ;;
  esac
  probe new "$bin/filedrawer"
  case "$probe_status" in
    0)
      echo "$deployed (the probe's first try couldn't reach $hosts; its last reached them)"
      exit 0
      ;;
    3) hosts="$probe_hosts" ;;
    *) kept "the new server couldn't reach $hosts, which the previous binary reaches, but the probe couldn't run on its second try (exit $probe_status), so nothing shows the binary is the cause" ;;
  esac
  schema_after=$(schema_now)
  local back="a revert on main deploys the binary before"
  [[ "$environment" == production ]] &&
    back="ops/deploy-production with the commit before rolls back, checking crates/server/migration-rollback.txt"
  if [[ -z "$schema_before" || -z "$schema_after" ]]; then
    echo "the new server can't reach $hosts, which the previous binary reaches, but the install couldn't read the schema, so it can't tell whether a rollback crosses a migration (design.md): the new binary stays, and $back" >&2
    exit 1
  fi
  if [[ "$schema_after" != "$schema_before" ]]; then
    echo "the new server can't reach $hosts, which the previous binary reaches, but it changed the schema from $schema_before to $schema_after, and a rollback across a migration can break (design.md), so the new binary stays: $back" >&2
    exit 1
  fi
  roll_back_binary "$hosts"
}

swap_in() {
  if [[ -e "$bin/filedrawer" ]]; then
    cp -p "$bin/filedrawer" "$bin/filedrawer.previous"
  fi
  mv -f "$new" "$bin/filedrawer"
}

if [[ "$environment" == staging ]]; then
  schema_before=$(schema_now)
  swap_in
  systemctl restart "$service"
  if healthy; then
    judge_outbound "deployed to $environment"
  fi
  if [[ -e "$bin/filedrawer.previous" ]]; then
    mv -f "$bin/filedrawer.previous" "$bin/filedrawer"
    systemctl restart "$service"
    echo "the new server didn't answer within ${health_seconds}s; rolled back to the previous binary" >&2
  else
    echo "the new server didn't answer within ${health_seconds}s, and there is no previous binary to roll back to" >&2
  fi
  exit 1
fi

# Production. as_user runs a command as production's user, for every path in its
# data folder.
data="$root/srv/filedrawer/$environment/data"
database="$data/filedrawer.db"
backups="$data/backups"
as_user() { runuser -u "$user" -- "$@"; }

as_user mkdir -p "$backups"
# Read-only, on the folder: opening it can't write anywhere, whatever it is.
exec 9<"$backups"
flock -w "$lock_seconds" 9 ||
  refuse "the nightly copy or another deploy has held the lock on $backups for ${lock_seconds}s; nothing changed"

if as_user test -e "$database"; then
  schema=$(as_user sqlite3 -bail "file:$database?mode=ro" ".timeout 60000" \
    "SELECT max(version) FROM _sqlx_migrations;") ||
    refuse "can't read production's schema version from $database; nothing changed"
else
  schema=none
fi
[[ "$schema" == "$expect_schema" ]] ||
  refuse "production's schema is $schema now, not the $expect_schema ops/deploy-production saw; run it again. Nothing changed"

# copy_database: writes the copy to $copy, as production's user, when there's room
# for it (the database and its -wal, with a margin), and checks it. Sets $why when it
# fails.
copy_database() {
  local size free
  size=$(as_user stat -c %s "$database") || { why="can't read its size"; return 1; }
  if as_user test -e "$database-wal"; then
    size=$(( size + $(as_user stat -c %s "$database-wal") )) || { why="can't read its -wal's size"; return 1; }
  fi
  local need=$(( size + size / 10 + 64 * 1024 * 1024 ))
  free=$(df -B1 --output=avail "$backups" | tail -n 1) || { why="df failed"; return 1; }
  [[ "$free" =~ ^[0-9]+$ ]] || { why="df said '$free'"; return 1; }
  (( free >= need )) || { why="too little free space: $free bytes, about $need needed"; return 1; }
  copy="$backups/deploy-$(date -u +%Y%m%dT%H%M%SZ).db" || { why="date failed"; return 1; }
  local quoted="${copy//\'/\'\'}"
  as_user sqlite3 -bail "file:$database?mode=ro" ".timeout 60000" "VACUUM INTO '$quoted';" ||
    { why="sqlite3 couldn't write it"; return 1; }
  [[ "$(as_user sqlite3 "file:$copy?mode=ro" "PRAGMA quick_check;")" == ok ]] ||
    { why="it failed PRAGMA quick_check"; return 1; }
}

systemctl stop "$service"
copy=""
why=""
if [[ "$schema" != none ]] && ! copy_database; then
  [[ -n "$copy" ]] && as_user rm -f "$copy"
  systemctl start "$service" || true
  echo "couldn't copy production's database ($why); started the old binary again, nothing changed" >&2
  exit 1
fi

swap_in
systemctl start "$service"
# prune: keeps the newest 3 deploy copies, and none 13 days old (18,720 minutes);
# the names sort by time. Never the copy just taken.
prune() {
  local old keep=3
  as_user find "$backups" -maxdepth 1 -name 'deploy-*.db' -mmin +18720 ! -path "$copy" -delete || return 1
  old=$(as_user find "$backups" -maxdepth 1 -name 'deploy-*.db' ! -path "$copy") || return 1
  mapfile -t old < <(sort <<< "$old" | sed '/^$/d')
  [[ -n "$copy" ]] && keep=2
  for (( i = 0; i + keep < ${#old[@]}; i++ )); do
    as_user rm -f -- "${old[i]}" || return 1
  done
}

if healthy; then
  prune || echo "deployed, but couldn't prune the old deploy copies in $backups; the next deploy or night tries again" >&2
  schema_before="$schema"
  judge_outbound "deployed to $environment${copy:+; the database before it is $copy}"
fi

# Each step goes on when one fails, so the service always starts again, and the
# message says what came back.
problems=()
systemctl stop "$service" || problems+=("systemctl stop failed")
if [[ -n "$copy" ]]; then
  { as_user rm -f "$database-wal" "$database-shm" &&
    as_user cp "$copy" "$database.restoring" &&
    as_user mv -f "$database.restoring" "$database"; } ||
    problems+=("couldn't put the database back from $copy")
fi
if [[ -e "$bin/filedrawer.previous" ]]; then
  mv -f "$bin/filedrawer.previous" "$bin/filedrawer" || problems+=("couldn't put the previous binary back")
else
  problems+=("there is no previous binary, so the new one stays")
fi
systemctl start "$service" || problems+=("systemctl start failed")
summary="the new server didn't answer within ${health_seconds}s"
if (( ${#problems[@]} == 0 )); then
  summary+="; rolled back to the previous binary${copy:+ and the database as it was before ($copy)}"
else
  summary+="; rolling back: $(IFS=';'; echo "${problems[*]}" | sed 's/;/; /g')"
fi
if healthy; then
  echo "$summary. It answers now." >&2
else
  echo "$summary. It doesn't answer either: look at journalctl -u $service" >&2
fi
exit 1
