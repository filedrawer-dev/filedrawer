#!/usr/bin/env bash
# Collects the facts a security review of the server checks and the repo can't show.
# The owner runs it from their own checkout, over their own SSH as root. It changes
# no file the server keeps, runs nothing here that writes but `git fetch`, and
# prints no secret.
set -euo pipefail

usage() {
  cat <<'EOF'
usage: ops/audit-vps > REPORT

Prints a report of the server's state for a security review. It changes no file
the server keeps: what it leaves there are log lines, a PAM session for each
command it runs as another user and sudo's own for each `sudo -l`, and ufw's lock
file in /run. Here it runs `git fetch origin`, and nothing else that writes.

From the server, in one ssh round as root (ops/remote/audit-facts.sh): the Debian
and kernel versions and whether a reboot is due; listening sockets; ufw's and
nftables' rules; which user reaches Caddy's admin API, on loopback's port 2019 and
on its socket, and each environment's port on loopback; sshd's effective settings,
for anyone and for root and deploy;
authorized_keys lines without their keys; users with a shell; the sudo rules; owner
and mode of the secrets, databases, binaries and backups; the SHA-256, owner and
mode of each unit and config the repo's scripts generate that holds no secret;
whether each service user can read the other environment; Caddy's version, holds
and global options; each unit's hardening settings and `systemd-analyze security`;
failed units and timers; pending upgrades and unattended-upgrades' log; the
journal's size and settings.

From this checkout, after `git fetch origin`: whether each script the server keeps
a root-owned copy of (filedrawer-install, filedrawer-backup, caddy-upgrade-check,
the filedrawer-alerts.sh it sources, filedrawer-receive) is origin/main's
(`current`), an older revision's (`behind`, with the commit), or no revision's
(`MATCHES NO REVISION`: a hand edit, or tampering); the Caddy version bin/caddy
pins; and the names and mode of what ops/.vps.env holds.

No secret is printed: of an env file only its key names, of a Caddy site file only
its owner and mode, of a process only its user and name. Read the report before
you pass it on all the same: it names users, paths and package versions.

Not covered: the generated units and configs are hashed but not compared with the
repo, which holds the scripts that write them, not the files; compare one report's
hashes with the last one's. The env files and Caddy's site files hold secrets, so
they aren't hashed either. `reboot-required` covers kernel packages only, as Debian
writes it. The VPS provider's backups and firewall can only be read in its console.

Needs VPS_HOST in ops/.vps.env, as ops/provision-vps writes it.
EOF
}

case "${1:-}" in
  -h | --help) usage; exit 0 ;;
esac
(( $# == 0 )) || { usage >&2; exit 2; }

# The overrides are for tests.
ops_dir="${FILEDRAWER_OPS_DIR:-$(dirname "$0")}"
remote_dir="$(dirname "$0")/remote"
repo="${FILEDRAWER_REPO:-$(git -C "$(dirname "$0")" rev-parse --show-toplevel)}"

die() {
  echo "audit-vps: $*" >&2
  exit 1
}
setting() {
  [[ -r "$ops_dir/.vps.env" ]] && sed -n "s/^$1='\(.*\)'\$/\1/p" "$ops_dir/.vps.env" | sed -n 1p
}
in_repo() { git -C "$repo" "$@"; }

vps_host=$(setting VPS_HOST) || true
[[ -n "$vps_host" ]] || die "no VPS_HOST in $ops_dir/.vps.env; ops/provision-vps writes it"
in_repo fetch -q origin || die "git fetch origin failed"

facts=$(ssh -o BatchMode=yes "root@$vps_host" "bash -s" < "$remote_dir/audit-facts.sh") ||
  die "ssh root@$vps_host failed"

# drift NAME HASH: how the server's copy of ops/remote/NAME stands against
# origin/main.
drift() {
  local hash="$2" path="ops/remote/$1" commit
  if [[ "$hash" == none ]]; then
    echo "absent from the server"
    return
  fi
  while read -r commit; do
    if [[ "$(in_repo show "$commit:$path" 2>/dev/null | sha256sum | cut -d' ' -f1)" == "$hash" ]]; then
      if [[ "$(in_repo rev-list -1 origin/main -- "$path")" == "$commit" ]]; then
        echo "current"
      else
        echo "behind: origin/main's as of $(in_repo log -1 --format='%h (%cs)' "$commit")"
      fi
      return
    fi
  done < <(in_repo rev-list origin/main -- "$path")
  echo "MATCHES NO REVISION on origin/main"
}

echo "audit-vps report"
echo "taken: $(date -u +%FT%TZ)"
echo "origin/main: $(in_repo rev-parse origin/main)"
echo "$facts"

printf '\n== drift from origin/main ==\n'
# Only the facts' "installed scripts" are compared: the facts also hash the units
# and configs the repo's scripts generate, which no revision holds.
while read -r _ path hash; do
  echo "$path: $(drift "$(basename "$path")" "$hash")"
done < <(sed -n '/^== installed scripts ==$/,/^== /p' <<< "$facts" | grep '^sha256 ' || true)
printf 'Caddy pinned by bin/caddy on origin/main: %s\n' \
  "$(in_repo show origin/main:bin/caddy 2>/dev/null | sed -n 's/^VERSION = "\(.*\)"$/\1/p')"

printf '\n== ops/.vps.env on this machine: mode and names, never values ==\n'
if [[ -e "$ops_dir/.vps.env" ]]; then
  stat -c '%U:%G %a' "$ops_dir/.vps.env"
  sed -n "s/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p" "$ops_dir/.vps.env" | paste -sd' ' -
fi
