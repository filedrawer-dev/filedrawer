#!/usr/bin/env bash
# Starts a release of the `filedrawer` command (design.md, Distribution): a run of
# .github/workflows/release-cli.yml on main, which publishes main's version to each
# of crates.io, PyPI and npm that lacks it.
#
# Usage: ops/release-cli [VERSION]     (logged in to gh, from anywhere)
#
# Run it once the version bump is on main and CI's check job has passed on it: the
# run's gate fails until then, saying to wait, and you run this again. VERSION, as
# main's crates/cli/Cargo.toml has it, makes the run refuse if main has another.
# It is `gh workflow run release-cli.yml --repo filedrawer-dev/filedrawer --ref main`,
# with `-f version=VERSION` when given.

set -euo pipefail

REPO="filedrawer-dev/filedrawer"

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  sed -n '2,/^$/s/^# \{0,1\}//p' "$0"
  exit 0
fi
if (( $# > 1 )) || [[ $# == 1 && ! $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "usage: ops/release-cli [X.Y.Z]" >&2
  exit 2
fi

gh workflow run release-cli.yml --repo "$REPO" --ref main ${1:+-f "version=$1"}
echo "Started. Watch it at https://github.com/$REPO/actions/workflows/release-cli.yml"
