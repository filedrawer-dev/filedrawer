#!/usr/bin/env bash
# shellcheck disable=SC2034,SC2329  # the parts it sources read these settings and call these wrappers

# Provisions the File Drawer VPS from your own machine, over your own SSH key
# (design.md, Hosting and operations). Run it from the repo root: ops/provision-vps
# It saves the host name and basic-auth user in ops/.vps.env (git-ignored); the
# password is never saved. Every remote step is a script in ops/remote/ that is safe
# to rerun, so rerunning the wizard repairs a half-finished setup.
# `ops/provision-vps smoke` runs only the last stage, CI's two accounts (the smoke
# test's and the screen check's) and their secrets, on a server the full wizard has
# set up; `ops/provision-vps screening` only staging's API key and cap;
# `ops/provision-vps github` only the GitHub token the link checks use;
# `ops/provision-vps caddy-upgrades` only the guard on the server's Caddy (#100),
# which production's run also sets up; `ops/provision-vps reboots` only the reboots
# for new kernels, with notice, which production's run also sets up; and
# `ops/provision-vps admin` only making your staging account the admin; and
# `ops/provision-vps mail` only staging's Purelymail sender.
# A rerun asks for nothing ops/.vps.env, the server or GitHub already holds (#112):
# a secret the server holds is kept, sent empty so its remote script keeps its copy
# and still brings its new logic, and only a stage that asks something pauses.
# `--ask-all` before the rest asks everything again: Enter keeps a saved value, and
# for each secret the server holds it asks "Change ...? [y/N]" before any tab.
# `--only-new`, the old name for a rerun, is still taken.
# `ops/provision-vps production` sets up production beside staging, on a server the
# staging wizard has set up; `production mail`, `production screening` and
# `production pings` run one of its stages alone; and
# `ops/provision-vps production account`, after the first production deploy (#42),
# makes your production account the admin and sets up the uptime check.
# A run that restarts a service (the whole wizard, production's and its mail,
# screening and pings stages, and the smoke, screening, github and mail stages) ends
# by probing that environment's way out as its server would (#102), and lists what
# it couldn't reach.
#
# Its parts are in ops/provision-vps.d/, each read in its own order: library.sh, the
# /wizard skill's library, not hand-edited; helpers.sh, for running scripts on the
# server and keeping and checking its secrets; staging.sh and production.sh, each
# environment's stages in the order they run. This file holds the flags and the
# run order. Every part is read before the first prompt, so editing one mid-run
# can't break the run.

set -euo pipefail

here="$(dirname "${BASH_SOURCE[0]}")"
parts="$here/provision-vps.d"
for part in library helpers staging production; do
  # shellcheck source=/dev/null
  source "$parts/$part.sh"
done

run_wizard() {
TOTAL_STAGES=13
ENV_FILE="ops/.vps.env"
REMOTE="$here/remote"
[[ -d "$REMOTE" ]] || { echo "run this from the repo: $REMOTE is missing" >&2; exit 1; }

# A rerun keeps what's set up (#112): a prompt whose value ops/.vps.env holds takes
# it, a secret the server holds is kept (keep_secret), and a pause waits only in a
# stage that asked something or opened a tab. --ask-all asks everything again.
# --only-new, the old name for the default, is taken and changes nothing.
ASK_ALL=0
case "${1:-}" in
  --ask-all) ASK_ALL=1; shift ;;
  --only-new) shift ;;
esac
if (( ! ASK_ALL )); then
  # The library, provision-vps.d/library.sh, isn't hand-edited, so its functions are
  # copied as library_<name> and wrapped here. STAGE_ASKED records whether the
  # current stage asked the owner anything or opened a tab, so its pause waits; a
  # first run, with nothing saved yet, waits at the banner too.
  STAGE_ASKED=0
  [[ -n "$(_existing VPS_HOST || true)" ]] || STAGE_ASKED=1
  eval "library_$(declare -f stage)"
  stage() { STAGE_ASKED=0; library_stage "$@"; }
  for wrapped in ask_secret confirm open_url pause; do
    eval "library_$(declare -f "$wrapped")"
  done
  ask_secret() { STAGE_ASKED=1; library_ask_secret "$@"; }
  confirm() { STAGE_ASKED=1; library_confirm "$@"; }
  open_url() { STAGE_ASKED=1; library_open_url "$@"; }
  pause() { (( ! STAGE_ASKED )) || library_pause "$@"; }
  eval "library_$(declare -f ask)"
  ask() {
    local saved
    saved=$(_existing "$1" || true)
    if [[ -z "$saved" ]]; then
      STAGE_ASKED=1
      library_ask "$@"
      return
    fi
    printf -v "$1" '%s' "$saved"
    note "$2 $saved (saved)"
  }
fi

case "${1:-}" in
  "") ;;
  production)
    shift
    production "$@"
    return 0 ;;
  smoke | screening | admin | github | caddy-upgrades | reboots | mail)
    TOTAL_STAGES=1
    need_vps_host
    "${1//-/_}_stage"
    # The stages that restart staging's service.
    case "$1" in smoke | screening | github | mail) outbound_check staging ;; esac
    finish
    return 0 ;;
  *)
    # A typo would otherwise run the whole staging setup.
    warn "ops/provision-vps doesn't know '$1'. It takes, after an optional --ask-all:"
    warn "  nothing (staging's setup), production [account, mail, screening or pings],"
    warn "  or one stage alone: smoke, screening, admin, github, caddy-upgrades, reboots"
    warn "  or mail."
    exit 2 ;;
esac

banner "File Drawer VPS: staging setup"
staging_preflight_stage
staging_dns_stage
base_system_stage
service_user_stage
staging_service_stage
staging_caddy_stage
mail_stage
deploy_key_stage
staging_check_stage
screening_stage
github_stage
admin_stage
smoke_stage
outbound_check staging
finish
}

# Tests source the parts without running the wizard.
[[ "${PROVISION_VPS_SOURCE_ONLY:-}" == 1 ]] && return 0
run_wizard "$@"; exit
