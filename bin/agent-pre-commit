#!/bin/sh
# The full check: the tests and clippy, the steps that follow the pre-commit hooks
# (cargo fmt is one of those). wt-ship runs it, through llm-toolbox's
# agent-commit-gate, on the tip of each landing; at an agent's commit the gate runs
# bin/agent-commit-check in its place, and only an agent without the gate runs this
# from bin/git-pre-commit. CI runs it directly.
# The checks run on what's staged: a copy of the index, so unstaged changes can neither
# fail a commit nor rescue it. The copy is one folder per worktree,
# $TMPDIR/filedrawer-check-<hash of the worktree's path>/tree, which each run brings to
# the index with a private index of its own beside it: it rewrites only the files whose
# contents or mode changed and deletes every other file, so cargo finds the rest where
# it built them, with their mtimes, and rebuilds only what changed (#136; a new folder
# each run rebuilt the workspace crates, about 70 s a check). It lies outside the repo,
# since tools that search parent folders for their settings would find the worktree's:
# sqlx's macros its .env, which names a database, and clippy its clippy.toml. A run
# holds the folder's lock throughout and waits, saying so, while another check of the
# worktree holds it; it takes it in an outer shell and runs itself again without the
# lock's fd, since a process a check leaves running, such as the sccache server, would
# otherwise hold it. Each run first removes the folders of worktrees that are gone,
# such as those wt-ship landed, unless their lock is held. Each check's output shows
# only when it fails. They run one after the other.
# The cargo checks build elsewhere: in the check slot, one tree and its own target for
# the whole repo on this machine, which every worktree's checks share (#146). Two trees
# on one target leak builds into each other, since cargo calls a unit fresh when no
# source is newer than its last build, whichever tree ran it: a check could pass on
# unstaged code the worktree had built, and a worktree's build after a check kept the
# check's copy of the files a crate embeds from outside its folder (skills/,
# docs/entry-format.md), which cargo tracks by absolute path. The slot's tree, like the
# folder, is brought to the index through a private index, so only read-tree writes it
# and every change of contents gets a new mtime, which is all cargo's rule needs; at one
# path it keeps the incremental cache, and it stays warm across worktrees, so a check
# rebuilds what differs from the last one. It is $FILEDRAWER_CHECK_SLOT when set (CI
# sets it beside its checkout); else cache/<repo>/check-slot-<machine> beside the main
# tree when the workspace has a cache/ there (on the host disk; no parent holds a .env
# or clippy.toml); else $TMPDIR/filedrawer-slot-<hash of the common git dir>. The
# checks never see the variable. A run takes the slot's lock (its own file, fd 8) only
# for the cargo block, after the queue exit, so a check that builds nothing never
# touches it; one that waits says who holds it, its wait is timed as slot-wait, and the
# cargo commands run without the fd, as above. Cargo deletes no old build, so once a day
# a slot whose target passes 20 GB starts over, and that check builds cold. A cargo
# failure names the slot and how to reset it: --reset-slot empties it once no check
# holds it, keeping its lock file, which deleting the folder by hand would replace
# under a running check.
# bin/tests, the tests of the hook scripts, run through bin/pytest, uvx with a
# pinned pytest and the plugins bin/tests/pytest.ini uses, so the host needs no venv.
# Commits and wt-ship's landing checks run the copy of this script in the tree they
# check, through the link
# .githooks/agent-pre-commit, so a commit that changes it, such as for a new plugin, is
# checked by its own version. The Rust checks wait for Cargo.toml, and build in the
# slot. The tests run under cargo-nextest, which prints
# only the failures and a summary (.config/nextest.toml); it skips doctests, so cargo
# test --doc runs those. nextest builds first, apart from the run, and each check's
# seconds go to the file $CHECK_TIMINGS names, when agent-commit-gate names one: the
# gate shows them in its pass line and keeps them in .git/agent-check-timings.tsv.
# Each check runs only when the change needs it: the Rust checks for a build input,
# bin/tests for what those tests read, and of bin/tests only the test files that reach
# the change, as bin/checks-needed --bin-tests picks them, else the whole suite. The
# change is what the index holds against
# $CHECK_BASE, which llm-toolbox's agent-commit-gate sets to the nearest commit whose
# tree passed this script, or for --quick at a commit, either this or the commit check
# (`agent-commit-gate -h`): at a commit, usually HEAD, so the
# staged paths; on wt-ship's recheck, the commit before, or the tip the rebase put this
# one on. The staged copy of bin/checks-needed decides (its -h lists
# the rules). Every check runs without CHECK_BASE (CI, an agent without llm-toolbox,
# no commit known to pass), when nothing differs from it, when the change touches
# these rules, when git can't diff against it, and when bin/checks-needed is missing,
# fails or runs past 60 s. agent-commit-gate keeps the record of passed trees; this
# script keeps none.
# --warm, which bin/new-worktree starts in a new tree while the slot is cold, brings
# the slot to the index and builds there what the checks build, the tests and clippy,
# and exits with the first failure's status; when another check holds the slot, it
# skips, since that check warms it. It checks nothing, so it ignores CHECK_BASE and
# never asks for heavy's queue, which its caller is in; when the slot was built since
# bin/new-worktree asked, it builds nothing. --slot-cold prints the slot's path and
# exits 0 when it holds no build yet, else 1.
# --quick runs clippy alone, for bin/agent-quick-check and bin/agent-commit-check, and
# --quick --routes, for the second, also the routes test when the router or a document
# naming routes changed (bin/checks-needed's `routes`), so a new route nobody named
# for agents or listed in NOT_FOR_AGENTS fails at its commit, and for a skill change
# the skill_folders tests in the same run; the
# gate gives each a CHECK_BASE of its own (`agent-commit-gate -h`). --rules, which the
# commit check also passes, runs the rule tests that read sources when a path they
# read changed. For a path under bin/tests (bin/checks-needed's `py-rules`):
# bin/tests/test_no_wall_clock_limits.py, since a test with a wall-clock limit
# otherwise passes its commit and fails only the full check, and
# bin/tests/test_checks_needed.py, since a test that began to read skills/ changed
# which checks a skills edit needs and failed that table only when it landed. For a
# path in bin/, ops/ or .github/workflows (`sh-rules`):
# bin/tests/test_no_early_exit_readers.py, since a script's pipe into `grep -q` passed
# its commit and only a review found it, bin/tests/test_workflow_run_blocks.py,
# since parsing in a workflow's YAML passed its commit and a review sent it back, and
# bin/tests/test_workflow_supply_chain.py, since an action named by a tag, or a
# cache in a job that builds what ships, would pass a workflow's commit too. None
# needs a build and each takes seconds, so, like the skills check, they run outside
# heavy's queue. So does --mods, which the commit check passes too: bin/test-modules, when a
# path in a crate's tests/it changed (bin/checks-needed's `test-mods`), since a test
# file with no `mod` line in tests/it/main.rs compiles nowhere and clippy passes it;
# only the full check's nextest would fail. --caddy, which the commit check passes
# too, runs the bin tests marked real_caddy when ops/remote/caddy.sh,
# ops/remote/field-test-key.sh, bin/caddy, a file holding those tests or conftest.py
# changed (bin/checks-needed's `caddy`); they run Caddy, so they wait in heavy's
# queue. Both modes first
# run the skills check, bin/skills sync --check, which needs no build and runs outside
# heavy's queue. It is the one check that reaches the repo: it fetches origin's main
# and skill tags into it, writing only those refs.
# Every other check here is a build or a test suite, so none may start outside heavy's
# queue.
# The gate runs this script first outside it when the file names $CHECK_QUEUE_EXIT, as
# here, with that variable set (`agent-commit-gate -h`). Each check's block then starts
# with queue_first, which says why and exits with that code, and the gate runs the
# script again in the queue. A change that needs no check, such as a docs-only one,
# passes without waiting behind other sessions' builds. When what it would queue takes
# seconds, it exits with $CHECK_SECONDS_EXIT instead, which the gate sets beside it,
# and the gate runs it again as heavy runs a --few-seconds job: at once beside the
# lane's holder, niced, on quiet cores, else from the queue's front (#155). Seconds,
# under 40 s in #148's record, means a commit's or a small fix's check (--quick) that
# runs the real-Caddy tests alone, or clippy alone, without the routes test, on a
# (rust-toolchain.toml, Cargo.lock) pair the slot has built clippy for: a list in the
# slot's target, which a passing clippy there adds to, and which goes when the target
# starts over. A first build under a new toolchain or lock took 44 to 77 s; any other
# clippy since the slot, 7 to 34 s, whatever else differed. A value of either variable
# other than an exit status from 1 to 255 counts as unset: sh keeps only the low 8
# bits, so 256 would exit 0.
set -e
quick=
warm=
slot_cold=
reset_slot=
routes=
rules=
mods=
caddy=
for arg in "$@"; do
  case "$arg" in
    --quick) quick=1 ;;
    --warm) warm=1 ;;
    --slot-cold) slot_cold=1 ;;
    --reset-slot) reset_slot=1 ;;
    --routes) routes=1 ;;
    --rules) rules=1 ;;
    --mods) mods=1 ;;
    --caddy) caddy=1 ;;
  esac
done
repo=$(git rev-parse --show-toplevel)
tmp=${TMPDIR:-/tmp}
state="$tmp/filedrawer-check-$(printf %s "$repo" | sha256sum | cut -c1-16)"
gitdir=$(git -C "$repo" rev-parse --absolute-git-dir)
# The check slot, one per repo and machine, where every cargo check builds (#146).
common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)
main=$(dirname "$common")
if [ -n "${FILEDRAWER_CHECK_SLOT:-}" ]; then
  slot=$FILEDRAWER_CHECK_SLOT
elif [ -d "$(dirname "$main")/cache" ]; then
  slot="$(dirname "$main")/cache/$(basename "$main")/check-slot-$(uname -n)"
else
  slot="$tmp/filedrawer-slot-$(printf %s "$common" | sha256sum | cut -c1-16)"
fi
# Bring the slot's tree to the tree $1, through the slot's own index, as the
# per-worktree folder is brought below. Run it holding the slot's lock (fd 8).
sync_slot() {
  mkdir -p "$slot/tree"
  rm -f "$slot/index.lock"
  GIT_INDEX_FILE="$slot/index" git --git-dir="$gitdir" --work-tree="$slot/tree" \
    read-tree --reset -u "$1"
  GIT_INDEX_FILE="$slot/index" git --git-dir="$gitdir" --work-tree="$slot/tree" \
    clean -ffdxq
}
# Cargo as the checks run it in the slot: without the slot's lock (fd 8), which a
# process it leaves running, such as the sccache server, would otherwise hold.
slot_cargo() { cargo "$@" 8>&-; }
# Open the slot's lock as fd 8, unlocked.
open_slot() {
  mkdir -p "$slot"
  exec 8>"$slot/lock"
}
# Holding the lock: record who holds it, bring the slot to the tree $1, and work
# there, cargo building into the slot's target.
enter_slot() {
  printf '%s %s\n' "$$" "$repo" >"$slot/holder"
  sync_slot "$1"
  export CARGO_TARGET_DIR="$slot/target"
  cd "$slot/tree"
}
# The (rust-toolchain.toml, Cargo.lock) pair of the tree in the current folder, as the
# slot's list of the pairs it built clippy for keeps it: the start of each file's
# hash, or `none`. The list lives in the slot's target, so a target that starts over
# forgets it.
build_pair() {
  for file in rust-toolchain.toml Cargo.lock; do
    if [ -f "$file" ]; then
      sha256sum <"$file" | cut -c1-16
    else
      echo none
    fi
  done | tr '\n' ' '
}
built_pairs() { echo "$slot/target/check-pairs"; }
# Add this tree's pair to the list, once clippy passed on it in the slot, which made
# the target. A list that can't be written only costs a later check its seconds.
remember_pair() {
  [ -d "$slot/target" ] || return 0
  pair=$(build_pair)
  grep -qxF "$pair" "$(built_pairs)" 2>/dev/null ||
    printf '%s\n' "$pair" >>"$(built_pairs)" || :
}
# --reset-slot empties the slot, once no check holds it; its lock file stays, so a
# check that waits for it keeps the same lock.
if [ -n "$reset_slot" ]; then
  open_slot
  if ! flock -n 8; then
    echo "agent-pre-commit: --reset-slot waits for the check that holds the check slot $slot" >&2
    flock 8
  fi
  find "$slot" -mindepth 1 -maxdepth 1 ! -name lock -exec rm -rf {} +
  echo "agent-pre-commit: emptied the check slot $slot; the next check builds it cold" >&2
  exit 0
fi
if [ -n "${slot_cold:-}" ]; then
  echo "$slot"
  if [ -d "$slot/target/debug" ]; then
    exit 1
  fi
  exit 0
fi
# --warm builds in the slot what the checks build there, unless another check holds
# it, whose build warms it as well.
if [ -n "$warm" ]; then
  open_slot
  if ! flock -n 8; then
    echo "agent-pre-commit: --warm skips: another check holds the check slot $slot and warms it" >&2
    exit 0
  fi
  # Another check may have built it since bin/new-worktree asked.
  if [ -d "$slot/target/debug" ]; then
    echo "agent-pre-commit: --warm builds nothing: the check slot $slot is warm" >&2
    exit 0
  fi
  enter_slot "$(git -C "$repo" write-tree)"
  slot_cargo nextest run --cargo-quiet --no-run || exit
  slot_cargo clippy --quiet --all-targets -- -D warnings || exit
  remember_pair
  exit 0
fi
if [ -z "${AGENT_PRE_COMMIT_LOCKED:-}" ]; then
  for old in "$tmp"/filedrawer-check-*; do
    if [ "$old" != "$state" ] && [ -f "$old/worktree" ] && [ ! -d "$(cat "$old/worktree")" ]; then
      (flock -n 8 && rm -rf "$old") 8>"$old/lock" || :
    fi
  done
  mkdir -p "$state"
  printf '%s\n' "$repo" >"$state/worktree"
  exec 9>"$state/lock"
  if ! flock -n 9; then
    echo "agent-pre-commit: waits for another check of this worktree to finish" >&2
    flock 9
  fi
  AGENT_PRE_COMMIT_LOCKED=1 sh "$0" "$@" 9>&-
  exit
fi
unset AGENT_PRE_COMMIT_LOCKED
tree="$state/tree"
logs=$(mktemp -d)
trap 'rm -rf "$logs"' EXIT
trap 'exit 130' INT TERM HUP
# The tree the index holds, then the folder brought to it through its own index, whose
# stat data lets read-tree rewrite only the files that differ. A lock file a killed
# run left would stop every later one, and this run holds the folder's lock.
staged=$(git -C "$repo" write-tree)
in_tree() {
  GIT_INDEX_FILE="$state/index" git --git-dir="$gitdir" --work-tree="$tree" "$@"
}
mkdir -p "$tree"
rm -f "$state/index.lock"
in_tree read-tree --reset -u "$staged"
in_tree clean -ffdxq
need_every_check() {
  for check in rust bin-tests skills routes py-rules sh-rules test-mods caddy; do
    echo "$check $1"
  done >"$logs/needed"
}
# Before the git variables go, since `git commit PATHS` stages into its own index.
if [ -z "${CHECK_BASE:-}" ]; then
  need_every_check "(no CHECK_BASE, so no commit known to pass)"
elif ! git -C "$repo" diff --cached -z --name-only --no-renames "$CHECK_BASE" -- >"$logs/changed"; then
  echo "agent-pre-commit: git can't diff against CHECK_BASE $CHECK_BASE, so every check runs" >&2
  need_every_check "(git can't diff against CHECK_BASE)"
elif tr '\0' '\n' <"$logs/changed" | grep -qxE 'bin/(checks-needed|agent-pre-commit|agent-quick-check|agent-commit-check)'; then
  need_every_check "(the change touches these rules)"
elif [ ! -x "$tree/bin/checks-needed" ]; then
  need_every_check "(no bin/checks-needed staged)"
elif ! timeout 60 "$tree/bin/checks-needed" --bin-tests "$logs/bin-tests" "$tree" \
  <"$logs/changed" >"$logs/needed" 2>"$logs/scope"; then
  rm -f "$logs/bin-tests"
  cat "$logs/scope" >&2
  echo "agent-pre-commit: bin/checks-needed failed, so every check runs" >&2
  need_every_check "(bin/checks-needed failed)"
fi
needs() { grep -q "^$1 " "$logs/needed"; }
queue_exit=${CHECK_QUEUE_EXIT:-}
seconds_exit=${CHECK_SECONDS_EXIT:-}
# Whether $1 is an exit status from 1 to 255.
exit_status() {
  case "$1" in '' | *[!0-9]* | 0*) return 1 ;; esac
  [ "$1" -le 255 ]
}
queue_first() {
  exit_status "$queue_exit" || return 0
  if exit_status "$seconds_exit" && queued_seconds; then
    echo "agent-pre-commit: needs heavy's queue, for seconds, for $(grep "^$1 " "$logs/needed")" >&2
    exit "$seconds_exit"
  fi
  echo "agent-pre-commit: needs heavy's queue for $(grep "^$1 " "$logs/needed")" >&2
  exit "$queue_exit"
}
# Whether what this run would queue takes seconds, under 40 s in #148's record: at a
# commit (--quick), the real-Caddy tests alone (21 to 29 s), or clippy alone without
# the routes test (12 to 73 s on its own) on a pair the slot has built clippy for. A
# first build under a new toolchain or lock took 44 to 77 s; every other clippy since
# the slot took 7 to 34 s, `.sqlx/` and other build inputs changed or not.
queued_seconds() {
  [ -n "$quick" ] || return 1
  will_caddy=
  if [ -n "$caddy" ] && needs caddy && [ -x bin/pytest ]; then will_caddy=1; fi
  if [ -f Cargo.toml ] && needs rust; then
    [ -z "$will_caddy" ] || return 1
    if [ -n "$routes" ] && needs routes && [ -f crates/server/Cargo.toml ]; then
      return 1
    fi
    grep -qxF "$(build_pair)" "$(built_pairs)" 2>/dev/null
    return
  fi
  [ -n "$will_caddy" ]
}
cd "$tree"
# The hook's git variables, and CHECK_BASE, name the repo being committed; no check
# should reach it.
# The timings file is this run's alone: a check it starts, such as the bin tests that
# run this hook on fakes, would write its own there.
timings_file=${CHECK_TIMINGS:-}
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_PREFIX CHECK_BASE CHECK_QUEUE_EXIT CHECK_SECONDS_EXIT CHECK_TIMINGS FILEDRAWER_CHECK_SLOT
failed=0
# Run CMD, then write its seconds, to the millisecond, as `NAME SECONDS` to the file
# CHECK_TIMINGS names, which agent-commit-gate hands each check, shows in its pass line
# and keeps on its record (`agent-commit-gate -h`); without it, just run CMD.
timed() {
  timed_name=$1
  shift
  timed_start=$(date +%s%N)
  timed_status=0
  "$@" || timed_status=$?
  if [ -n "$timings_file" ]; then
    timed_ms=$((($(date +%s%N) - timed_start) / 1000000))
    printf '%s %d.%03d\n' "$timed_name" $((timed_ms / 1000)) $((timed_ms % 1000)) \
      >>"$timings_file" || :
  fi
  return "$timed_status"
}
# shellcheck disable=SC2329  # timed runs it
skills_check() { (cd "$repo" && "$tree/bin/skills" sync --check --root "$tree"); }
# The skills' record against origin's tags, in both modes and before any queue exit,
# since it needs no build: its failure ends the run at once rather than after a queued
# build. It runs from the repo, whose tags and origin/main it fetches, on the staged
# copy. Exit 2 means it couldn't check, as a tree whose bin/skills predates --check
# answers, so it warns and goes on.
if needs skills && [ -x bin/skills ]; then
  if timed skills skills_check >"$logs/skills" 2>&1; then
    :
  else
    status=$?
    cat "$logs/skills"
    if [ "$status" -eq 1 ]; then
      exit 1
    fi
    echo "agent-pre-commit: couldn't check the skills (bin/skills exit $status), so that check was skipped" >&2
  fi
fi
# Outside the queue, as the skills check is, and each in seconds: for py-rules, an
# ast read of bin/tests' sources and, when the tree has it, the table of which checks
# a path needs, which a bin test's new read of a repo folder changes; for sh-rules,
# the scripts' early-exit pipes, the workflows' run blocks and the actions they name.
if [ -n "$rules" ] && [ -x bin/pytest ]; then
  names=
  needs py-rules && names="no_wall_clock_limits checks_needed"
  needs sh-rules && names="$names no_early_exit_readers workflow_run_blocks workflow_supply_chain"
  rule_tests=
  # Those the tree has: one checked out at an older commit lacks the newer ones.
  for name in $names; do
    [ -f "bin/tests/test_$name.py" ] && rule_tests="$rule_tests bin/tests/test_$name.py"
  done
  if [ -n "$rule_tests" ]; then
    # shellcheck disable=SC2086  # paths without spaces, one word each
    timed rules bin/pytest -n0 $rule_tests >"$logs/rules" 2>&1 || { cat "$logs/rules"; failed=1; }
  fi
fi
# Outside the queue too, and in milliseconds: the staged tests/it folders and their
# main.rs. A refusal here ends the run, since the clippy that would follow passes the
# file anyway: a file with no `mod` line compiles nowhere.
if [ -n "$mods" ] && needs test-mods && [ -x bin/test-modules ]; then
  timed test-mods bin/test-modules . || exit 1
fi
# At a commit, the bin tests that run a real Caddy (conftest.py marks them real_caddy),
# when what they run changed. Without a network bin/caddy can't fetch Caddy, and they
# skip, which passes; the full check's bin-tests run holds them.
if [ -n "$caddy" ] && needs caddy && [ -x bin/pytest ]; then
  queue_first caddy
  timed caddy bin/pytest -n0 -m real_caddy bin/tests >"$logs/caddy" 2>&1 || { cat "$logs/caddy"; failed=1; }
fi
if [ -z "$quick" ] && needs bin-tests; then
  queue_first bin-tests
  # The bin test files that reach what changed, as checks-needed picked them, else
  # all of bin/tests: without a base, with every check forced, or when it failed.
  # pytest.ini's workers stay on even for three files, which then take 5 s, not 18 s.
  bin_tests=bin/tests
  if [ -s "$logs/bin-tests" ]; then
    bin_tests=$(cat "$logs/bin-tests") || bin_tests=bin/tests
  fi
  # shellcheck disable=SC2086  # paths without spaces, one word each
  timed bin-tests bin/pytest $bin_tests >"$logs/pytest" 2>&1 || { cat "$logs/pytest"; failed=1; }
fi
# The slot's lock is fd 8, from the cargo block on. A waiting check names who holds it.
# shellcheck disable=SC2329  # timed runs it
take_slot() {
  if ! flock -n 8; then
    holder=$(cat "$slot/holder" 2>/dev/null) || holder=
    case "$holder" in
      *' '*) holder="PID ${holder%% *} for ${holder#* }" ;;
      *) holder="another check" ;;
    esac
    echo "agent-pre-commit: waits for the check slot $slot, held by $holder" >&2
    flock 8
  fi
}
# Cargo deletes no old build, so the slot's target grows with every worktree's
# variants: once a day, past 20 GB, it starts over, at the cost of one cold build.
bound_slot() {
  if [ -n "$(find "$slot/size-checked" -mmin -1440 2>/dev/null)" ]; then
    return 0
  fi
  : >"$slot/size-checked"
  [ -d "$slot/target" ] || return 0
  gb=$(du -s --apparent-size --block-size=1G "$slot/target" | cut -f1)
  if [ "$gb" -gt 20 ]; then
    echo "agent-pre-commit: the check slot's target holds $gb GB, past 20, so it starts over, and this check builds cold" >&2
    rm -rf "$slot/target"
  fi
}
if [ -f Cargo.toml ] && needs rust; then
  queue_first rust
  open_slot
  timed slot-wait take_slot
  bound_slot
  enter_slot "$staged"
  cargo_failed=0
  if [ -z "$quick" ]; then
    if ! slot_cargo nextest --version >/dev/null 2>&1; then
      echo "COMMIT REFUSED: cargo-nextest is missing; install it with: cargo install cargo-nextest --locked" >&2
      exit 1
    fi
    # Built first, apart, so the timings tell compiling from running.
    if timed nextest-build slot_cargo nextest run --cargo-quiet --no-run >"$logs/build" 2>&1; then
      timed nextest slot_cargo nextest run --cargo-quiet >"$logs/test" 2>&1 || { cat "$logs/test"; cargo_failed=1; }
    else
      cat "$logs/build"
      cargo_failed=1
    fi
    timed doctest slot_cargo test --doc --quiet >"$logs/doc" 2>&1 || { cat "$logs/doc"; cargo_failed=1; }
  fi
  if timed clippy slot_cargo clippy --quiet --all-targets -- -D warnings >"$logs/clippy" 2>&1; then
    remember_pair
  else
    cat "$logs/clippy"
    cargo_failed=1
  fi
  # sqlx's own message names `cargo sqlx prepare`, which skips the database rebuild
  # this repo's refresh does. Its online and SQLX_OFFLINE messages both end so.
  if grep -q 'to update the query cache' "$logs/clippy"; then
    echo "COMMIT REFUSED: .sqlx/ is stale for a query this change adds or edits: run bin/sqlx-refresh, stage .sqlx/, and commit again." >&2
  fi
  # At a commit, the one test that a new route, unnamed for agents and unlisted in
  # NOT_FOR_AGENTS, fails, and for a skill change the skill_folders tests too, which
  # refuse a request in the wrong header form: they share the routes test's build, so
  # they cost only their runtime. The full check's nextest runs them with the rest.
  if [ -n "$routes" ] && needs routes && [ -f crates/server/Cargo.toml ]; then
    filter='test(=skill::the_documents_name_every_route_meant_for_agents)'
    if needs skills; then
      filter="$filter | test(/^skill_folders::/)"
    fi
    timed routes slot_cargo nextest run --cargo-quiet -p filedrawer-server \
      -E "$filter" >"$logs/routes" 2>&1 || { cat "$logs/routes"; cargo_failed=1; }
  fi
  if [ "$cargo_failed" -ne 0 ]; then
    failed=1
    echo "agent-pre-commit: the cargo checks ran in the check slot $slot; if a failure looks like the slot's own, such as a missing file, run bin/agent-pre-commit --reset-slot and commit again: the next check rebuilds it" >&2
  fi
fi
exit $failed
