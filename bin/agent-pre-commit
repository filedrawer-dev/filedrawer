#!/bin/sh
# The full check: the tests and clippy, the steps that follow the pre-commit hooks
# (cargo fmt is one of those). wt-ship runs it, through llm-toolbox's
# agent-commit-gate, on each commit when it lands; at an agent's commit the gate runs
# bin/agent-commit-check in its place, and only an agent without the gate runs this
# from bin/git-pre-commit. CI runs it directly.
# The checks run on what's staged: a copy of the index in a temporary folder, so
# unstaged changes can neither fail a commit nor rescue it. Each check's output shows
# only when it fails. They run one after the other, since cargo locks target/ anyway.
# bin/tests, the tests of the hook scripts, run through bin/pytest, uvx with a
# pinned pytest and the plugins bin/tests/pytest.ini uses, so the host needs no venv.
# Commits and wt-ship's landing checks run the copy of this script in the tree they
# check, through the link
# .githooks/agent-pre-commit, so a commit that changes it, such as for a new plugin, is
# checked by its own version. The Rust checks wait for Cargo.toml, and share the repo's
# target/ so dependencies build once. The tests run under cargo-nextest, which prints
# only the failures and a summary (.config/nextest.toml); it skips doctests, so cargo
# test --doc runs those.
# Each check runs only when the change needs it: the Rust checks for a build input,
# bin/tests for what those tests read. The change is what the index holds against
# $CHECK_BASE, which llm-toolbox's agent-commit-gate sets to the nearest commit whose
# tree passed this script, or for --quick at a commit, either this or the commit check
# (`agent-commit-gate -h`): at a commit, usually HEAD, so the
# staged paths; on wt-ship's recheck, the commit before, or the tip the rebase put this
# one on. The staged copy of bin/checks-needed decides (its -h lists
# the rules). Every check runs without CHECK_BASE (CI, an agent without llm-toolbox,
# no commit known to pass), when nothing differs from it, when the change touches
# these rules, when git can't diff against it, and when bin/checks-needed is missing,
# fails or runs past 60 s. agent-commit-gate keeps the record of passed trees; this
# script keeps none.
# --quick runs clippy alone, for bin/agent-quick-check and bin/agent-commit-check, and
# --quick --routes, for the second, also the routes test when the router or a document
# naming routes changed (bin/checks-needed's `routes`), so a new route nobody named
# for agents or listed in NOT_FOR_AGENTS fails at its commit; the
# gate gives each a CHECK_BASE of its own (`agent-commit-gate -h`). --rules, which the
# commit check also passes, runs bin/tests/test_no_wall_clock_limits.py when a path
# under bin/tests changed (bin/checks-needed's `py-rules`), since a test with a
# wall-clock limit otherwise passes its commit and fails only the full check. It reads
# the sources and takes seconds, so, like the skills check, it runs outside heavy's
# queue. So does --mods, which the commit check passes too: bin/test-modules, when a
# path in a crate's tests/it changed (bin/checks-needed's `test-mods`), since a test
# file with no `mod` line in tests/it/main.rs compiles nowhere and clippy passes it;
# only the full check's nextest would fail. Both modes first
# run the skills check, bin/skills sync --check, which needs no build and runs outside
# heavy's queue. It is the one check that reaches the repo: it fetches origin's main
# and skill tags into it, writing only those refs.
# Every other check here is a build or a test suite, so none may start outside heavy's
# queue.
# The gate runs this script first outside it when the file names $CHECK_QUEUE_EXIT, as
# here, with that variable set (`agent-commit-gate -h`). Each check's block then starts
# with queue_first, which says why and exits with that code, and the gate runs the
# script again in the queue. A change that needs no check, such as a docs-only one,
# passes without waiting behind other sessions' builds. A value other than an exit
# status from 1 to 255 counts as unset: sh keeps only the low 8 bits, so 256 would
# exit 0.
set -e
quick=
routes=
rules=
mods=
for arg in "$@"; do
  case "$arg" in
    --quick) quick=1 ;;
    --routes) routes=1 ;;
    --rules) rules=1 ;;
    --mods) mods=1 ;;
  esac
done
repo=$(git rev-parse --show-toplevel)
tree=$(mktemp -d)
logs=$(mktemp -d)
trap 'rm -rf "$tree" "$logs"' EXIT
trap 'exit 130' INT TERM HUP
git -C "$repo" checkout-index -a --prefix="$tree/"
need_every_check() {
  printf 'rust %s\nbin-tests %s\nskills %s\nroutes %s\npy-rules %s\ntest-mods %s\n' "$1" "$1" "$1" "$1" "$1" "$1" >"$logs/needed"
}
# Before the git variables go, since `git commit PATHS` stages into its own index.
if [ -z "${CHECK_BASE:-}" ]; then
  need_every_check "(no CHECK_BASE, so no commit known to pass)"
elif ! git -C "$repo" diff --cached -z --name-only --no-renames "$CHECK_BASE" -- >"$logs/changed"; then
  echo "agent-pre-commit: git can't diff against CHECK_BASE $CHECK_BASE, so every check runs" >&2
  need_every_check "(git can't diff against CHECK_BASE)"
elif tr '\0' '\n' <"$logs/changed" | grep -qxE 'bin/(checks-needed|agent-pre-commit|agent-quick-check|agent-commit-check)'; then
  need_every_check "(the change touches these rules)"
elif [ ! -x "$tree/bin/checks-needed" ]; then
  need_every_check "(no bin/checks-needed staged)"
elif ! timeout 60 "$tree/bin/checks-needed" "$tree" <"$logs/changed" >"$logs/needed" 2>"$logs/scope"; then
  cat "$logs/scope" >&2
  echo "agent-pre-commit: bin/checks-needed failed, so every check runs" >&2
  need_every_check "(bin/checks-needed failed)"
fi
needs() { grep -q "^$1 " "$logs/needed"; }
queue_exit=${CHECK_QUEUE_EXIT:-}
queue_first() {
  case "$queue_exit" in '' | *[!0-9]* | 0*) return ;; esac
  [ "$queue_exit" -le 255 ] || return 0
  echo "agent-pre-commit: needs heavy's queue for $(grep "^$1 " "$logs/needed")" >&2
  exit "$queue_exit"
}
cd "$tree"
# The hook's git variables, and CHECK_BASE, name the repo being committed; no check
# should reach it.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_PREFIX CHECK_BASE CHECK_QUEUE_EXIT
failed=0
# The skills' record against origin's tags, in both modes and before any queue exit,
# since it needs no build: its failure ends the run at once rather than after a queued
# build. It runs from the repo, whose tags and origin/main it fetches, on the staged
# copy. Exit 2 means it couldn't check, as a tree whose bin/skills predates --check
# answers, so it warns and goes on.
if needs skills && [ -x bin/skills ]; then
  if (cd "$repo" && "$tree/bin/skills" sync --check --root "$tree") >"$logs/skills" 2>&1; then
    :
  else
    status=$?
    cat "$logs/skills"
    if [ "$status" -eq 1 ]; then
      exit 1
    fi
    echo "agent-pre-commit: couldn't check the skills (bin/skills exit $status), so that check was skipped" >&2
  fi
fi
# Outside the queue, as the skills check is: an ast read of bin/tests' sources.
if [ -n "$rules" ] && needs py-rules && [ -x bin/pytest ] && [ -f bin/tests/test_no_wall_clock_limits.py ]; then
  bin/pytest -n0 bin/tests/test_no_wall_clock_limits.py >"$logs/rules" 2>&1 || { cat "$logs/rules"; failed=1; }
fi
# Outside the queue too, and in milliseconds: the staged tests/it folders and their
# main.rs. A refusal here ends the run, since the clippy that would follow passes the
# file anyway: a file with no `mod` line compiles nowhere.
if [ -n "$mods" ] && needs test-mods && [ -x bin/test-modules ]; then
  bin/test-modules . || exit 1
fi
if [ -z "$quick" ] && needs bin-tests; then
  queue_first bin-tests
  bin/pytest bin/tests >"$logs/pytest" 2>&1 || { cat "$logs/pytest"; failed=1; }
fi
if [ -f Cargo.toml ] && needs rust; then
  queue_first rust
  export CARGO_TARGET_DIR="$repo/target"
  if [ -z "$quick" ]; then
    if ! cargo nextest --version >/dev/null 2>&1; then
      echo "COMMIT REFUSED: cargo-nextest is missing; install it with: cargo install cargo-nextest --locked" >&2
      exit 1
    fi
    cargo nextest run --cargo-quiet >"$logs/test" 2>&1 || { cat "$logs/test"; failed=1; }
    cargo test --doc --quiet >"$logs/doc" 2>&1 || { cat "$logs/doc"; failed=1; }
  fi
  cargo clippy --quiet --all-targets -- -D warnings >"$logs/clippy" 2>&1 || { cat "$logs/clippy"; failed=1; }
  # At a commit, the one test that a new route, unnamed for agents and unlisted in
  # NOT_FOR_AGENTS, fails; the full check's nextest runs it with the rest.
  if [ -n "$routes" ] && needs routes && [ -f crates/server/Cargo.toml ]; then
    cargo nextest run --cargo-quiet -p filedrawer-server \
      -E 'test(=skill::the_documents_name_every_route_meant_for_agents)' >"$logs/routes" 2>&1 || { cat "$logs/routes"; failed=1; }
  fi
fi
exit $failed
