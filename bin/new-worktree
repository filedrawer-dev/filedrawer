#!/usr/bin/env python3
"""Add a worktree beside the main tree, and start its warm build in the background.

    bin/new-worktree TOPIC              ../filedrawer-wt-TOPIC, detached at the main
                                        tree's HEAD
    bin/new-worktree TOPIC --at REV     detached at REV instead, as the main tree
                                        reads it
    bin/new-worktree TOPIC --no-build   without the warm build, for a change with
                                        no build input

Run the copy in the main tree or in any worktree: it finds its repo from its own path,
and the new tree always goes beside the main tree, named for it and TOPIC (letters,
digits, `-`, `_` and `.`). An existing path is refused, and nothing is made.

The warm build is `heavy -- cargo nextest run --cargo-quiet --no-run`, started with
bgrun in the new tree, its log in the tree's target/warm.log. The script prints the
build's PID and doesn't wait: heavy's queue has no time limit. `waitone --pid PID`
waits for it.

--no-build skips it, for a change that touches no build input (AGENTS.md, Checks),
such as most of docs/, bin/ and ops/: its commits run no Rust check, so the build
only helps a tool run by hand that builds the server, such as bin/live-preview.
`bin/checks-needed --why PATH` says whether a path is a build input;
docs/entry-format.md and ops/smoke-staging are.

What it reuses from the main checkout: the dependencies it compiled that sccache
(RUSTC_WRAPPER, set by sandbox-setup) still holds in its shared cache, so the tree's
own target/ compiles little more than this workspace's crates, in about half a minute
once heavy starts it. It never shares or
links the main tree's target/: two trees on one target swap target/debug/filedrawer-server
under each other's tests. Copying it isn't worth it either: it runs to tens of GB on
a mount without copy-on-write.

The build compiles its queries against .sqlx/, with no database. After changing a
query or a migration, run bin/sqlx-refresh there (AGENTS.md, SQL).

Exit status: 0 the tree was made and its build started (or, with --no-build, the
tree was made), 2 a usage error, a refused topic or path, or git or bgrun failed.
"""

import argparse
import re
import subprocess
import sys
from pathlib import Path

TOPIC = re.compile(r"[A-Za-z0-9._-]+")
REPO = Path(__file__).resolve().parents[1]


def fail(why: str) -> int:
    print(f"new-worktree: {why}", file=sys.stderr)
    return 2


def last_line(text: str) -> str:
    """A tool's error output as one line: its last, which says what failed."""
    lines = text.strip().splitlines()
    return lines[-1] if lines else "no output"


def main_tree() -> Path:
    """The main tree of this script's repo, whichever of its trees holds the script."""
    common = subprocess.run(
        [
            "git",
            "-C",
            str(REPO),
            "rev-parse",
            "--path-format=absolute",
            "--git-common-dir",
        ],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()
    return Path(common).parent


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("topic", help="what the worktree is for, as in its name")
    parser.add_argument(
        "--at",
        default="HEAD",
        help="the commit to detach at, as the main tree reads it (default: its HEAD)",
    )
    parser.add_argument(
        "--no-build",
        action="store_true",
        help="start no warm build, for a change with no build input",
    )
    args = parser.parse_args(argv)
    if not TOPIC.fullmatch(args.topic):
        return fail(
            f"`{args.topic}` isn't a topic: use letters, digits, `-`, `_` and `.`"
        )
    try:
        primary = main_tree()
    except subprocess.CalledProcessError as error:
        return fail(f"{REPO} isn't in a git repo: {last_line(error.stderr)}")
    tree = primary.parent / f"{primary.name}-wt-{args.topic}"
    if tree.exists():
        return fail(f"{tree} exists already; pick another topic")
    added = subprocess.run(
        [
            "git",
            "-C",
            str(primary),
            "worktree",
            "add",
            "-q",
            "--detach",
            str(tree),
            args.at,
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if added.returncode != 0:
        return fail(f"git worktree add failed: {last_line(added.stderr)}")
    at = subprocess.run(
        ["git", "-C", str(tree), "log", "-1", "--format=%h %s"],
        capture_output=True,
        text=True,
        check=False,
    ).stdout.strip()
    print(f"{tree}, detached at {at}")
    if args.no_build:
        return 0
    (tree / "target").mkdir(exist_ok=True)
    log = tree / "target/warm.log"
    started = subprocess.run(
        ["bgrun", "-o", str(log), "-C", str(tree), "--", "heavy", "--"]
        + ["cargo", "nextest", "run", "--cargo-quiet", "--no-run"],
        capture_output=True,
        text=True,
        check=False,
    )
    if started.returncode != 0:
        return fail(
            f"{tree} is made, but its warm build didn't start ({last_line(started.stderr)}); "
            "build there by hand, or remove it with `git worktree remove`"
        )
    pid = started.stdout.strip().splitlines()[-1]
    print(
        f"warm build: PID {pid}, log {log}; `waitone --pid {pid}` waits for it, "
        "as the first `heavy --quick` test run should: otherwise that run builds first and "
        "overruns --quick's 60 s"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
