#!/usr/bin/env bash
# Git's pre-commit hook, run through the link .githooks/pre-commit once python3
# install.py has set core.hooksPath to .githooks; agent-pre-commit and the other checks
# are linked beside it there.
# A commit runs the quick checks in .pre-commit-config.yaml (AGENTS.md, Checks, lists
# them) through bin/pre-commit-run. The formatters write: a person's commit that
# needs formatting is refused with the files rewritten, to stage; for an agent's
# commit, bin/pre-commit-run stages what they rewrote and runs the checks again, when
# every rewritten file was staged with no unstaged changes, so it can't stage work the
# agent left out.
# Agents' commits ($AI_AGENT set) also run llm-toolbox's agent-commit-gate, told by
# AGENT_CHECK_AT_COMMIT that it runs for a commit, so it runs bin/agent-commit-check
# (clippy and the skills check) in place of agent-pre-commit; wt-ship runs
# agent-pre-commit, the tests included, on each commit when it lands.
# bin/pre-commit-run and bin/slop-lint are copies from llm-toolbox, so the hooks work
# for anyone with Python 3 and uv, on the host and in the sandbox. Every refusal ends
# with a COMMIT REFUSED line.

refuse() {
  echo "COMMIT REFUSED: $1" >&2
  exit 1
}

root=$(git rev-parse --show-toplevel)
command -v python3 >/dev/null || refuse "the hooks need python3 (and uv)"
[ -x "$root/bin/pre-commit-run" ] || refuse "no bin/pre-commit-run in $root; this checkout predates the hooks"

"$root/bin/pre-commit-run" || exit 1

if [ -n "${AI_AGENT:-}" ] && [ -z "${AGENT_PRE_COMMIT:-}" ]; then if command -v agent-commit-gate >/dev/null; then AGENT_PRE_COMMIT=1 AGENT_CHECK_AT_COMMIT=1 agent-commit-gate --run "$(dirname "$0")/agent-pre-commit" || exit; else AGENT_PRE_COMMIT=1 "$(dirname "$0")/agent-pre-commit" || { echo "COMMIT REFUSED: agent-pre-commit failed" >&2; exit 1; }; fi; fi
