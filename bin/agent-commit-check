#!/bin/sh
# The check llm-toolbox's agent-commit-gate runs for an agent's commit in place of
# agent-pre-commit, when bin/git-pre-commit's line sets AGENT_CHECK_AT_COMMIT
# (`agent-commit-gate -h`); its passes go on a record of their own, so wt-ship runs the
# full agent-pre-commit on each commit when it lands. It runs what agent-quick-check
# runs, whose comment says how; it names $CHECK_QUEUE_EXIT too, since the gate reads
# each check's own bytes for it. It adds one test, the routes test, when the router or
# a document naming routes changed, since a review found a commit whose new routes
# failed it, the wall-clock rule of bin/tests when a file there changed, since a
# review found a test with a timeout= that its commit let through, and bin/test-modules
# when a crate's tests/it changed, since a `git add -A` twice swept an unregistered
# test file into a commit that clippy passed. The other tests a change needs are the
# agent's to run before it commits.
exec "$(dirname "$0")/agent-pre-commit" --quick --routes --rules --mods
