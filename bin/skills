#!/usr/bin/env python3
"""Keep the skills in skills/ on record, and tag each new version (design.md, Skills).

    bin/skills sync                  after changing a skill or docs/entry-format.md
    bin/skills release --push-url U  in CI: tag each new version, pushing to U

sync copies docs/entry-format.md into each skill's references/. A version is frozen
once pushed, since it is then tagged or about to be: when origin/main's versions.txt
records a skill's version with another hash than its folder's, sync bumps
metadata.version, and every X-Filedrawer-Skill header the skill sends, to the next
number. Then it records each skill's version and hash. It reads origin/main as last
fetched, and needs no network.

release, for each skill at version N: when origin has the tag skill-NAME-vN, it
fetches the tag and fails unless the tag's folder equals this commit's; when origin
hasn't, it tags this commit and pushes the tag to U. Run it from the repo, on the
commit to tag.

Both work on the git repo holding the current directory.
"""

import argparse
import hashlib
import re
import subprocess
import sys
from pathlib import Path

RECORD_HEADER = """\
# Each skill's version, and its folder's hash as
# `cd skills/NAME && find . -type f | LC_ALL=C sort | xargs sha256sum | sha256sum`
# prints it. `bin/skills sync` writes this file; crates/server/tests/skill_folders.rs
# checks it.
"""


def git(root: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess:
    """git ARGS in ROOT; when CHECK, a failure ends the run with git's last line."""
    done = subprocess.run(
        ["git", *args], cwd=root, capture_output=True, text=True, check=False
    )
    if check and done.returncode != 0:
        last = done.stderr.strip().splitlines()[-1:] or [f"exit {done.returncode}"]
        sys.exit(f"git {' '.join(args)} failed: {last[0]}")
    return done


def repo_root() -> Path:
    return Path(git(Path.cwd(), "rev-parse", "--show-toplevel").stdout.strip())


def skill_names(root: Path) -> list[str]:
    return sorted(p.parent.name for p in (root / "skills").glob("*/SKILL.md"))


def folder_hash(folder: Path) -> str:
    files = sorted(
        "./" + p.relative_to(folder).as_posix()
        for p in folder.rglob("*")
        if p.is_file()
    )
    listing = "".join(
        f"{hashlib.sha256((folder / f).read_bytes()).hexdigest()}  {f}\n" for f in files
    )
    return hashlib.sha256(listing.encode()).hexdigest()


def version(skill_md: Path) -> int:
    match = re.search(r'^  version: "(\d+)"$', skill_md.read_text(), re.MULTILINE)
    if not match:
        sys.exit(f'{skill_md}: no metadata.version line, such as `  version: "1"`')
    return int(match.group(1))


def parse_record(text: str, source: str) -> dict[str, tuple[int, str]]:
    record = {}
    for line in text.splitlines():
        if line and not line.startswith("#"):
            fields = line.split()
            if len(fields) != 3 or not fields[1].isdigit():
                sys.exit(
                    f"{source}: {line!r} isn't NAME VERSION SHA256; fix it, then rerun"
                )
            record[fields[0]] = (int(fields[1]), fields[2])
    return record


def sync(root: Path) -> None:
    record_file = root / "skills/versions.txt"
    record = (
        parse_record(record_file.read_text(), "skills/versions.txt")
        if record_file.exists()
        else {}
    )
    pushed_text = git(
        root, "show", "origin/main:skills/versions.txt", check=False
    ).stdout
    pushed = parse_record(pushed_text, "origin/main:skills/versions.txt")
    format_text = (root / "docs/entry-format.md").read_bytes()
    for name in skill_names(root):
        folder = root / "skills" / name
        (folder / "references").mkdir(exist_ok=True)
        (folder / "references/entry-format.md").write_bytes(format_text)
        skill = folder / "SKILL.md"
        number = version(skill)
        text = skill.read_text()
        pushed_number, pushed_hash = pushed.get(name, (None, None))
        if pushed_number == number and pushed_hash != folder_hash(folder):
            text = text.replace(f'  version: "{number}"', f'  version: "{number + 1}"')
            text = text.replace(
                f'X-Filedrawer-Skill: {name}/{number}"',
                f'X-Filedrawer-Skill: {name}/{number + 1}"',
            )
            skill.write_text(text)
            print(f"{name}: version {number} was pushed, so this is {number + 1}")
            number += 1
        record[name] = (number, folder_hash(folder))
    lines = "".join(
        f"{name} {n} {digest}\n" for name, (n, digest) in sorted(record.items())
    )
    record_file.write_text(RECORD_HEADER + lines)


def release(root: Path, push_url: str) -> None:
    failed = False
    for name in skill_names(root):
        number = version(root / "skills" / name / "SKILL.md")
        tag = f"skill-{name}-v{number}"
        if not tag_on_origin(root, tag):
            pushed = git(root, "push", push_url, f"HEAD:refs/tags/{tag}", check=False)
            if pushed.returncode == 0:
                print(f"tagged {tag}")
                continue
            if not tag_on_origin(root, tag):
                sys.exit(f"pushing {tag} failed:\n{pushed.stderr}")
        git(
            root,
            "fetch",
            "-q",
            "--depth=1",
            "origin",
            f"+refs/tags/{tag}:refs/tags/{tag}",
        )
        same = git(
            root,
            "diff",
            "--quiet",
            f"refs/tags/{tag}",
            "HEAD",
            "--",
            f"skills/{name}",
            check=False,
        )
        if same.returncode == 0:
            print(f"{tag} is already tagged, with this folder")
        else:
            print(
                f"{tag} is tagged with another skills/{name}: change it under a new version (bin/skills sync)",
                file=sys.stderr,
            )
            failed = True
    if failed:
        sys.exit(1)


def tag_on_origin(root: Path, tag: str) -> bool:
    return bool(
        git(root, "ls-remote", "--tags", "origin", f"refs/tags/{tag}").stdout.strip()
    )


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("sync", help="copy the format and record each skill's version")
    rel = commands.add_parser("release", help="tag each new skill version")
    rel.add_argument("--push-url", required=True, help="where to push new tags")
    args = parser.parse_args()
    root = repo_root()
    if args.command == "sync":
        sync(root)
    else:
        release(root, args.push_url)


if __name__ == "__main__":
    main()
