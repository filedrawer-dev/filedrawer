#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["jinja2==3.1.6"]
# ///
"""Preview the site's pages, and the documents agents read, live while drafting their text.

    bin/live-preview                 build the server, start it with seed entries,
                                     and serve the preview on port 8090
    bin/live-preview --no-build      start the server as last built
    bin/live-preview --upstream URL  preview against a server already running
    bin/live-preview --print PATH    print one of the documents and exit
    bin/live-preview --static OUT    write the home page to one file and exit

Askama compiles the templates into the binary, so seeing a template edit otherwise
means a rebuild that waits in heavy's queue. Here a browser's GET / is rendered on
each request from the checkout's base.html and home.html, with Jinja standing in for
askama, and the drawer of entries taken from a dev server's own home page. The
stylesheet and copy.js come from disk, at URLs that change with them, on every page.
The page reloads itself when one of the four files changes, though a save on the
host can reach the sandbox too late for that; reloading by hand always shows the
latest save.

The documents agents read come from the checkout too, on each request, whoever asks:
/skill.md from crates/server/install.md, /install.sh from crates/server/install.sh,
and /skills/NAME/FILE from skills/, each filled in for the preview's address as the
server would fill it (a test holds the two to the same text). They are served as
plain text, which a browser shows where it would download markdown, so the page
can't reload itself: reload by hand. /skill.md carries the skills' versions in X-Filedrawer-Skills, as the server's does.
The start prints a link to each. --print PATH
writes one to stdout and starts nothing, for --public-url URL when given.

--static OUT writes the home page as a browser gets it on a bare /, down to its
README card, and starts nothing: no dev server, no build. It leaves out the
drawer under the card, tabs, search box and entries, which only a server has.
The file opens from disk looking as the site does, for a screenshot (llm-toolbox's
web-shot): its stylesheet is inlined with the checkout's own font files, and
copy.js is linked from the checkout. It names https://filedrawer.dev, or
--public-url URL. It doesn't go with --print.

Every other request (other pages, forms, an agent's GET /) goes to the dev server,
signed in as its admin, so /account and /admin open in any browser with no login;
a browser that logs in itself sends its own session instead. So anyone who can reach
the preview's port, once it is published, is the admin of the dev server's data, which
is only seeded. A logout from a browser without a session of its own ends the admin's
session for every browser until the preview restarts. The other pages, such
as /account, /admin, /terms and /privacy, are the dev server's, as built: a save of
any template but home.html, or of a file in crates/server/legal/, rebuilds the
server and restarts it, which takes as long as the build, and its pages then reload
themselves. A build that fails leaves the server as it was, and says so here.

The dev server is `filedrawer-server serve` in the dev environment, built first with
`heavy --share -- cargo build --bin filedrawer-server` (plain cargo without heavy), on
127.0.0.1:SERVER_PORT, with its database in target/live-preview/. It screens with the
scripted screen (FILEDRAWER_SCREENER=scripted, `filedrawer-server -h`). A new
database is seeded with the analyzer's example fixture, ops/smoke-fixture.md and
ops/screen-eval/public/*.md, published at once, so the drawer isn't empty, and with
what fills each section of /admin: its admin, preview-admin@example.com, whose
password is PASSWORD below, entries in review, held and frozen, a series the screen
refused, entries that passed with a hazard doubt or a screening note, and the
account the hold guards. A database an older preview seeded is made again. With
--upstream nothing is seeded, rebuilt or signed in.

From the host, publish the port once, then open http://localhost:8090:

    sbx ports <sandbox name, as `hostname` prints it> --publish 8090:8090

A file the host's editor replaces by renaming a new one into place can read stale in
the sandbox (sandbox-setup's refresh-mount), so when the checkout is on a virtiofs
mount, each render drops the kernel's dentry and inode caches as refresh-mount does,
at most once every 2 s. Ctrl-C stops the preview and the dev server.

Run it without heavy, which it refuses: the preview runs until stopped, so inside a
heavy job it would hold the lane that every session's commit checks wait for.
"""

import argparse
import contextlib
import html
import http.client
import http.server
import os
import queue
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

import jinja2

REPO = Path(__file__).resolve().parents[1]

# The askama calls base.html and home.html make, with the attribute Jinja renders
# in their place.
ASKAMA_CALLS = {
    "crate::routes::assets::stylesheet_href()": "css_href",
    "crate::routes::assets::copy_script_href()": "script_href",
}

RELOAD = """<script>(function(){let v=null;setInterval(async()=>{try{
const t=await (await fetch('/__live/version',{cache:'no-store'})).text();
if(v!==null&&t!==v)location.reload();v=t;}catch(e){}},500)})();</script>"""

# Headers that describe one hop's connection or the body as sent, which the proxy
# sets itself.
HOP_HEADERS = {
    "connection",
    "keep-alive",
    "transfer-encoding",
    "content-length",
    "content-encoding",
}

# The fixtures a new database is seeded with, as git pathspecs. The first is also the
# text of the entries the review queue is seeded with.
SEED_ENTRIES = (
    ":(glob)crates/analyzer/tests/**/fixtures/example.md",
    "ops/smoke-fixture.md",
    ":(glob)ops/screen-eval/public/*.md",
)

# What `seeded` holds once seeding ends; a database seeded by an older preview, which
# wrote another or none, is made again.
SEED_VERSION = "review queue"

# The browser accounts seeding makes: the admin the preview signs every browser in as,
# and an account signed up with an invite code, which is revoked to freeze its entry.
ADMIN = ("preview-admin@example.com", "Preview Admin")
INVITED = ("preview-invited@example.com", "Preview Invitee")
PASSWORD = "live preview password"

# The markers of the dev server's scripted screen (crates/server/src/screening.rs,
# SCRIPTED_MARKERS) that seeding uses.
REVIEW, DOUBT, NOTE = "[screen: review]", "[screen: doubt]", "[screen: note]"

# The pages a template or a legal file renders, which the server compiles in: an
# edit rebuilds and restarts the dev server. home.html shows at once instead.
SERVER_PAGES = ("/account", "/admin", "/terms", "/privacy")


# The site the skills' files and the installer name, which a deployment elsewhere
# rewrites to its own address (crates/server/src/skills.rs).
PRODUCTION = "https://filedrawer.dev"


class Documents:
    """The documents agents read, /skill.md, /install.sh and each skill's files, as
    the server at `public_url` would serve the checkout's copies: the fill-in rules
    of crates/server/src/routes/docs.rs and skills.rs, copied here, which a test in
    crates/server/tests/it/skill.rs holds to the server's."""

    def __init__(self, root: Path, public_url: str) -> None:
        self.server = root / "crates/server"
        self.skills = root / "skills"
        self.public_url = public_url
        self.host = public_url.split("://", 1)[-1].split("/", 1)[0]

    def names(self) -> list[str]:
        """The skills, in the server's order."""
        return sorted(p.parent.name for p in self.skills.glob("*/SKILL.md"))

    def version(self, name: str) -> str:
        text = (self.skills / name / "SKILL.md").read_text()
        found = re.search(r'^  version: "(\d+)"$', text, re.MULTILINE)
        if found is None:
            raise ValueError(f"{name}'s SKILL.md has no metadata.version")
        return found.group(1)

    def for_site(self, text: str) -> str:
        return text.replace(PRODUCTION, self.public_url).replace(
            "/filedrawer.dev.header", f"/{self.host}.header"
        )

    def versions(self) -> list[tuple[str, str]]:
        """Each skill with its version, as /skill.md's X-Filedrawer-Skills names them."""
        return [(name, self.version(name)) for name in self.names()]

    def skill_md(self) -> str:
        versions = self.versions()
        tags = " and ".join(
            f"`https://github.com/filedrawer-dev/filedrawer/tree/skill-{name}-v{n}/skills/{name}`"
            for name, n in versions
        )
        curl = "curl -fsSL"
        if self.public_url != PRODUCTION:
            curl += (
                f' -H @"$(ls ~/.config/filedrawer/{self.host}.header 2>/dev/null'
                ' || echo /dev/null)"'
            )
        text = (self.server / "install.md").read_text()
        for placeholder, value in (
            ("{{BASE}}", self.public_url),
            ("{{HOST}}", self.host),
            ("{{SKILLS}}", " ".join(f"{name}/{n}" for name, n in versions)),
            ("{{TAG_URLS}}", tags),
            ("{{CURL}}", curl),
        ):
            text = text.replace(placeholder, value)
        return text

    def get(self, path: str) -> str | None:
        """The document at `path`, or None when it is none of them."""
        if path == "/skill.md":
            return self.skill_md()
        if path == "/install.sh":
            return self.for_site((self.server / "install.sh").read_text())
        parts = path.split("/")
        if len(parts) < 4 or parts[:2] != ["", "skills"] or ".." in parts:
            return None
        folder = self.skills / parts[2]
        file = folder.joinpath(*parts[3:])
        if not (folder / "SKILL.md").is_file() or not file.is_file():
            return None
        return self.for_site(file.read_text())

    def links(self) -> list[str]:
        """Each page a start lists: the home page, /skill.md and each skill's
        SKILL.md."""
        return [
            "/",
            "/skill.md",
            *(f"/skills/{name}/SKILL.md" for name in self.names()),
        ]


class NoRedirects(urllib.request.HTTPRedirectHandler):
    """Hands a redirect back to the browser instead of following it."""

    def redirect_request(self, *args, **kwargs):
        return None


# Loopback only: no proxy the environment names, and no redirect followed.
OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirects)


def on_virtiofs(path: Path) -> bool:
    """Whether `path` is on a virtiofs mount, as the sandbox's host mount is."""
    best, kind = "", ""
    for line in Path("/proc/mounts").read_text().splitlines():
        fields = line.split()
        point = fields[1]
        inside = str(path) == point or str(path).startswith(point.rstrip("/") + "/")
        if inside and len(point) > len(best):
            best, kind = point, fields[2]
    return kind == "virtiofs"


class Preview:
    """The checkout's home page as its templates render now, around the dev server's
    drawer, or with none (--static)."""

    def __init__(self, root: Path, upstream: str, public_url: str) -> None:
        self.templates = root / "crates/server/templates"
        self.static = root / "crates/server/static"
        self.watched = [
            self.templates / "base.html",
            self.templates / "home.html",
            self.static / "site.css",
            self.static / "copy.js",
        ]
        self.upstream = upstream
        self.public_url = public_url
        self.documents = Documents(root, public_url)
        # LIVE_PREVIEW_KEEP_CACHES, set by its tests, whose scratch folders can sit on
        # the host mount too, keeps them.
        self.drops_caches = on_virtiofs(root) and not os.environ.get(
            "LIVE_PREVIEW_KEEP_CACHES"
        )
        self.lock = threading.Lock()
        self.last_drop = 0.0
        self.folder_stamps: list[int] = []
        # The admin's session cookie, `name=value`, sent with every request a browser
        # makes without one; None previewing a server it didn't start.
        self.cookie: str | None = None
        # Set while the dev server answers; cleared while a rebuilt one starts.
        self.ready = threading.Event()
        self.ready.set()
        # How many times the dev server restarted, which pages reload on.
        self.generation = 0

    def drop_caches(self) -> None:
        """Drop the kernel's dentry and inode caches, so a file the host replaced reads
        as it is now: on a virtiofs mount only, at most once every 2 s."""
        if not self.drops_caches:
            return
        with self.lock:
            if time.monotonic() - self.last_drop < 2:
                return
            subprocess.run(
                ["sudo", "-n", "sh", "-c", "echo 2 > /proc/sys/vm/drop_caches"],
                capture_output=True,
                check=False,
            )
            self.last_drop = time.monotonic()

    def version(self) -> str:
        """What changes when a watched file does: the page polls it to reload."""
        stamps = [folder.stat().st_mtime_ns for folder in (self.templates, self.static)]
        if stamps != self.folder_stamps:
            # A file renamed into place changes its folder.
            self.folder_stamps = stamps
            self.drop_caches()
        stamps = [self.stamp(path) for path in self.watched]
        return ",".join([*stamps, str(self.generation)])

    @staticmethod
    def stamp(path: Path) -> str:
        info = path.stat()
        return f"{info.st_ino}-{info.st_mtime_ns}-{info.st_size}"

    def source(self, name: str) -> str:
        if name == "drawer.html":
            return "{{ drawer_html|safe }}"
        text = (self.templates / name).read_text()
        for call, attribute in ASKAMA_CALLS.items():
            text = re.sub(
                r"\{\{\s*" + re.escape(call) + r"\s*\}\}",
                f"{{{{ {attribute} }}}}",
                text,
            )
        return text

    def render(self, server_page: str, readme: bool) -> str:
        """The home page, from `server_page`, the dev server's own, for its drawer,
        with the README when `readme`, as the server shows it on a bare `/`."""
        self.drop_caches()
        start = server_page.index('<nav class="guides"')
        end = server_page.index('<p class="foot">')
        html = self.page(
            server_page[start:end].rstrip() + "\n",
            readme,
            f"/static/site.css?live={self.stamp(self.static / 'site.css')}",
            f"/static/copy.js?live={self.stamp(self.static / 'copy.js')}",
        )
        return html.replace("</body>", RELOAD + "\n</body>", 1)

    def static_page(self) -> str:
        """The home page with its README and no drawer, to open from disk: the
        stylesheet inlined, its fonts the checkout's files, and copy.js linked from
        the checkout, since an inline script can't be deferred."""
        self.drop_caches()
        link = '<link rel="stylesheet" href="about:stylesheet">'
        html = self.page(
            "", True, "about:stylesheet", (self.static / "copy.js").as_uri()
        )
        if link not in html:
            raise ValueError(
                f"base.html no longer links its stylesheet as {link}: change"
                " static_page in bin/live-preview to match its new tag"
            )
        css = re.sub(
            r"url\(/static/fonts/([^)]+)\)",
            lambda match: f"url({self.font_file(match.group(1)).as_uri()})",
            (self.static / "site.css").read_text(),
        )
        return html.replace(link, f"<style>\n{css}</style>", 1)

    def font_file(self, served: str) -> Path:
        """The checkout's file for the font the stylesheet names `served`: the server
        serves each under a name that carries its version (routes/assets.rs), which
        the file's name leaves out."""
        font = self.static / "fonts" / re.sub(r"-\d+(?:\.\d+)+(?=-)", "", served)
        if not font.is_file():
            raise ValueError(
                f"site.css names the font {served}, and {font} is no file: add the"
                " font, or fix its name in site.css"
            )
        return font

    def page(
        self, drawer_html: str, readme: bool, css_href: str, script_href: str
    ) -> str:
        """home.html rendered around `drawer_html`."""
        environment = jinja2.Environment(
            loader=jinja2.FunctionLoader(self.source),
            autoescape=True,
            keep_trailing_newline=True,
            undefined=jinja2.StrictUndefined,
        )
        return environment.get_template("home.html").render(
            public_url=self.public_url,
            readme=readme,
            drawer_html=drawer_html,
            css_href=css_href,
            script_href=script_href,
        )


def with_cookie(headers: dict[str, str], cookie: str) -> dict[str, str]:
    """`headers` with `cookie`, `name=value`, added unless they carry one of that
    name, so a browser's own session, once it logs in, is the one sent."""
    name = cookie.split("=", 1)[0]
    key = next((k for k in headers if k.lower() == "cookie"), "Cookie")
    sent = headers.get(key, "")
    if any(part.strip().split("=", 1)[0] == name for part in sent.split(";")):
        return headers
    return {**headers, key: f"{sent}; {cookie}" if sent else cookie}


def reloading(headers: list[tuple[str, str]], body: bytes) -> bytes:
    """`body` with the reload script, when it is an HTML page, so a page the dev server
    rendered reloads once a rebuilt one restarts."""
    kind = next((v for k, v in headers if k.lower() == "content-type"), "")
    if not kind.startswith("text/html") or b"</body>" not in body:
        return body
    return body.replace(b"</body>", RELOAD.encode() + b"\n</body>", 1)


def error_page(error: Exception) -> str:
    message = html.escape(f"{type(error).__name__}: {error}")
    return f"<!DOCTYPE html><title>Template error</title><pre>{message}</pre>{RELOAD}"


class DevServerFailed(Exception):
    """The dev server didn't start or answered seeding wrongly; its message says so
    in one line."""


class ServerDown(Exception):
    """The dev server didn't answer; its message says so in one line."""


def handler_for(preview: Preview) -> type[http.server.BaseHTTPRequestHandler]:
    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def send(
            self, status: int, headers: list[tuple[str, str]], body: bytes
        ) -> None:
            self.send_response(status)
            for key, value in headers:
                self.send_header(key, value)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)

        def reply(self, status: int, body: bytes, kind: str) -> None:
            self.send(
                status, [("Content-Type", kind), ("Cache-Control", "no-store")], body
            )

        def from_server(self) -> tuple[int, list[tuple[str, str]], bytes]:
            length = int(self.headers.get("Content-Length") or 0)
            body = self.rfile.read(length) if length else None
            headers = {
                k: v for k, v in self.headers.items() if k.lower() not in HOP_HEADERS
            }
            if preview.cookie:
                headers = with_cookie(headers, preview.cookie)
            # A rebuilt server is starting: wait for it rather than answer a 502.
            preview.ready.wait(120)
            request = urllib.request.Request(
                preview.upstream + self.path,
                data=body,
                method=self.command,
                headers=headers,
            )
            try:
                with OPENER.open(request) as answer:
                    return answer.status, list(answer.headers.items()), answer.read()
            except urllib.error.HTTPError as error:
                return error.code, list(error.headers.items()), error.read()
            except OSError as error:
                reason = getattr(error, "reason", error)
                raise ServerDown(
                    f"live-preview: the dev server at {preview.upstream} didn't answer "
                    f"({reason}); restart bin/live-preview\n"
                ) from error

        def answer(self) -> None:
            try:
                self.answer_from_server()
            except ServerDown as down:
                self.reply(502, str(down).encode(), "text/plain; charset=utf-8")

        def answer_from_server(self) -> None:
            path = self.path.split("?", 1)[0]
            browser = (
                self.headers.get("Sec-Fetch-Dest", "").strip().lower() == "document"
            )
            if self.command != "GET" or path != "/" or not browser:
                status, headers, body = self.from_server()
                kept = [(k, v) for k, v in headers if k.lower() not in HOP_HEADERS]
                return self.send(status, kept, reloading(kept, body))
            status, headers, body = self.from_server()
            if b'<nav class="guides"' not in body:
                # The server's own refusal, such as a 400 for an unknown view.
                kept = [(k, v) for k, v in headers if k.lower() not in HOP_HEADERS]
                return self.send(status, kept, body)
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            try:
                page = preview.render(body.decode(), readme="view" not in query)
            # Any error shows in the tab, which reloads once the template is fixed.
            except Exception as error:
                page = error_page(error)
            self.reply(status, page.encode(), "text/html; charset=utf-8")

        def do_GET(self) -> None:
            path = self.path.split("?", 1)[0]
            if path == "/__live/version":
                return self.reply(200, preview.version().encode(), "text/plain")
            if path == "/static/site.css":
                css = (preview.static / "site.css").read_bytes()
                return self.reply(200, css, "text/css; charset=utf-8")
            if path == "/static/copy.js":
                script = (preview.static / "copy.js").read_bytes()
                return self.reply(200, script, "text/javascript; charset=utf-8")
            if not self.document():
                self.answer()

        def document(self) -> bool:
            """Answers with the checkout's copy of a document agents read, as plain
            text, which a browser shows; says whether the path was one. /skill.md
            names the skills' versions in X-Filedrawer-Skills, as the server's
            does, which the skills' upgrade check reads from a HEAD."""
            path = self.path.split("?", 1)[0]
            if path not in ("/skill.md", "/install.sh") and not path.startswith(
                "/skills/"
            ):
                return False
            preview.drop_caches()
            headers = [
                ("Content-Type", "text/plain; charset=utf-8"),
                ("Cache-Control", "no-store"),
            ]
            try:
                text = preview.documents.get(path)
                if path == "/skill.md":
                    versions = preview.documents.versions()
                    listed = ", ".join(f"{name}/{n}" for name, n in versions)
                    headers.append(("X-Filedrawer-Skills", listed))
            except (OSError, ValueError) as error:
                self.send(500, headers, f"live-preview: {error}\n".encode())
                return True
            if text is None:
                return False
            self.send(200, headers, text.encode())
            return True

        def do_HEAD(self) -> None:
            if not self.document():
                self.answer()

        do_POST = do_PUT = do_DELETE = answer

        def log_message(self, format, *args) -> None:
            pass

    return Handler


def run(command: list[str], **kwargs) -> str:
    """`command`'s output, or an exit naming it and the last line it printed when it
    fails."""
    done = subprocess.run(
        command, capture_output=True, text=True, check=False, **kwargs
    )
    if done.returncode != 0:
        last = (done.stderr.strip().splitlines() or ["no output"])[-1]
        sys.exit(f"live-preview: {Path(command[0]).name} {command[1]} failed: {last}")
    return done.stdout.strip()


class DevServer:
    """The checkout's `filedrawer-server serve` in the dev environment, its database in
    target/live-preview/."""

    def __init__(self, root: Path, port: int, public_url: str) -> None:
        self.root = root
        self.binary = root / "target/debug/filedrawer-server"
        self.data = root / "target/live-preview"
        self.database = self.data / "filedrawer.db"
        self.port = port
        self.url = f"http://127.0.0.1:{port}"
        self.public_url = public_url
        # Written once seeding ends, so a database whose seeding was cut short is
        # made again rather than left half full.
        self.seeded = self.data / "seeded"
        self.process: subprocess.Popen | None = None
        # The token of each verification link the server logs, as it has no SMTP.
        self.verify_links: queue.Queue[str] = queue.Queue()

    def environment(self) -> dict[str, str]:
        """Only what the server needs: no SMTP, GitHub or staging setting this shell
        holds reaches it. Its email goes to its log, at info."""
        log = os.environ.get("RUST_LOG", "warn")
        return {
            "PATH": os.environ.get("PATH", ""),
            "HOME": os.environ.get("HOME", ""),
            "RUST_LOG": f"{log},filedrawer_server::mail=info",
            "NO_COLOR": "1",
            "FILEDRAWER_DATABASE": str(self.database),
            "FILEDRAWER_LISTEN": f"127.0.0.1:{self.port}",
            "FILEDRAWER_ENVIRONMENT": "dev",
            "FILEDRAWER_SCREENER": "scripted",
            "FILEDRAWER_LINK_CHECKS": "off",
            "FILEDRAWER_PUBLISHER_SECONDS": "2",
            "FILEDRAWER_PUBLIC_URL": self.public_url,
        }

    def build(self) -> bool:
        """Builds the server; says whether the build passed. LIVE_PREVIEW_BUILD, set
        by its tests, is a shell command to run instead."""
        print("live-preview: building the server", flush=True)
        instead = os.environ.get("LIVE_PREVIEW_BUILD")
        if instead:
            done = subprocess.run(instead, shell=True, cwd=self.root, check=False)
            return done.returncode == 0
        command = ["cargo", "build", "-q", "--bin", "filedrawer-server"]
        if shutil.which("heavy"):
            command = ["heavy", "--share", "--", *command]
        return subprocess.run(command, cwd=self.root, check=False).returncode == 0

    def is_seeded(self) -> bool:
        try:
            return self.seeded.read_text().strip() == SEED_VERSION
        except OSError:
            return False

    def start(self, cleanup: contextlib.ExitStack) -> str:
        """Start the server, seeding a new database first; `cleanup` stops it. Returns
        the admin's session cookie. A seeded database whose admin can't log in, as
        when its password was changed on /account or the account deleted, is seeded
        again."""
        if not self.binary.exists():
            raise DevServerFailed(
                f"live-preview: no server at {self.binary}; run without --no-build"
            )
        cleanup.callback(lambda: self.process and stop(self.process))
        cookie = self.start_once()
        if cookie is None:
            print(
                f"live-preview: {ADMIN[0]} can't log in; seeding a new database",
                flush=True,
            )
            stop(self.process)
            self.seeded.unlink(missing_ok=True)
            cookie = self.start_once()
        if cookie is None:
            raise DevServerFailed(
                f"live-preview: {ADMIN[0]} can't log in to a new database"
            )
        return cookie

    def start_once(self) -> str | None:
        """Start the server, seeding a new database first; the admin's session
        cookie, or None when it can't log in."""
        if not self.is_seeded():
            shutil.rmtree(self.data, ignore_errors=True)
        self.data.mkdir(parents=True, exist_ok=True)
        token = None
        if not self.database.exists():
            # Before the server starts, since both would run the migrations on a new file.
            account = self.admin("create-account", "--display-name", "Live Preview")
            token = self.admin("create-token", "--account", account, "--name", "seed")
        self.launch()
        if token:
            self.seed(token)
            cookie = self.seed_review_queue(token)
            self.seeded.write_text(SEED_VERSION + "\n")
            return cookie
        try:
            return self.log_in(ADMIN[0])
        except DevServerFailed:
            return None

    def launch(self) -> None:
        self.process = subprocess.Popen(
            [self.binary, "serve"],
            env=self.environment(),
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
        )
        threading.Thread(
            target=self.read_log, args=(self.process.stdout,), daemon=True
        ).start()
        self.wait_for(self.process)

    def restart(self) -> None:
        """Stops the server and starts it again, as rebuilt."""
        if self.process:
            stop(self.process)
        self.launch()

    def read_log(self, stream) -> None:
        """Passes the server's log on to stderr, noting each verification link."""
        for line in stream:
            found = re.search(r"/verify\?token=([\w-]+)", line)
            if found:
                self.verify_links.put(found.group(1))
            sys.stderr.write(line)

    def admin(self, *args: str) -> str:
        return run([str(self.binary), "admin", *args], env=self.environment())

    def wait_for(self, server: subprocess.Popen) -> None:
        for _ in range(120):
            try:
                with OPENER.open(self.url + "/tags"):
                    return
            except OSError:
                pass
            if server.poll() is not None:
                raise DevServerFailed(
                    f"live-preview: the dev server exited ({server.returncode})"
                )
            time.sleep(0.5)
        raise DevServerFailed(
            f"live-preview: the dev server didn't answer {self.url}/tags in a minute"
        )

    def post(self, path: str, token: str, name: str, body: bytes | None = None) -> str:
        """The server's answer to a POST for fixture `name`, or an exit when the server
        stops answering."""
        request = urllib.request.Request(
            self.url + path,
            data=body,
            method="POST",
            headers={"Authorization": f"Bearer {token}"},
        )
        try:
            with OPENER.open(request) as answer:
                return answer.read().decode()
        except urllib.error.HTTPError:
            raise
        except OSError as error:
            reason = getattr(error, "reason", error)
            raise DevServerFailed(
                f"live-preview: the dev server stopped answering at {name} ({reason})"
            )

    def seed_names(self) -> list[str]:
        return run(
            ["git", "-C", str(self.root), "ls-files", *SEED_ENTRIES]
        ).splitlines()

    def seed(self, token: str) -> None:
        """Submit each seed fixture with `token` and publish it at once."""
        published = 0
        for name in self.seed_names():
            try:
                text = self.post(
                    "/entries", token, name, (self.root / name).read_bytes()
                )
                entry = re.search(r"^id: (\S+)", text, re.MULTILINE)
                if entry is None:
                    print(f"live-preview: no id in the server's answer to {name}")
                    continue
                self.post(f"/e/{entry.group(1)}/publish", token, name)
            except urllib.error.HTTPError as error:
                why = error.read().decode().strip().splitlines()[:1] or [
                    str(error.code)
                ]
                print(f"live-preview: the server refused {name}: {why[0]}")
                continue
            published += 1
        print(f"live-preview: seeded {published} entries", flush=True)

    def call(
        self,
        step: str,
        path: str,
        expect: int,
        *,
        form: dict[str, str] | None = None,
        body: str | None = None,
        token: str | None = None,
        cookie: str | None = None,
        method: str = "POST",
    ) -> tuple[http.client.HTTPMessage, str]:
        """The headers and text of the server's answer to one step of seeding the
        review queue, sent as a form from the site when `form`; an exit naming the
        step when the answer's status isn't `expect`."""
        headers = {"Origin": self.public_url}
        data = None
        if form is not None:
            data = urllib.parse.urlencode(form).encode()
            headers["Content-Type"] = "application/x-www-form-urlencoded"
        elif body is not None:
            data = body.encode()
        if token:
            headers["Authorization"] = f"Bearer {token}"
        if cookie:
            headers["Cookie"] = cookie
        request = urllib.request.Request(
            self.url + path, data=data, method=method, headers=headers
        )
        try:
            with OPENER.open(request) as answer:
                status, got, text = answer.status, answer.headers, answer.read()
        except urllib.error.HTTPError as error:
            status, got, text = error.code, error.headers, error.read()
        except OSError as error:
            reason = getattr(error, "reason", error)
            raise DevServerFailed(
                f"live-preview: the dev server stopped answering at {step} ({reason})"
            )
        text = text.decode()
        if status != expect:
            first = (text.strip().splitlines() or [""])[0][:200]
            raise DevServerFailed(
                f"live-preview: seeding the review queue, {step} got {status}, not"
                f" {expect}: {first}"
            )
        return got, text

    def log_in(self, email: str) -> str:
        """The session cookie, `name=value`, of a login as `email`."""
        headers, _ = self.call(
            f"logging in as {email}",
            "/login",
            303,
            form={"email": email, "password": PASSWORD},
        )
        return headers.get("Set-Cookie", "").split(";", 1)[0]

    def sign_up(self, account: tuple[str, str], invite: str = "") -> str:
        """Signs up `account`, an email and a display name, follows the link the
        server logs, and logs in; returns the session cookie."""
        email, name = account
        form = {
            "email": email,
            "password": PASSWORD,
            "display_name": name,
            "invite": invite,
        }
        self.call(f"signing up {email}", "/signup", 200, form=form)
        try:
            link = self.verify_links.get(timeout=30)
        except queue.Empty:
            raise DevServerFailed(
                f"live-preview: the dev server logged no verification link for {email}"
            )
        self.call(f"verifying {email}", "/verify", 200, form={"token": link})
        return self.log_in(email)

    def new_token(self, cookie: str) -> str:
        """A token made on the account page of `cookie`'s session."""
        _, page = self.call(
            "making a token",
            "/account/tokens",
            200,
            form={"name": "preview"},
            cookie=cookie,
        )
        found = re.search(r"fdt_\w+", page)
        if found is None:
            raise DevServerFailed("live-preview: the account page showed no new token")
        return found.group(0)

    def seed_review_queue(self, token: str) -> str:
        """Fills each section of /admin, and returns the session cookie of its admin:
        entries in review, held and frozen, a series refusal, entries that passed
        with a hazard doubt or a screening note, and the account the hold guards,
        `token`'s, whose entries these are but the frozen one."""
        cookie = self.sign_up(ADMIN)
        _, page = self.call(
            "reading the account page", "/account", 200, cookie=cookie, method="GET"
        )
        account = re.search(r"<code>(a-[^<]+)</code>", page)
        if account is None:
            raise DevServerFailed("live-preview: the account page showed no account ID")
        self.admin("grant", "--account", account.group(1))
        self.new_token(cookie)

        names = self.seed_names()
        base = (self.root / names[0]).read_text() if names else ""
        ids = {}
        for kind, marker in (
            ("in review", REVIEW),
            ("held", REVIEW),
            ("passed with a hazard doubt", DOUBT),
            ("passed with a screening note", NOTE),
        ):
            _, reply = self.call(
                f"submitting the entry {kind}",
                "/entries",
                201,
                body=marked(base, kind, marker),
                token=token,
            )
            ids[kind] = id_in(reply)
            self.call(
                f"publishing the entry {kind}",
                f"/e/{ids[kind]}/publish",
                200,
                token=token,
            )
        series = f"---\ntitle: A series the screen refused\n---\n\nIt says {REVIEW}.\n"
        self.call(
            "submitting the refused series", "/series", 422, body=series, token=token
        )

        invite_form = {"label": "Live preview", "uses": "1", "days": "30"}
        self.call(
            "making an invite code",
            "/admin/invites",
            303,
            form=invite_form,
            cookie=cookie,
        )
        _, page = self.call(
            "reading the invite codes",
            "/admin/invites",
            200,
            cookie=cookie,
            method="GET",
        )
        code = re.search(r"inv-[\w-]+", page)
        if code is None:
            raise DevServerFailed("live-preview: /admin/invites showed no invite code")
        invited = self.new_token(self.sign_up(INVITED, code.group(0)))
        self.call(
            "submitting the entry to freeze",
            "/entries",
            201,
            body=marked(base, "frozen", ""),
            token=invited,
        )
        self.call(
            "revoking the invite code",
            f"/admin/invites/{code.group(0)}/revoke",
            303,
            cookie=cookie,
        )
        self.call(
            "holding an entry", f"/admin/e/{ids['held']}/hold", 303, cookie=cookie
        )
        print("live-preview: seeded the review queue", flush=True)
        return cookie


def marked(base: str, kind: str, marker: str) -> str:
    """`base`, an entry, retitled for `kind`, with `marker` for the scripted screen."""
    title = f"title: A seeded entry {kind}"
    text = re.sub(r"^title: .*$", title, base, count=1, flags=re.MULTILINE)
    return f"{text.rstrip()}\n\n{marker}\n" if marker else text


def id_in(reply: str) -> str:
    found = re.search(r"^id: (\S+)", reply, re.MULTILINE)
    if found is None:
        raise DevServerFailed("live-preview: no id in the server's answer")
    return found.group(1)


class Rebuilder:
    """Rebuilds and restarts the dev server when a template other than home.html, or
    a legal file, changes, since the server compiles them in. A failed build leaves
    the server as it was, and the next change tries again."""

    def __init__(self, server: DevServer, preview: Preview) -> None:
        self.server = server
        self.preview = preview
        self.folders = [
            server.root / "crates/server/templates",
            server.root / "crates/server/legal",
        ]
        self.built = self.stamps()

    def stamps(self) -> dict[str, str]:
        found = {}
        for folder in self.folders:
            for path in sorted(folder.glob("*")):
                if path.name != "home.html" and path.suffix in (".html", ".md"):
                    with contextlib.suppress(OSError):
                        found[path.name] = Preview.stamp(path)
        return found

    def run(self) -> None:
        while True:
            time.sleep(1)
            now = self.stamps()
            if now == self.built:
                continue
            # A save, a checkout or a rebase can change several files in a row.
            while (later := self.stamps()) != now:
                now = later
                time.sleep(1)
            changed = sorted(set(now.items()) ^ set(self.built.items()))
            names = ", ".join(sorted({name for name, _ in changed}))
            print(f"live-preview: {names} changed; rebuilding", flush=True)
            if not self.server.build():
                print(
                    "live-preview: the build failed; the dev server runs as last"
                    " built, and the next change builds again",
                    flush=True,
                )
                self.built = now
                continue
            self.built = now
            self.preview.ready.clear()
            try:
                self.server.restart()
            except DevServerFailed as failed:
                print(
                    f"{failed}; the next change builds and starts it again", flush=True
                )
                continue
            finally:
                self.preview.ready.set()
            self.preview.generation += 1
            print("live-preview: restarted the rebuilt dev server", flush=True)


def stop(server: subprocess.Popen) -> None:
    server.terminate()
    server.wait()


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--root",
        type=Path,
        default=REPO,
        help="the checkout to preview (default: this one)",
    )
    parser.add_argument(
        "--port", type=int, default=8090, help="the preview's port, on every interface"
    )
    parser.add_argument(
        "--server-port",
        type=int,
        default=8091,
        help="the dev server's port, on 127.0.0.1",
    )
    parser.add_argument(
        "--upstream", help="a dev server already running, such as http://127.0.0.1:8091"
    )
    parser.add_argument(
        "--no-build", action="store_true", help="start the dev server as last built"
    )
    parser.add_argument(
        "--print",
        metavar="PATH",
        help="print /skill.md, /install.sh or /skills/NAME/FILE as the preview"
        " would serve it, and exit",
    )
    parser.add_argument(
        "--static",
        metavar="OUT",
        type=Path,
        help="write the home page, without its drawer, to OUT as one file to open"
        " from disk, and exit",
    )
    parser.add_argument(
        "--public-url",
        help="with --print or --static, the site the text names (default: the"
        f" preview's with --print, {PRODUCTION} with --static)",
    )
    args = parser.parse_args()
    if args.public_url and not (args.print or args.static):
        sys.exit("live-preview: --public-url goes with --print or --static")
    if args.static and args.print:
        sys.exit("live-preview: --static doesn't go with --print: run it once for each")
    if args.static:
        preview = Preview(args.root.resolve(), "", args.public_url or PRODUCTION)
        try:
            args.static.write_text(preview.static_page())
        except (OSError, ValueError, jinja2.TemplateError) as error:
            sys.exit(f"live-preview: {error}")
        return 0
    if args.print:
        site = args.public_url or f"http://localhost:{args.port}"
        try:
            text = Documents(args.root.resolve(), site).get(args.print)
        except (OSError, ValueError) as error:
            sys.exit(f"live-preview: {error}")
        if text is None:
            sys.exit(
                f"live-preview: {args.print} isn't /skill.md, /install.sh or a file"
                " of a skill"
            )
        sys.stdout.write(text)
        return 0
    if "HEAVY_SLOT" in os.environ:
        sys.exit(
            "live-preview: run it without heavy: it runs until stopped, so inside a"
            " heavy job it holds the lane every commit check waits for, and it queues"
            " its own build"
        )
    root = args.root.resolve()

    # Bound first, before the build: the dev server's public URL names this port,
    # which --port 0 leaves to the system. Its handler comes once there's an upstream.
    try:
        listener = http.server.ThreadingHTTPServer(
            ("0.0.0.0", args.port), http.server.BaseHTTPRequestHandler
        )
    except OSError as error:
        sys.exit(
            f"live-preview: port {args.port} is taken ({error.strerror}); pass --port"
        )
    public_url = f"http://localhost:{listener.server_port}"
    serving = threading.Event()

    def on_sigterm(*_) -> None:
        # An exception from a signal handler is raised wherever the main thread is, and
        # one raised inside a weakref callback or a finalizer is printed and dropped, so
        # the preview ran on and its test waited out pytest-timeout. Once serving, ask
        # the loop to stop instead; shutdown() waits for it, so not from this thread.
        if serving.is_set():
            threading.Thread(target=listener.shutdown, daemon=True).start()
        else:
            sys.exit(0)

    signal.signal(signal.SIGTERM, on_sigterm)
    with contextlib.ExitStack() as cleanup:
        try:
            upstream = args.upstream
            server, cookie = None, None
            if upstream is None:
                server = DevServer(root, args.server_port, public_url)
                if not args.no_build and not server.build():
                    sys.exit(
                        "live-preview: the build failed; fix it, or run with --no-build"
                    )
                cookie = server.start(cleanup)
                upstream = server.url
            preview = Preview(root, upstream, public_url)
            preview.cookie = cookie
            if server:
                rebuilder = Rebuilder(server, preview)
                threading.Thread(target=rebuilder.run, daemon=True).start()
            listener.RequestHandlerClass = handler_for(preview)
            print(
                f"live-preview: http://127.0.0.1:{listener.server_port}/ previews {root}; "
                f"from the host, {public_url}",
            )
            for path in [*preview.documents.links(), *SERVER_PAGES]:
                print(f"live-preview: {public_url}{path}")
            sys.stdout.flush()
            serving.set()
            listener.serve_forever()
        except KeyboardInterrupt:
            pass
        except DevServerFailed as failed:
            sys.exit(str(failed))
    return 0


if __name__ == "__main__":
    sys.exit(main())
