#!/usr/bin/env python3
"""Which of bin/agent-pre-commit's checks a change needs.

    git diff --cached -z --name-only --no-renames BASE | bin/checks-needed [TREE]
    bin/checks-needed --why PATH [TREE]

TREE (default .) holds the files as staged; agent-pre-commit passes its copy of the
index. The paths that differ from BASE come NUL-separated on stdin: agent-pre-commit
diffs against $CHECK_BASE, the nearest commit that passed the checks; by hand, HEAD
gives what's staged. It prints a line for each check the change needs, the check's
name and the first path that needs it:

    rust       cargo nextest, cargo test --doc and clippy
    bin-tests  pytest over bin/tests
    skills     bin/skills sync --check, which needs no build
    routes     at a commit, the test that every route is named for agents or
               listed in NOT_FOR_AGENTS (the full check's nextest holds it)
    py-rules   at a commit, bin/tests/test_no_wall_clock_limits.py, which needs no
               build (the full check's bin-tests holds it)
    test-mods  at a commit, bin/test-modules, which needs no build (the full
               check's nextest holds the Rust test it stands in for)

No paths needs every check: with nothing changed, nothing narrows them.

--why PATH says why a change to PATH, relative to TREE's root, needs each check it
needs: the check's name, then the chain of references that made PATH one of its
inputs, a step a line, ending at PATH. The first step is one of the rules below; each
after it is a reference in a file under the step before, as FILE:LINE, the reference
as written, and the path it reaches, `.` for the repo root. Were a bin test to join a
name onto the repo, as `REPO / script` (here in a made-up bin/tests/test_example.py),
every path would be an input:

    bin-tests
      bin: bin/tests covers it
      bin/tests/test_example.py:12: REPO / script -> .
      docs/design.md

When several chains reach PATH, it prints a shortest, and of a file's references to
one path, the first; when no chain does, `no check needs PATH`. It reads no stdin.

A path needs rust when it is a build input, or lies in a folder that is one:
- crates/, .sqlx/, .cargo/, .config/, .gitattributes, any Cargo.toml, Cargo.lock or
  build.rs, the root's toolchain, clippy and rustfmt files, and every folder that
  holds a Cargo.toml (a crate outside crates/);
- each path a crate's .rs, .toml or .html files name with a `..` step, taken from the
  file's folder, its crate's and its crate's templates/: include_str!, include_bytes!,
  sqlx::migrate!, askama's dirs, and CARGO_MANIFEST_DIR joins in tests, which read
  ops/ files at run time. A path that reaches the repo root makes every path an input;
- what the scripts among those inputs reach, in turn: a shell script's
  `$(dirname "$0")/PATH`, also through a name assigned one (`repo="$(dirname "$0")/.."`
  then `$repo/PATH`), and a Python script's joins onto `Path(__file__)` and its
  .parent and .parents[k], through names too. A shell path to the script's own folder
  or one above it doesn't count, since scripts cd there.

A path needs bin-tests when it lies in bin/ or ops/, is .gitattributes, lies in a
crate (bin/tests/test_checks_needed.py reads their references), or is what the scripts
there reach, as above. That takes in the bin tests' own `REPO / "..."` joins. Mentions
in prose don't count.

A path needs skills when it lies in skills/, or is docs/entry-format.md or bin/skills.

A path needs routes when it is crates/server/src/lib.rs (the router),
crates/server/install.md, crates/server/tests/it/skill.rs, or lies in skills/.

A path needs py-rules when it lies in bin/tests/.

A path needs test-mods when it lies in a crate's tests/it/, or is bin/test-modules.

The rules miss a path a crate builds without a `..` step, and a Python path not
derived from __file__. CI runs every check, so it catches what they miss.
"""

import argparse
import ast
import os
import re
import sys
from collections import deque
from dataclasses import dataclass
from pathlib import Path, PurePosixPath

# A reference to the repo root, under which every path lies.
ROOT = ""
RUST_PATHS = (
    "crates",
    ".sqlx",
    ".cargo",
    ".config",
    ".gitattributes",
    "rust-toolchain",
    "rust-toolchain.toml",
    "clippy.toml",
    ".clippy.toml",
    "rustfmt.toml",
    ".rustfmt.toml",
)
RUST_NAMES = frozenset({"Cargo.toml", "Cargo.lock", "build.rs"})
RUST_NAMES_RULE = "any Cargo.toml, Cargo.lock or build.rs: a build input"
BIN_TESTS_PATHS = ("bin", "ops", ".gitattributes")
# What the skills' record follows: their folders, the format each copies, and the
# script that keeps it.
SKILLS_PATHS = ("skills", "docs/entry-format.md", "bin/skills")
# What crates/server/tests/it/skill.rs's route test compares: the router, the
# documents that name routes, and its own list of routes not for agents.
ROUTES_PATHS = (
    "crates/server/src/lib.rs",
    "crates/server/install.md",
    "crates/server/tests/it/skill.rs",
    "skills",
)
# What bin/tests/test_no_wall_clock_limits.py reads: bin/tests' own sources.
PY_RULES_PATHS = ("bin/tests",)
# What bin/test-modules reads, besides each crate's tests/it.
TEST_MODS_PATHS = ("bin/test-modules",)
CRATE_SOURCES = (".rs", ".toml", ".html")
# Not walked: git's own folder, and cargo's output in a working tree.
SKIP_DIRS = {".git", "target"}
SHELLS = {"sh", "bash", "dash", "zsh", "ksh"}
PATH_TOKEN = re.compile(r"[\w./-]+")
# How a shell script names its own folder.
SELF = r'\$\(dirname "\$0"\)|\$\(dirname "\$\{BASH_SOURCE\[0\]\}"\)|\$\{0%/\*\}'
SELF_PATH = re.compile(rf"(?:{SELF})(/[\w./-]*)?")
ASSIGNMENT = re.compile(r"^\s*(?:local\s+|export\s+|readonly\s+)?(\w+)=(.*)$", re.M)
NAME_PATH = re.compile(r'\$\{?(\w+)\}?"?(/[\w./-]*)')


def resolve(folder: str, path: str) -> str | None:
    """`path` taken from `folder`, both relative to the repo root, with `.` and `..`
    steps applied; a leading / counts as none. None when it leaves the repo."""
    parts = [part for part in folder.split("/") if part]
    for step in path.split("/"):
        if step in ("", "."):
            continue
        if step == "..":
            if not parts:
                return None
            parts.pop()
        else:
            parts.append(step)
    return "/".join(parts)


def parent(path: str) -> str | None:
    """The folder that holds `path`; None for the root."""
    if path == ROOT:
        return None
    folder = str(PurePosixPath(path).parent)
    return ROOT if folder == "." else folder


def within(path: str, ref: str) -> bool:
    return ref == ROOT or path == ref or path.startswith(ref + "/")


def cite(path: str, line: int, text: str, ref: str) -> str:
    """A reference as --why shows it: where it is, what it says and what it reaches."""
    return f"{path}:{line}: {text} -> {ref or '.'}"


def line_at(text: str, offset: int) -> int:
    """The line, counted from 1, that `offset` in `text` lies on."""
    return text.count("\n", 0, offset) + 1


@dataclass(frozen=True)
class Step:
    """How a path became a check's input: the line --why shows for it, and `via`, the
    input under which the file that names it lies; None for a path the check starts
    from by rule."""

    text: str
    via: str | None = None


class Tree:
    """The staged files under `root`, as paths relative to it."""

    def __init__(self, root: Path):
        self.root = root
        # What each script reaches, read once for both checks.
        self.refs: dict[str, dict[str, str]] = {}
        self.paths = []
        for folder, dirs, files in os.walk(root):
            dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS)
            rel = Path(folder).relative_to(root).as_posix()
            self.paths += [
                name if rel == "." else f"{rel}/{name}" for name in sorted(files)
            ]

    def under(self, ref: str) -> list[str]:
        return [path for path in self.paths if within(path, ref)]

    def text(self, path: str) -> str:
        return (self.root / path).read_text(errors="replace")

    def language(self, path: str) -> str | None:
        """A script's language, "python" or "shell"; None for any other file. Only a
        file with no suffix is read for its #! line, which keeps the walk from opening
        every source and data file."""
        suffix = PurePosixPath(path).suffix
        if suffix == ".py":
            return "python"
        if suffix in (".sh", ".bash"):
            return "shell"
        if suffix:
            return None
        with (self.root / path).open("rb") as file:
            first = file.readline(200).decode(errors="replace")
        if not first.startswith("#!"):
            return None
        words = first[2:].split()
        if any("python" in word for word in words) or {"uv", "run"} <= set(words):
            return "python"
        names = [os.path.basename(word) for word in words if not word.startswith("-")]
        if names[:1] == ["env"]:
            names = names[1:]
        return "shell" if names[:1] and names[0] in SHELLS else None

    def script_refs(self, path: str) -> dict[str, str]:
        """The paths the script at `path` reaches, each with the first reference that
        does, as cite() gives it; none for a file that isn't a script."""
        if path not in self.refs:
            language = self.language(path)
            self.refs[path] = {}
            if language == "shell":
                self.refs[path] = shell_refs(self.text(path), path)
            elif language == "python":
                self.refs[path] = PythonPaths(self.text(path), path).found
        return self.refs[path]


def shell_refs(text: str, path: str) -> dict[str, str]:
    """The paths a shell script reaches through its own folder, directly or through a
    name assigned it, each with its first reference; its own folder and those above it
    don't count."""
    folder = parent(path)
    bound = {}
    for name, value in ASSIGNMENT.findall(text):
        if own := SELF_PATH.search(value):
            bound[name] = resolve(folder, own.group(1) or "")
    found = [
        (resolve(folder, match.group(1)), match)
        for match in SELF_PATH.finditer(text)
        if match.group(1)
    ]
    found += [
        (resolve(bound[match.group(1)], match.group(2)), match)
        for match in NAME_PATH.finditer(text)
        if bound.get(match.group(1)) is not None
    ]
    refs = {}
    for ref, match in sorted(found, key=lambda pair: pair[1].start()):
        if ref is not None and not within(folder, ref) and ref not in refs:
            refs[ref] = cite(path, line_at(text, match.start()), match.group(0), ref)
    return refs


class PythonPaths:
    """The repo paths a Python script's expressions derived from __file__ reach, read
    with ast so that docstrings and other literals don't count."""

    def __init__(self, source: str, path: str):
        self.source = source
        self.path = path
        self.names: dict[str, str] = {}
        # Each path reached, with the first join that reaches it in the file.
        self.joins: dict[str, ast.expr] = {}
        # The same, as cite() gives each.
        self.found: dict[str, str] = {}
        if "__file__" not in source:
            return
        try:
            nodes = list(ast.walk(ast.parse(source)))
        except SyntaxError:
            return
        assignments = [node for node in nodes if isinstance(node, ast.Assign)]
        # Names bound to paths, until no more are found: one may be built from another.
        # Names built from each other in a loop never settle, so the passes stop at one
        # more than there are assignments, enough for any chain without one.
        for _ in range(len(assignments) + 1):
            before = dict(self.names)
            for node in assignments:
                value = self.value(node.value)
                for target in node.targets:
                    if isinstance(target, ast.Name) and value is not None:
                        self.names[target.id] = value
            if self.names == before:
                break
        for node in nodes:
            if isinstance(node, ast.BinOp | ast.Call):
                self.value(node)
        for ref, join in self.joins.items():
            text = " ".join((ast.get_source_segment(source, join) or "").split())
            self.found[ref] = cite(path, join.lineno, text, ref)

    def join(
        self, base: str | None, parts: list[ast.expr], node: ast.expr
    ) -> str | None:
        """base joined with the parts, noting what `node`, the join, reaches. A part
        that isn't a string constant reaches the folder before it, where the script
        reads a name it builds."""
        for part in parts:
            if base is None:
                return None
            if not (isinstance(part, ast.Constant) and isinstance(part.value, str)):
                self.note(base, node)
                return None
            base = resolve(base, part.value)
        if base is not None:
            self.note(base, node)
        return base

    def note(self, ref: str, node: ast.expr) -> None:
        first = self.joins.get(ref)
        if first is None or (node.lineno, node.col_offset) < (
            first.lineno,
            first.col_offset,
        ):
            self.joins[ref] = node

    def value(self, node: ast.AST) -> str | None:
        """The repo path `node` evaluates to, or None."""
        match node:
            case ast.Name(id="__file__"):
                return self.path
            case ast.Name(id=name):
                return self.names.get(name)
            case ast.Call(
                func=ast.Name(id="Path") | ast.Attribute(attr="Path"), args=[arg]
            ):
                return self.value(arg)
            case ast.Call(func=ast.Attribute(value=inner, attr="resolve" | "absolute")):
                return self.value(inner)
            case ast.Attribute(value=inner, attr="parent"):
                found = self.value(inner)
                return None if found is None else parent(found)
            case ast.Subscript(
                value=ast.Attribute(value=inner, attr="parents"),
                slice=ast.Constant(value=int(k)),
            ):
                found = self.value(inner)
                for _ in range(k + 1):
                    found = None if found is None else parent(found)
                return found
            case ast.BinOp(left=left, op=ast.Div(), right=right):
                return self.join(self.value(left), [right], node)
            case ast.Call(func=ast.Attribute(value=inner, attr="joinpath"), args=parts):
                return self.join(self.value(inner), parts, node)
            case ast.Call(
                func=ast.Attribute(value=inner, attr="with_name"), args=parts
            ):
                found = self.value(inner)
                return self.join(None if found is None else parent(found), parts, node)
        return None


class Inputs:
    """A check's inputs: the paths it starts from, and, unless `follow` is false,
    every path the scripts among them reach, in turn, each with the Step that made it
    one."""

    def __init__(
        self,
        tree: Tree,
        starts: dict[str, Step],
        by_name: dict[str, str] | None = None,
        follow: bool = True,
    ):
        # The file names that are inputs wherever they lie, each with its rule's line.
        self.by_name = by_name or {}
        self.steps = dict(starts)
        # Breadth first, so each path's first Step lies on a shortest chain.
        todo = deque(self.steps if follow else ())
        read = set()
        while todo:
            ref = todo.popleft()
            if ref == ROOT:
                continue
            for path in tree.under(ref):
                if path in read:
                    continue
                read.add(path)
                for found, text in tree.script_refs(path).items():
                    if found not in self.steps:
                        self.steps[found] = Step(text, via=ref)
                        todo.append(found)

    def needs(self, path: str) -> bool:
        """Whether `path` is an input."""
        return PurePosixPath(path).name in self.by_name or any(
            within(path, ref) for ref in self.steps
        )

    def chain(self, ref: str) -> list[str]:
        """The lines of the steps from a path the check starts from to `ref`."""
        lines = []
        while ref is not None:
            step = self.steps[ref]
            lines.append(step.text)
            ref = step.via
        return lines[::-1]

    def why(self, path: str) -> list[str] | None:
        """A shortest chain that makes `path` an input, ending at it; None when no
        chain does."""
        if rule := self.by_name.get(PurePosixPath(path).name):
            return [rule, path]
        holders = [ref for ref in self.steps if within(path, ref)]
        if not holders:
            return None
        return [*min((self.chain(ref) for ref in holders), key=len), path]


def crate_refs(tree: Tree, crates: list[str]) -> dict[str, Step]:
    """The paths the crates' sources name with a `..` step, each with the Step of the
    first source that does."""
    refs = {}
    for path in tree.paths:
        crate = max((c for c in crates if within(path, c)), key=len, default=None)
        if crate is None or not path.endswith(CRATE_SOURCES):
            continue
        text = tree.text(path)
        if "../" not in text and "/.." not in text:
            continue
        folders = (parent(path), crate, f"{crate}/templates")
        for match in PATH_TOKEN.finditer(text):
            token = match.group(0)
            # A lone `..` is Rust's range and rest syntax, not a path.
            if token == ".." or ".." not in token.split("/"):
                continue
            line = line_at(text, match.start())
            for folder in folders:
                ref = resolve(folder, token)
                if ref is not None and ref not in refs:
                    refs[ref] = Step(cite(path, line, token, ref), via=crate)
    return refs


def crate_folders(tree: Tree) -> list[str]:
    """Every folder below the root that holds a Cargo.toml."""
    return sorted(
        {
            parent(path)
            for path in tree.paths
            if PurePosixPath(path).name == "Cargo.toml"
        }
        - {ROOT}
    )


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog="checks-needed",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("tree", nargs="?", default=".", metavar="TREE")
    parser.add_argument("--why", metavar="PATH")
    args = parser.parse_args(argv)
    why = None if args.why is None else resolve(ROOT, args.why)
    if args.why is not None and (args.why.startswith("/") or not why):
        print(
            f"checks-needed: --why {args.why} is no path inside TREE; name one from"
            " TREE's root",
            file=sys.stderr,
        )
        return 2
    root = Path(args.tree)
    if not root.is_dir():
        print(
            f"checks-needed: {root} isn't a folder; pass the staged tree",
            file=sys.stderr,
        )
        return 2
    sys.stdout.reconfigure(errors="backslashreplace")
    tree = Tree(root)
    crates = crate_folders(tree)
    crate_steps = {
        crate: Step(f"{crate}: a crate (it holds a Cargo.toml)") for crate in crates
    }
    rust = {ref: Step(f"{ref}: a build input") for ref in RUST_PATHS}
    # A crate's own rule comes before any reference to it, which mustn't replace it.
    for layer in (crate_steps, crate_refs(tree, crates)):
        for ref, step in layer.items():
            rust.setdefault(ref, step)
    bin_tests = {ref: Step(f"{ref}: bin/tests covers it") for ref in BIN_TESTS_PATHS}
    for ref, step in crate_steps.items():
        bin_tests.setdefault(ref, step)
    checks = {
        "rust": Inputs(tree, rust, by_name=dict.fromkeys(RUST_NAMES, RUST_NAMES_RULE)),
        "bin-tests": Inputs(tree, bin_tests),
        "skills": Inputs(
            tree,
            {
                ref: Step(f"{ref}: the skills' record follows it")
                for ref in SKILLS_PATHS
            },
        ),
        "routes": Inputs(
            tree,
            {ref: Step(f"{ref}: the routes test compares it") for ref in ROUTES_PATHS},
        ),
        "py-rules": Inputs(
            tree,
            {
                ref: Step(f"{ref}: the wall-clock rule reads it")
                for ref in PY_RULES_PATHS
            },
            # The rule reads bin/tests' own sources, not what they reach.
            follow=False,
        ),
        "test-mods": Inputs(
            tree,
            {
                **{
                    f"{crate}/tests/it": Step(
                        f"{crate}/tests/it: bin/test-modules reads it"
                    )
                    for crate in crates
                },
                **{
                    ref: Step(f"{ref}: the module check itself")
                    for ref in TEST_MODS_PATHS
                },
            },
            follow=False,
        ),
    }
    if why is not None:
        chains = {name: inputs.why(why) for name, inputs in checks.items()}
        if not any(chains.values()):
            print(f"no check needs {why}")
        for name, chain in chains.items():
            if chain:
                print(name, *(f"  {line}" for line in chain), sep="\n")
        return 0
    changed = [
        path
        for path in sys.stdin.buffer.read().decode(errors="surrogateescape").split("\0")
        if path
    ]
    for name, inputs in checks.items():
        if not changed:
            print(f"{name} (nothing differs from the base)")
        elif first := next((path for path in changed if inputs.needs(path)), None):
            print(f"{name} {first}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
