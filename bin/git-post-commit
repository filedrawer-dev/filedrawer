#!/bin/sh
# Git's post-commit hook (.githooks/post-commit links here; install.py points git at
# .githooks). After an agent's commit, llm-toolbox's agent-commit-gate warns when a
# fixup!, amend! or squash! commit touches files its target commit didn't, which a
# fold would then move into a commit that never had them. It never fails the commit,
# and does nothing for a person's commit or on a host without agent-commit-gate.
if [ -n "${AI_AGENT:-}" ] && command -v agent-commit-gate >/dev/null; then agent-commit-gate --post-commit; fi
