#!/usr/bin/env python3
"""Print the commit a daily run of .github/workflows/mutants.yml tests the changes since.

    bin/mutants-base REPO

REPO is the GitHub repo, as owner/name; run it in a checkout with the full history,
with GH_TOKEN allowed to read the repo's actions.

The base is the head of the newest run of the workflow on main, scheduled or started
by hand, that has the artifact `mutants-covered`: the summary job uploads it only when
every mutant of the run was tested, and the setup job when a daily run found no
mutants in its lines. A full run counts as well as a daily one, since it tested every
mutant at its head. A run whose head this checkout's HEAD
doesn't hold, as after a force push, is passed over. The artifacts last 30 days, so
only the runs of the last 31 are asked for. With no such run, the base is the commit
that added the workflow, and the run tests every mutant in the lines changed since.

Prints the base's full SHA on stdout and, on stderr, where it came from.

llm-toolbox's bin/mutants-base answers the same question for its mutate-check workflow,
with its own rules (a cut-off run counts, the artifacts last 90 days); a change to how
a run's base is found here may belong there too.

Exit status: 0 the base was printed; 1 a gh or git call failed or ran past 60 s,
as on an API error (it says which, and prints no base); 2 a usage error.
"""

import argparse
import json
import subprocess
import sys
from datetime import UTC, datetime, timedelta

WORKFLOW = ".github/workflows/mutants.yml"
COVERED = "mutants-covered"
# The mutants artifact's retention-days, and a day's slack.
LOOKBACK = timedelta(days=31)
CALL_TIMEOUT = 60


class CallFailed(Exception):
    pass


def call(argv: list[str]) -> bytes:
    try:
        done = subprocess.run(
            argv, capture_output=True, timeout=CALL_TIMEOUT, check=False
        )
    except subprocess.TimeoutExpired:
        raise CallFailed(f"{' '.join(argv)} ran past {CALL_TIMEOUT} s") from None
    if done.returncode != 0:
        stderr = done.stderr.decode(errors="replace").strip()
        raise CallFailed(f"{' '.join(argv)} failed: {stderr}")
    return done.stdout


def json_lines(argv: list[str]) -> list[dict]:
    """The objects a `gh api --jq` call prints, one a line."""
    return [json.loads(line) for line in call(argv).decode().splitlines() if line]


def candidate_runs(repo: str) -> list[dict]:
    """The workflow's successful scheduled and dispatched runs on main, newest first."""
    since = (datetime.now(UTC) - LOOKBACK).strftime("%Y-%m-%d")
    runs = json_lines(
        [
            "gh", "api", "-X", "GET", "--paginate",
            f"repos/{repo}/actions/workflows/mutants.yml/runs",
            "-f", "branch=main", "-f", "status=success",
            "-f", f"created=>={since}", "-f", "per_page=100",
            "--jq", ".workflow_runs[]",
        ]
    )  # fmt: skip
    return [
        run
        for run in runs
        if run["head_branch"] == "main"
        and run["conclusion"] == "success"
        and run["event"] in ("schedule", "workflow_dispatch")
    ]


def holds(commit: str) -> bool:
    """Whether HEAD holds `commit`; false too for a commit this clone lacks."""
    done = subprocess.run(
        ["git", "merge-base", "--is-ancestor", commit, "HEAD"],
        capture_output=True,
        timeout=CALL_TIMEOUT,
        check=False,
    )
    return done.returncode == 0


def covered(repo: str, run_id: int) -> bool:
    """Whether the run has a `mutants-covered` artifact GitHub still keeps."""
    artifacts = json_lines(
        [
            "gh", "api",
            f"repos/{repo}/actions/runs/{run_id}/artifacts?name={COVERED}",
            "--jq", ".artifacts[]",
        ]
    )  # fmt: skip
    return any(a["name"] == COVERED and not a["expired"] for a in artifacts)


def workflow_added() -> str:
    out = call(["git", "log", "--diff-filter=A", "--format=%H", "--", WORKFLOW])
    shas = out.decode().split()
    if not shas:
        raise CallFailed(f"git log finds no commit that added {WORKFLOW}")
    return shas[-1]


def base(repo: str) -> tuple[str, str]:
    """The base and where it came from."""
    for run in candidate_runs(repo):
        if holds(run["head_sha"]) and covered(repo, run["id"]):
            return run["head_sha"], (
                f"the head of {run['html_url']}, the newest run that tested every "
                "mutant in its range"
            )
    return workflow_added(), (
        "the commit that added the workflow: no run of the last 31 days on main "
        "tested every mutant in its range"
    )


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("repo", help="the GitHub repo, as owner/name")
    args = parser.parse_args()
    try:
        sha, why = base(args.repo)
    except CallFailed as error:
        print(f"mutants-base: {error}", file=sys.stderr)
        return 1
    print(f"mutants-base: the base is {why}.", file=sys.stderr)
    print(sha)
    return 0


if __name__ == "__main__":
    sys.exit(main())
